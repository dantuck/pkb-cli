#!/usr/bin/env python3
"""kb — thin CLI wrapper dispatching to sibling scripts in this tool repo. No daemon;
one-shot per invocation. Operates on a data repo (found by walking up from cwd to a
.pkb/ directory), which lives separately from wherever this tool is installed."""
import argparse
import calendar
import difflib
import importlib
import io
import json
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
from datetime import datetime, timedelta

SCRIPT_DIR = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
TOOL_ROOT = os.path.dirname(SCRIPT_DIR)  # the pkb-cli checkout itself, not the data repo
sys.path.insert(0, SCRIPT_DIR)
import pkb_common as pc

# Where kb itself comes from and how it self-updates when TOOL_ROOT isn't a git
# checkout (the common case: install.sh downloads a tarball snapshot, no git
# required). A git checkout (e.g. a contributor's manual `git clone`) instead
# uses `_git`/`update_status` below, which take priority when TOOL_ROOT/.git exists.
TOOL_REPO_SLUG = os.environ.get("PKB_CLI_REPO", "dantuck/pkb-cli")
TOOL_BRANCH = os.environ.get("PKB_CLI_BRANCH", "main")
VERSION_FILE = os.path.join(TOOL_ROOT, ".pkb-cli-version")


class KBArgumentParser(argparse.ArgumentParser):
    """argparse.ArgumentParser that gives an unknown top-level command a short,
    readable error (with a 'did you mean' suggestion) instead of the default
    'invalid choice: ... (choose from ...)' wall of text listing every command
    on one line."""

    _INVALID_COMMAND_RE = re.compile(r"^argument <command>: invalid choice: '(.+?)'")

    def __init__(self, *args, subcommands=None, **kwargs):
        self._subcommands = subcommands or []
        super().__init__(*args, **kwargs)

    def error(self, message):
        m = self._INVALID_COMMAND_RE.match(message)
        if not m:
            super().error(message)
        bad = m.group(1)
        self.print_usage(sys.stderr)
        suggestion = difflib.get_close_matches(bad, self._subcommands, n=1)
        print(f"kb: unknown command '{bad}'" +
              (f" -- did you mean '{suggestion[0]}'?" if suggestion else ""),
              file=sys.stderr)
        print("run `kb help` to see all commands", file=sys.stderr)
        sys.exit(2)


def _run_captured(cmd, **kw):
    """Run `cmd` with stderr merged into stdout, print the combined output, and
    return the returncode -- rather than inheriting stdio directly, so kb web
    can capture the real output via redirect_stdout (see kb_web.py's
    _capture_stdout) instead of it only reaching the terminal kb web happens to
    be running in, which, launched from a launchd plist, has no terminal
    anyone can see. errors="replace" keeps this from crashing on any non-UTF-8
    bytes a child process writes (e.g. binary noise in a library error
    message) -- inherited stdio would have passed those bytes through as-is,
    so decoding must not raise here either."""
    result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             text=True, errors="replace", **kw)
    print(result.stdout, end="")
    return result.returncode


def run_script(name, args=None):
    cmd = [sys.executable, os.path.join(SCRIPT_DIR, name)] + (args or [])
    return _run_captured(cmd)


def discover_sync_sources():
    """Auto-discover sync_<name>.py scripts in SCRIPT_DIR as pluggable sync sources.

    Adding a new one -- with an optional module-level SOURCE_META dict (see
    docs/reference/ingestion.md for the contract) -- registers it as `kb sync
    <name>` and, wherever SOURCE_META declares cli_tool/env_keys, in doctor/
    setup's health checks and the sops-injection decision, without any other
    file needing an edit. A script with no SOURCE_META (or an empty one) still
    works via `kb sync <name>`, just opts out of those automated checks.

    Returns {name: (filename, meta)}, sorted by name so `kb sync all`, the
    argparse choices list, and --help output all have a stable order.

    This runs on every `kb` invocation (argparse needs the choices list up
    front), so an import error in one sync_<name>.py must not take down every
    `kb` command -- it's skipped with a warning instead, same as a broken
    plugin in any discover-and-load system."""
    sources = {}
    for fname in sorted(os.listdir(SCRIPT_DIR)):
        if fname.startswith("sync_") and fname.endswith(".py"):
            name = fname[len("sync_"):-len(".py")]
            try:
                module = importlib.import_module(f"sync_{name}")
            except Exception as e:
                print(f"warning: {fname} failed to load, skipping (kb sync {name} unavailable): {e}",
                      file=sys.stderr)
                continue
            sources[name] = (fname, getattr(module, "SOURCE_META", {}))
    return sources


def sync_tool_todos(sync_sources, tools):
    """todo lines for any discovered sync source whose SOURCE_META declares a
    cli_tool that's missing, or installed but (per auth_check) not
    authenticated. Shared by `kb setup` and `kb doctor` so the two can't drift
    on wording for the same check."""
    todo = []
    for name, (_fname, meta) in sync_sources.items():
        cli_tool = meta.get("cli_tool")
        if not cli_tool or not meta.get("not_found_hint"):
            continue
        if tools[cli_tool]:
            if meta.get("auth_check") and not tools.get(f"{cli_tool}_auth"):
                todo.append(meta.get("not_authed_hint", f"{cli_tool} is installed but not authenticated"))
        else:
            todo.append(meta["not_found_hint"])
    return todo


def sync_configured_sources(sync_sources, tools):
    """Names of discovered sync sources that look ready to run right now, per
    SOURCE_META: env_keys (if any) all set in the environment, and (if
    cli_tool/auth_check are declared) that tool authenticated. A source with
    neither env_keys nor cli_tool declared (SOURCE_META is empty/absent) is
    never reported here -- there's nothing to check."""
    configured = []
    for name, (_fname, meta) in sync_sources.items():
        env_keys = meta.get("env_keys") or []
        cli_tool = meta.get("cli_tool")
        if not env_keys and not cli_tool:
            continue
        if env_keys and not all(os.environ.get(k) for k in env_keys):
            continue
        if cli_tool and not (tools.get(f"{cli_tool}_auth") if meta.get("auth_check") else tools.get(cli_tool)):
            continue
        configured.append(name)
    return configured


def _reindex_fast(root):
    """In-process incremental reindex -- same work as `run_script("index_fts.py")`
    but without paying for a fresh interpreter + subprocess on every call.
    Used by entry_set_tags/entry_set_links/entry_update_content, which kb
    web's edit panel can trigger repeatedly in quick succession; other
    callers keep using run_script for output capture / exit-code parity with
    `kb reindex`."""
    import index_fts
    index_fts.index_repo(root)


_FTS_OPERATORS = {"AND", "OR", "NOT", "NEAR"}


def _fts_autoprefix(query):
    """Append FTS5 prefix syntax (*) to bare word tokens, so `kb search dar`
    matches "Darren" the way a user typing a partial word expects. Leaves
    quoted phrases, boolean operators, column filters (title:...), and
    tokens that already use FTS5 syntax (*, parens, ^) untouched."""
    tokens = re.findall(r'"[^"]*"|\S+', query)
    out = []
    for tok in tokens:
        if tok.startswith('"') or tok.upper() in _FTS_OPERATORS or any(c in tok for c in '*():^'):
            out.append(tok)
        else:
            out.append(tok + "*")
    return " ".join(out)


def search_entries(root, query, entry_type=None, tag=None, include_all=False, limit=50):
    """Run an FTS5 search over the index, returning (id, title, type, path, rank)
    rows ordered by relevance -- the core of `kb search`, factored out so both
    the CLI and `kb web`'s /api/search can call the same query instead of
    duplicating the SQL. Raises sqlite3.OperationalError on a bad FTS5 query
    (e.g. unbalanced quotes) so callers can report it however fits their
    context (stderr print vs. a JSON error response)."""
    db_path = os.path.join(root, ".pkb", "fts.db")
    if not os.path.exists(db_path):
        return None  # no index -- distinct from "no results" (empty list)

    conn = sqlite3.connect(db_path)
    cur = conn.cursor()

    where = ["fts MATCH ?"]
    params = [_fts_autoprefix(query)]
    if not include_all:
        placeholders = ",".join("?" for _ in pc.CORE_TYPES)
        where.append(f"fts.type IN ({placeholders})")
        params.extend(pc.CORE_TYPES)
    if entry_type:
        where.append("fts.type = ?")
        params.append(entry_type)
    if tag:
        where.append("fts.tags MATCH ?")
        params.append(tag)

    sql = f"""
        SELECT f.id, f.title, f.type, f.path, bm25(fts) as rank
        FROM fts JOIN files f ON f.id = fts.id
        WHERE {' AND '.join(where)}
        ORDER BY rank LIMIT ?
    """
    try:
        rows = cur.execute(sql, params + [limit]).fetchall()
    finally:
        conn.close()
    return rows


def cmd_search(args):
    root = pc.get_repo_root()
    try:
        rows = search_entries(root, args.query, entry_type=args.type, tag=args.tag,
                               include_all=args.all)
    except sqlite3.OperationalError as e:
        print(f"search error: {e}")
        return 1
    if rows is None:
        print("no FTS index found. Run `kb index` first, or use ripgrep directly:")
        print(f"  rg --heading -n {args.query!r} tutorials how-to reference explanation")
        return 1

    if not rows:
        if args.json:
            print("[]")
            return 0
        print("no results")
        return 0

    if args.json:
        print(json.dumps([
            {"id": entry_id, "title": title, "type": entry_type, "path": path}
            for entry_id, title, entry_type, path, _rank in rows
        ]))
        return 0

    # interactive by default when the tooling supports it, same rule as kb todo:
    # fzf installed, both ends real terminals (never for piped/scripted use).
    interactive = not args.plain and shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()
    if interactive:
        return _search_interactive(root, rows)

    for entry_id, title, entry_type, path, _rank in rows:
        print(f"[{entry_type:11}] {entry_id}  {title}\n    {path}")
    if not shutil.which("fzf"):
        print("\n(install fzf for an interactive picker)")
    return 0


def _fzf_select(lines, prompt, header, delimiter=None, with_nth=None,
                 preview_cmd=None, preview_window="right:60%", multi=False):
    """Run fzf over `lines`, returning the raw selected line, or None if
    cancelled (esc/ctrl-c) or nothing was selected. Shared by every
    interactive picker in this file -- search/inbox/todo/journal each used to
    hand-roll this same subprocess.run + cancel-check.

    With multi=True (tab to toggle multiple matches in fzf), returns a list of
    selected lines instead of a single string, or None if nothing was picked."""
    cmd = ["fzf", "--prompt", prompt, "--header", header]
    if multi:
        cmd.append("--multi")
    if delimiter is not None:
        cmd += ["--delimiter", delimiter]
    if with_nth is not None:
        cmd += ["--with-nth", with_nth]
    if preview_cmd is not None:
        cmd += ["--preview", preview_cmd, "--preview-window", preview_window]
    result = subprocess.run(cmd, input="\n".join(lines), text=True, stdout=subprocess.PIPE)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    out = result.stdout.rstrip("\n")
    return out.split("\n") if multi else out


def _search_interactive(root, rows):
    """fzf-based picker: select a result (with a live file-content preview), then
    an action -- view (print full content), edit ($EDITOR), links (forward/back),
    or cancel. Same two-stage shape as kb todo's picker, for consistency."""
    lines, by_id = [], {}
    for entry_id, title, entry_type, path, _rank in rows:
        abs_path = os.path.join(root, path)
        lines.append(f"{entry_id}\t{entry_type}\t{title}\t{abs_path}")
        by_id[entry_id] = (title, abs_path)

    selected = _fzf_select(lines, "search> ", "enter: choose an action for this result",
                            delimiter="\t", with_nth="1,2,3", preview_cmd="cat {4}")
    if selected is None:
        return 0  # cancelled
    fields = selected.split("\t")
    chosen_id, chosen_path = fields[0], fields[3]
    title = by_id.get(chosen_id, ("", chosen_path))[0]

    choice = _fzf_select(["view", "edit", "links", "cancel"],
                          f"{chosen_id}> ", f"{title} -- choose an action")
    if choice is None:
        return 0

    if choice == "view":
        subprocess.run(["cat", chosen_path])
    elif choice == "edit":
        editor = pc.get_editor()
        parts = pc.resolve_editor_argv(editor) if editor else None
        if not parts:
            print(f"no editor available -- set $EDITOR or run `kb config editor <cmd>` -- {chosen_path}",
                  file=sys.stderr)
        else:
            try:
                subprocess.run(parts + [chosen_path])
            except FileNotFoundError:
                print(f"error: editor '{parts[0]}' not found on PATH -- fix it with `kb config editor <cmd>`",
                      file=sys.stderr)
    elif choice == "links":
        show_links(root, chosen_id)
    return 0


def cmd_new(args):
    root = pc.get_repo_root()
    tags = args.tags.split(",") if args.tags else []
    links = args.links.split(",") if args.links else []
    result = entry_new(root, args.type, args.title, tags=tags, links=links, body=args.body)
    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    print(result["path"])
    return 0


def _looks_like_date(text):
    try:
        datetime.strptime(text, "%Y-%m-%d")
    except ValueError:
        return False
    return True


def _journal_path(root, target):
    dir_path = os.path.join(root, "journal", f"{target.year:04d}", f"{target.month:02d}")
    return os.path.join(dir_path, f"{target.isoformat()}.md")


def _ensure_journal_entry(root, target):
    """Create target's journal file (with frontmatter) if it doesn't exist yet.
    Returns its path either way."""
    file_path = _journal_path(root, target)
    if not os.path.exists(file_path):
        all_ids = pc.collect_existing_ids(root)
        now = pc.now_iso()
        entry_id = pc.gen_id(all_ids, dt=datetime.combine(target, datetime.now().time()))
        fm = {
            "id": entry_id,
            "created": now,
            "updated": now,
            "type": "journal",
            "extension": "journal",
            "source": "manual",
            "source_id": None,
            "tags": [],
            "links": [],
            "title": target.isoformat(),
        }
        pc.write_entry(file_path, fm, f"# {target.isoformat()}\n\n")
    return file_path


def _open_in_editor(file_path):
    editor = pc.get_editor()
    parts = pc.resolve_editor_argv(editor) if editor else None
    if not parts:
        print(f"no editor available -- set $EDITOR or run `kb config editor <cmd>` -- {file_path}",
              file=sys.stderr)
        return
    sys.stdout.flush()  # os.execvp below replaces this process without flushing buffered stdout
    try:
        os.execvp(parts[0], parts + [file_path])  # replaces this process; nothing after this runs
    except FileNotFoundError:
        print(f"error: editor '{parts[0]}' not found on PATH -- fix it with `kb config editor <cmd>` "
              f"-- {file_path}", file=sys.stderr)
        sys.exit(1)


def list_journal_entries(root, limit=None):
    """(date_str, path) for journal files, newest first.

    Walks journal/YYYY/MM/ in descending order and stops as soon as `limit`
    entries are collected, instead of always listing every entry ever written
    just to keep the most recent few -- callers like cmd_journal's "recent
    entries" hint only ever want a handful.
    """
    journal_dir = os.path.join(root, "journal")
    if not os.path.isdir(journal_dir):
        return []

    def _subdirs_desc(path):
        return sorted((d for d in os.listdir(path) if os.path.isdir(os.path.join(path, d))), reverse=True)

    entries = []
    for year in _subdirs_desc(journal_dir):
        year_dir = os.path.join(journal_dir, year)
        for month in _subdirs_desc(year_dir):
            month_dir = os.path.join(year_dir, month)
            names = sorted((n for n in os.listdir(month_dir) if n.endswith(".md")), reverse=True)
            for name in names:
                entries.append((name[:-3], os.path.join(month_dir, name)))
                if limit and len(entries) >= limit:
                    return entries
    return entries


def _shift_months(date, delta):
    """date, shifted by `delta` months, clamped to the shifted month's length
    (e.g. Aug 31 - 1 month -> Jul 31, not an overflow into August)."""
    month_index = date.month - 1 + delta
    year = date.year + month_index // 12
    month = month_index % 12 + 1
    day = min(date.day, calendar.monthrange(year, month)[1])
    return date.replace(year=year, month=month, day=day)


def _on_this_day(root, target):
    """(label, date_str, path) for past journal entries at the offsets a
    "look back" feature cares about -- a week ago, a month ago, and this same
    month/day in each earlier year -- restricted to offsets that actually have
    an entry, so this never pads the list with empty prompts to fill in the
    past."""
    candidates = [("1 week ago", target - timedelta(days=7)),
                  ("1 month ago", _shift_months(target, -1))]
    for years in range(1, 11):
        try:
            d = target.replace(year=target.year - years)
        except ValueError:  # target is Feb 29 and this year isn't a leap year
            d = target.replace(year=target.year - years, day=28)
        label = "1 year ago" if years == 1 else f"{years} years ago"
        candidates.append((label, d))

    seen, results = set(), []
    for label, d in candidates:
        if d >= target or d in seen:
            continue
        seen.add(d)
        path = _journal_path(root, d)
        if os.path.exists(path):
            results.append((label, d.isoformat(), path))
    return results


def journal_append(root, target, text):
    """Append `text` to target's journal entry, creating it (with frontmatter)
    first if needed. No editor involved -- for jotting something down without
    leaving the shell (or, for `kb web`'s quick-capture box, without leaving the
    browser). A single line becomes a timestamped bullet; multiple lines (e.g.
    from _journal_add_editor) become a timestamped heading block, same shape
    `kb inbox`'s redirect action already uses.

    Returns {"path": <relpath>, "time": "HH:MM"} on success, or None if `text`
    was empty (nothing written). Shared by the CLI and the web capture endpoint
    so there's exactly one place this logic lives."""
    text = text.strip("\n")
    if not text:
        return None

    file_path = _ensure_journal_entry(root, target)
    fm, body = pc.read_entry(file_path)
    stamp = datetime.now().strftime("%H:%M")
    block = f"## {stamp}\n\n{text}\n" if "\n" in text else f"- {stamp}  {text}\n"
    body = body.rstrip("\n") + f"\n\n{block}"
    fm["updated"] = pc.now_iso()
    pc.write_entry(file_path, fm, body)
    run_script("index_fts.py")
    pc.git_autocommit(root, f"journal: {target.isoformat()}")
    return {"path": os.path.relpath(file_path, root), "time": stamp}


def _journal_add(root, target, text):
    result = journal_append(root, target, text)
    if result is None:
        print("empty -- nothing added")
        return 0
    print(f"added -> {result['path']}")
    return 0


def _journal_add_editor(root, target):
    """Open a blank scratch buffer in $EDITOR for multiline input, then append
    whatever was written to target's journal entry -- like `git commit` with no
    -m, but scoped to a throwaway temp file so the entry's frontmatter (and any
    earlier entries in the file) never has to be touched or scrolled past."""
    editor = pc.get_editor()
    parts = pc.resolve_editor_argv(editor) if editor else None
    if not parts:
        print("no editor available -- set $EDITOR or run `kb config editor <cmd>`", file=sys.stderr)
        return 1

    fd, tmp_path = tempfile.mkstemp(prefix="kb-journal-", suffix=".md")
    os.close(fd)
    try:
        try:
            subprocess.run(parts + [tmp_path], check=True)
        except FileNotFoundError:
            print(f"error: editor '{parts[0]}' not found on PATH -- fix it with `kb config editor <cmd>`",
                  file=sys.stderr)
            return 1
        except subprocess.CalledProcessError:
            print("editor exited with an error -- nothing added", file=sys.stderr)
            return 1
        with open(tmp_path, "r", encoding="utf-8") as f:
            text = f.read()
    finally:
        os.remove(tmp_path)

    return _journal_add(root, target, text)


def cmd_journal(args):
    root = pc.get_repo_root()

    if args.date == "rollup":
        return _journal_rollup(root, args.month)
    if args.tag:
        return _journal_by_tag(root, args.tag)

    explicit_date = args.date not in (None, "today")
    target = (datetime.now().date() if args.date in (None, "today")
              else datetime.strptime(args.date, "%Y-%m-%d").date())

    if args.add is not None:
        if args.add == "":  # -m/--add with no TEXT: open a scratch buffer instead
            return _journal_add_editor(root, target)
        if args.date is None and _looks_like_date(args.add):
            # `-m` typed before DATE: argparse's nargs='?' greedily consumes the
            # date token as -m's own TEXT instead of leaving it for the `date`
            # positional. Silently writing to today under those circumstances
            # would put the note on the wrong day with no indication anything
            # went wrong -- refuse instead, and say what order actually works.
            print(f"error: `-m {args.add}` was parsed as the note text, not a date -- "
                  f"put the date first: `kb journal {args.add} -m ...`", file=sys.stderr)
            return 1
        return _journal_add(root, target, args.add)

    if not explicit_date:
        # only the default "today" invocation gets the interactive picker -- an
        # explicit date means the user already knows exactly what they want open.
        interactive = not args.plain and shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()
        if interactive:
            return _journal_interactive(root)

    file_path = _ensure_journal_entry(root, target)

    if not explicit_date:
        # no fzf/terminal for a full picker -- still surface nearby entries and
        # this-day-in-the-past ones for context instead of silently jumping
        # straight into today's.
        on_this_day = _on_this_day(root, target)
        if on_this_day:
            print("on this day:")
            for label, date_str, path in on_this_day:
                print(f"  {label:12} {date_str}  {os.path.relpath(path, root)}")
            print()

        recent = [(d, p) for d, p in list_journal_entries(root, limit=6) if d != target.isoformat()][:5]
        if recent:
            print("recent entries:")
            for date_str, path in recent:
                print(f"  {date_str}  {os.path.relpath(path, root)}")
            print()

    _open_in_editor(file_path)
    return 0


def _journal_interactive(root):
    """fzf-based picker over journal entries: pick one (with a live content
    preview) to open in $EDITOR. Today is included even if it doesn't exist yet
    (tagged "new"), so this always offers a way to start today's entry too --
    same two-stage-friendly shape as the other pickers, minus the action step,
    since there's only one thing to do with a journal entry: open it."""
    today = datetime.now().date()
    today_iso = today.isoformat()
    entries = list_journal_entries(root)
    if today_iso not in {d for d, _ in entries}:
        entries = [(today_iso, _journal_path(root, today))] + entries

    on_this_day = _on_this_day(root, today)
    lines = [f"{date_str}\t{label}\t{path}" for label, date_str, path in on_this_day]
    for date_str, path in entries:
        tag = "new" if not os.path.exists(path) else ""
        lines.append(f"{date_str}\t{tag}\t{path}")

    selected = _fzf_select(lines, "journal> ", "enter: open this entry (created if new)",
                            delimiter="\t", with_nth="1,2",
                            preview_cmd="cat {3} 2>/dev/null || echo '(no entry yet)'")
    if selected is None:
        return 0  # cancelled

    date_str = selected.split("\t", 1)[0].strip()
    target = datetime.strptime(date_str, "%Y-%m-%d").date()
    file_path = _ensure_journal_entry(root, target)
    _open_in_editor(file_path)
    return 0


def _journal_by_tag(root, tag):
    """List journal entries carrying `tag`, newest first -- browsing a theme
    across time (e.g. everything tagged "homelab") rather than kb search's
    relevance ranking, which scatters same-theme entries by match strength
    instead of keeping them in chronological order."""
    matches = []
    for date_str, path in list_journal_entries(root):
        fm, _ = pc.read_entry(path)
        if tag in (fm.get("tags") or []):
            matches.append((date_str, path))

    if not matches:
        print(f"no journal entries tagged '{tag}'")
        return 0
    for date_str, path in matches:
        print(f"{date_str}  {os.path.relpath(path, root)}")
    return 0


def _rollup_month(month_arg):
    """(year, month) for `month_arg` (YYYY-MM), or the previous calendar month
    if not given -- the current month is usually still in progress, so it's a
    poor default for "summarize what happened"."""
    if month_arg:
        try:
            dt = datetime.strptime(month_arg, "%Y-%m")
        except ValueError:
            return None
        return dt.year, dt.month
    today = datetime.now().date()
    year, month = today.year, today.month - 1
    if month == 0:
        year, month = year - 1, 12
    return year, month


def _journal_rollup(root, month_arg):
    """Generate/refresh reference/journal-summaries/YYYY-MM.md: every day's
    entry in the month concatenated under a heading, plus a tag-frequency line,
    so a month of daily files can be browsed as one page instead of opened one
    by one. Deliberately not AI summarization -- just the raw entries assembled
    in one place; the point is browsability, not compression."""
    parsed = _rollup_month(month_arg)
    if parsed is None:
        print(f"error: invalid month '{month_arg}' -- expected YYYY-MM", file=sys.stderr)
        return 1
    year, month = parsed
    month_label = f"{year:04d}-{month:02d}"

    month_dir = os.path.join(root, "journal", f"{year:04d}", f"{month:02d}")
    if not os.path.isdir(month_dir):
        print(f"no journal entries found for {month_label}")
        return 1

    days = []
    for name in sorted(os.listdir(month_dir)):
        if not name.endswith(".md"):
            continue
        fm, body = pc.read_entry(os.path.join(month_dir, name))
        days.append((name[:-3], fm, body))
    if not days:
        print(f"no journal entries found for {month_label}")
        return 1

    tag_counts, day_ids, sections = {}, [], []
    for date_str, fm, body in days:
        if fm.get("id"):
            day_ids.append(fm["id"])
        for t in fm.get("tags") or []:
            tag_counts[t] = tag_counts.get(t, 0) + 1

        text = body.strip("\n")
        heading = f"# {date_str}"
        if text.startswith(heading):
            text = text[len(heading):].lstrip("\n")
        sections.append(f"## {date_str}\n\n{text.strip() or '(no content)'}\n")

    out_path = os.path.join(root, "reference", "journal-summaries", f"{month_label}.md")
    now = pc.now_iso()
    existing_fm = pc.read_entry(out_path)[0] if os.path.exists(out_path) else None
    if existing_fm and existing_fm.get("id"):
        entry_id, created = existing_fm["id"], existing_fm.get("created", now)
    else:
        entry_id = pc.gen_id(pc.collect_existing_ids(root), dt=datetime(year, month, 1))
        created = now

    fm = {
        "id": entry_id,
        "created": created,
        "updated": now,
        "type": "reference",
        "extension": None,
        "source": "manual",
        "source_id": None,
        "tags": ["journal-summary"],
        "links": day_ids,
        "title": f"Journal summary: {month_label}",
    }

    body = f"# Journal summary: {month_label}\n\n{len(days)} entries.\n"
    if tag_counts:
        top = sorted(tag_counts.items(), key=lambda kv: (-kv[1], kv[0]))
        body += "tags: " + ", ".join(f"{t} ({n})" for t, n in top) + "\n"
    body += "\n---\n\n" + "\n".join(sections)

    pc.write_entry(out_path, fm, body)
    run_script("index_fts.py")
    print(out_path)
    return 0


def cmd_inbox(args):
    root = pc.get_repo_root()
    inbox_dir = os.path.join(root, "inbox")

    if args.id is not None:
        return _inbox_act(root, inbox_dir, args)

    now = datetime.now().astimezone()
    files = sorted(
        f for f in os.listdir(inbox_dir) if f.endswith(".md")
    ) if os.path.isdir(inbox_dir) else []
    if not files:
        print("inbox is empty")
        return 0

    items = []
    for name in files:
        path = os.path.join(inbox_dir, name)
        try:
            fm, _ = pc.read_entry(path)
            created = fm.get("created")
            title = fm.get("title") or name
        except ValueError:
            created = None
            title = name
        created_dt = pc.parse_iso(created)
        age = (now - created_dt).days if created_dt else "?"
        items.append((name, age, title))

    interactive = not args.plain and shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()
    if interactive:
        return _inbox_interactive(root, items)

    for name, age, title in items:
        print(f"{age!s:>4}d  {name:<30} {title}")
    if not shutil.which("fzf"):
        print("\n(install fzf for an interactive picker: promote/redirect/discard)")
    return 0


def _inbox_act(root, inbox_dir, args):
    """Non-interactive triage: `kb inbox <id> promote|redirect|discard`. The
    only way to resolve an inbox item when fzf/a real terminal aren't
    available -- e.g. scripted use or an AI agent driving kb, neither of which
    ever gets the interactive picker."""
    if args.action is None:
        print(f"error: `kb inbox {args.id}` needs an action: promote <type> | redirect | discard",
              file=sys.stderr)
        return 1
    found = _inbox_find(inbox_dir, args.id)
    if found is None:
        print(f"error: no inbox item with id '{args.id}'", file=sys.stderr)
        return 1
    path, fm, body = found

    if args.action == "promote":
        if not args.type:
            print(f"error: `kb inbox {args.id} promote` needs a Diataxis type: {', '.join(pc.CORE_TYPES)}",
                  file=sys.stderr)
            return 1
        return _inbox_promote(root, path, fm, body, args.type)
    elif args.action == "redirect":
        return _inbox_redirect(root, path, fm, body)
    else:
        return _inbox_discard(root, path)


def _inbox_promote(root, path, fm, body, target_type):
    """Move an inbox item into core content as `target_type`, clearing
    `extension`. Shared by the interactive picker and non-interactive
    `kb inbox <id> promote <type>`."""
    title = fm.get("title") or os.path.basename(path)
    fm["type"] = target_type
    fm["extension"] = None
    fm["updated"] = pc.now_iso()
    new_path = os.path.join(root, pc.TYPE_DIR[target_type], f"{fm['id']}-{pc.slugify(title)}.md")
    pc.write_entry(new_path, fm, body)
    os.remove(path)
    print(f"promoted -> {os.path.relpath(new_path, root)}")
    run_script("index_fts.py")
    pc.git_autocommit(root, f"inbox promote: {title} -> {target_type}")
    return 0


def _inbox_redirect(root, path, fm, body):
    """Append an inbox item into its created-date's journal entry (creating
    that entry first if needed) and remove it from inbox/. Shared by the
    interactive picker and non-interactive `kb inbox <id> redirect`."""
    title = fm.get("title") or os.path.basename(path)
    created_dt = pc.parse_iso(fm.get("created")) or datetime.now().astimezone()
    journal_dir = os.path.join(root, "journal", f"{created_dt.year:04d}", f"{created_dt.month:02d}")
    journal_path = os.path.join(journal_dir, f"{created_dt.date().isoformat()}.md")
    if not os.path.exists(journal_path):
        all_ids = pc.collect_existing_ids(root)
        jid = pc.gen_id(all_ids, dt=created_dt)
        now_s = pc.now_iso()
        jfm = {
            "id": jid, "created": now_s, "updated": now_s,
            "type": "journal", "extension": "journal", "source": "manual",
            "source_id": None, "tags": [], "links": [],
            "title": created_dt.date().isoformat(),
        }
        pc.write_entry(journal_path, jfm, f"# {created_dt.date().isoformat()}\n\n")
    with open(journal_path, "r", encoding="utf-8") as f:
        existing = f.read()
    with open(journal_path, "w", encoding="utf-8") as f:
        f.write(existing.rstrip("\n") + f"\n\n## {title}\n\n{body.strip()}\n")
    os.remove(path)
    print(f"redirected -> {os.path.relpath(journal_path, root)}")
    run_script("index_fts.py")
    pc.git_autocommit(root, f"inbox redirect: {title}")
    return 0


def _inbox_discard(root, path):
    name = os.path.basename(path)
    os.remove(path)
    print(f"discarded {name}")
    run_script("index_fts.py")
    pc.git_autocommit(root, f"inbox discard: {name}")
    return 0


def _inbox_find(inbox_dir, item_id):
    """(path, fm, body) for the inbox item with this id, or None. Inbox items
    are addressed by id here, same as kb tag/kb link, not by filename."""
    if not os.path.isdir(inbox_dir):
        return None
    for name in os.listdir(inbox_dir):
        if not name.endswith(".md"):
            continue
        path = os.path.join(inbox_dir, name)
        try:
            fm, body = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id") == item_id:
            return path, fm, body
    return None


def _inbox_interactive(root, items):
    """fzf-based triage: select an item (live content preview), then promote
    (choose a Diataxis type, moved there with extension cleared), redirect
    (appended into that day's journal entry, per its created date), or discard.
    Every inbox item must end in one of exactly these three states (spec S5) --
    this is what lets kb inbox actually resolve that, not just report on it."""
    inbox_dir = os.path.join(root, "inbox")
    lines = []
    for name, age, title in items:
        lines.append(f"{name}\t{age}d\t{title}")

    preview_cmd = f"cat {shlex.quote(inbox_dir)}/{{1}}"
    selected = _fzf_select(lines, "inbox> ", "enter: promote / redirect / discard this item",
                            delimiter="\t", with_nth="1,2,3", preview_cmd=preview_cmd)
    if selected is None:
        return 0  # cancelled
    chosen_name = selected.split("\t", 1)[0].strip()
    chosen_path = os.path.join(inbox_dir, chosen_name)
    fm, body = pc.read_entry(chosen_path)
    title = fm.get("title") or chosen_name

    choice = _fzf_select(["promote", "redirect", "discard", "cancel"],
                          f"{chosen_name}> ", f"{title} -- promote/redirect/discard/cancel")
    if choice is None or choice == "cancel":
        return 0

    if choice == "promote":
        target_type = _fzf_select(pc.CORE_TYPES, "type> ", "promote to which Diataxis type?")
        if target_type is None:
            return 0
        return _inbox_promote(root, chosen_path, fm, body, target_type)
    elif choice == "redirect":
        return _inbox_redirect(root, chosen_path, fm, body)
    elif choice == "discard":
        return _inbox_discard(root, chosen_path)
    return 0


def cmd_triage(args):
    return run_script("triage_report.py", ["--json"] if args.json else [])


def cmd_sync(args):
    sync_sources = discover_sync_sources()
    # sources whose SOURCE_META sets uses_sops read credentials from the environment;
    # if this data repo keeps them sops-encrypted, decrypt straight into that one
    # subprocess's env via `sops exec-env` -- no wrapping needed at the call site,
    # and the values never pass through kb's own environment or output.
    targets = list(sync_sources.keys()) if args.source in (None, "all") else [args.source]
    root = pc.get_repo_root()
    secrets_path = os.path.join(root, ".pkb", "secrets.enc.env")
    use_sops = shutil.which("sops") and os.path.exists(secrets_path)

    rc = 0
    for t in targets:
        print(f"--- sync: {t} ---")
        fname, meta = sync_sources[t]
        script_path = os.path.join(SCRIPT_DIR, fname)
        if use_sops and meta.get("uses_sops"):
            cmd_str = f"{shlex.quote(sys.executable)} {shlex.quote(script_path)}"
            target_rc = _run_captured(["sops", "exec-env", secrets_path, cmd_str], env=sops_key_env())
        else:
            target_rc = _run_captured([sys.executable, script_path])
        rc = target_rc or rc
    pc.git_autocommit(root, f"sync: {', '.join(targets)}")
    # sync writes new/updated files straight to disk -- without this the FTS
    # index goes stale immediately and `kb doctor`/`kb search` won't see them
    # until someone remembers to run `kb index` by hand.
    index_rc = run_script("index_fts.py")
    return index_rc or rc


def cmd_index(args):
    return run_script("index_fts.py", ["--full"] if args.full else [])


def cmd_validate(args):
    return run_script("validate_frontmatter.py")


def _find_entry(root, entry_id):
    """(path, fm, body) for the entry with this id, or None. Shared by kb tag and
    kb link -- both need to locate and rewrite one specific entry by id, the only
    sanctioned way to touch tags/links now that hand-editing frontmatter is off
    limits (see SKILL.md's "never hand-edit frontmatter" rule)."""
    for path in pc.iter_markdown_files(root):
        try:
            fm, body = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id") == entry_id:
            return path, fm, body
    return None


_SOURCE_LINK_RE = re.compile(r"\[([^\]]+)\]\((https?://\S+)\)\s*$")


def _readonly_source_info(path, body):
    """None if `path` is writable; otherwise (label, url) describing where to
    make the edit instead. A source mirror is written chmod 0o444 by
    write_entry_readonly (see sync_memos.py) precisely so a local edit can't
    be silently clobbered by the next sync pass -- checking the filesystem
    bit directly (rather than e.g. fm.get("source") == "memos") means this
    stays correct for any sync that adopts the same read-only convention,
    without this file needing to know which sources do.

    Every read-only-mirroring sync script appends exactly one trailing
    markdown link to the body naming where the item lives upstream (e.g.
    "[Memo](https://.../memos/101)") -- reused here as the "edit it there"
    pointer rather than reconstructing the URL from frontmatter."""
    if os.access(path, os.W_OK):
        return None
    m = _SOURCE_LINK_RE.search(body.strip())
    return (m.group(1), m.group(2)) if m else ("its source", None)


def _apply_tag_changes(tags, add=None, rm=None):
    """Pure list transform: apply add/rm to a list, returning (new_list,
    changed) -- the only place the actual add/rm set-diff logic lives. Used
    for both tags and links (the semantics are identical: dedup on add, drop
    on rm), via entry_set_tags/entry_set_links."""
    new_tags = list(tags)
    changed = False
    if add:
        additions = [t for t in add if t not in new_tags]
        new_tags.extend(additions)
        changed = changed or bool(additions)
    if rm:
        before = len(new_tags)
        new_tags = [t for t in new_tags if t not in rm]
        changed = changed or before != len(new_tags)
    return new_tags, changed


def _clean_list(items):
    """Strip whitespace, drop blanks, and dedupe (order-preserving) --
    shared by entry_new so every caller gets the same tags/links hygiene
    regardless of whether its input arrived pre-cleaned (CLI comma-split
    args) or raw (a JSON POST body)."""
    seen = set()
    cleaned = []
    for item in items or []:
        item = item.strip()
        if item and item not in seen:
            seen.add(item)
            cleaned.append(item)
    return cleaned


def entry_new(root, entry_type, title, tags=None, links=None, body=None):
    """Create a new core-content entry (tutorial/how-to/reference/explanation)
    with correct frontmatter, write it to disk, and reindex. Returns
    {"id", "path"} for the created entry, or {"error": ...} if `entry_type`
    is invalid or `links` names id(s) that don't exist in this repo. Shared
    by cmd_new (CLI) and kb web's entry-creation endpoint."""
    if entry_type not in pc.CORE_TYPES:
        return {"error": f"type must be one of {list(pc.CORE_TYPES)}"}

    tags = _clean_list(tags)
    links = _clean_list(links)

    # kb web's server is threaded, so two POST /api/entries calls (or a web
    # create racing a CLI `kb new`) can otherwise both scan existing ids,
    # both land in the same gen_id() minute bucket, and both write the same
    # path -- the second write silently clobbering the first entry. Serialize
    # the scan-through-write on a repo-level lock (there's no entry file yet
    # to lock on, unlike entry_set_tags/entry_set_links/entry_update_content).
    pkb_dir = os.path.join(root, ".pkb")
    os.makedirs(pkb_dir, exist_ok=True)
    with pc.entry_lock(os.path.join(pkb_dir, "entry-new")):
        all_ids = pc.collect_existing_ids(root)
        unknown = [t for t in links if t not in all_ids]
        if unknown:
            return {"error": f"unknown link target id(s), not found in this repo: {', '.join(unknown)}"}

        entry_id = pc.gen_id(all_ids)
        now = pc.now_iso()
        fm = {
            "id": entry_id,
            "created": now,
            "updated": now,
            "type": entry_type,
            "extension": None,
            "source": "manual",
            "source_id": None,
            "tags": tags,
            "links": links,
            "title": title,
        }
        path = os.path.join(root, pc.TYPE_DIR[entry_type], f"{entry_id}-{pc.slugify(title)}.md")
        entry_body = f"# {title}\n\n{body.strip()}\n" if body else f"# {title}\n\n"
        pc.write_entry(path, fm, entry_body)
        _reindex_fast(root)
        pc.git_autocommit(root, f"new {entry_type}: {title}")
    return {"id": entry_id, "path": path}


def _readonly_error(label, url):
    where = f"{label} ({url})" if url else label
    return {"error": f"read-only: synced from {where} -- edit it there instead",
            "readonly": True, "source_label": label, "source_url": url}


def _readonly_guard(path, body):
    """{"error": ..., "readonly": True, ...} if `path` is a read-only source
    mirror, else None -- the guard entry_set_tags, entry_set_links, and
    entry_update_content each need before mutating an entry."""
    readonly = _readonly_source_info(path, body)
    return _readonly_error(*readonly) if readonly else None


def entry_set_tags(root, entry_id, add=None, rm=None):
    """Apply add/rm to an entry's tags and persist if anything changed.
    Returns the resulting tag list, {"error": ..., "readonly": True, ...} if
    the entry is a read-only source mirror (see _readonly_source_info), or
    None if no entry has this id. Shared by cmd_tag (CLI) and kb web's
    tag-edit endpoint."""
    found = _find_entry(root, entry_id)
    if found is None:
        return None
    path, _fm, body = found
    guard = _readonly_guard(path, body)
    if guard:
        return guard
    with pc.entry_lock(path):
        fm, body = pc.read_entry(path)
        tags, changed = _apply_tag_changes(fm.get("tags") or [], add=add, rm=rm)
        if changed:
            fm["tags"] = tags
            fm["updated"] = pc.now_iso()
            pc.write_entry(path, fm, body)
            _reindex_fast(root)
            pc.git_autocommit(root, f"tags: {entry_id}")
    return tags


def entry_set_links(root, entry_id, add=None, rm=None):
    """Same as entry_set_tags but for links. Returns the resulting link list;
    None if no entry has this id; {"error": ...} if `add` names id(s) that
    don't exist in the repo. Shared by cmd_link (CLI) and kb web's link-edit
    endpoint."""
    found = _find_entry(root, entry_id)
    if found is None:
        return None
    path, _fm, body = found
    guard = _readonly_guard(path, body)
    if guard:
        return guard
    if add:
        all_ids = pc.collect_existing_ids(root)
        unknown = [t for t in add if t not in all_ids]
        if unknown:
            return {"error": f"unknown id(s), not found in this repo: {', '.join(unknown)}"}
    with pc.entry_lock(path):
        fm, body = pc.read_entry(path)
        links, changed = _apply_tag_changes(list(fm.get("links") or []), add=add, rm=rm)
        if changed:
            fm["links"] = links
            fm["updated"] = pc.now_iso()
            pc.write_entry(path, fm, body)
            _reindex_fast(root)
            pc.git_autocommit(root, f"links: {entry_id}")
    return links


def entry_update_content(root, entry_id, title=None, body=None):
    """Overwrite an entry's title and/or body and persist if anything changed.
    Returns {"title", "body"} for the resulting entry, or None if no entry has
    this id. Shared by kb web's content-edit endpoint (no CLI counterpart yet
    -- editing full content is currently a web-only affordance)."""
    found = _find_entry(root, entry_id)
    if found is None:
        return None
    path, _fm, body = found
    guard = _readonly_guard(path, body)
    if guard:
        return guard
    with pc.entry_lock(path):
        fm, cur_body = pc.read_entry(path)
        changed = False
        if title is not None and title != fm.get("title"):
            fm["title"] = title
            changed = True
        if body is not None and body != cur_body:
            cur_body = body
            changed = True
        if changed:
            fm["updated"] = pc.now_iso()
            pc.write_entry(path, fm, cur_body)
            _reindex_fast(root)
            pc.git_autocommit(root, f"edit: {entry_id}")
    return {"title": fm.get("title"), "body": cur_body}


def entry_delete(root, entry_id, force=False):
    """Delete an entry by id. Refuses if other entries still link to it, unless
    force=True -- in which case this id is also stripped from every one of
    those entries' `links` first, so the delete can never leave a dangling
    reference for `kb validate` to catch later. Returns {"path",
    "backlinks_cleared"} on success, or {"error": ...}. Shared by cmd_rm (CLI)
    and kb web's delete endpoint.

    Finds the target and collects backlinks in one pass over the repo --
    locating the target and checking every entry's `links` both require
    reading every file's frontmatter anyway, so there's no early exit to lose
    by combining them (unlike _find_entry, which can stop as soon as it
    matches)."""
    path = None
    backlinks = []
    for p in pc.iter_markdown_files(root):
        try:
            fm, _body = pc.read_entry(p)
        except ValueError:
            continue
        if fm.get("id") == entry_id:
            path = p
            continue
        if entry_id in (fm.get("links") or []):
            backlinks.append((p, fm))

    if path is None:
        return {"error": f"no entry with id '{entry_id}'"}

    if backlinks and not force:
        ids = ", ".join(fm.get("id") for _p, fm in backlinks)
        return {"error": f"'{entry_id}' is linked from {len(backlinks)} entry(ies) ({ids}) "
                          f"-- pass --force to delete anyway (their links will be cleaned up)"}

    for p, _fm in backlinks:
        with pc.entry_lock(p):
            bfm, bbody = pc.read_entry(p)
            bfm["links"] = [l for l in (bfm.get("links") or []) if l != entry_id]
            bfm["updated"] = pc.now_iso()
            pc.write_entry(p, bfm, bbody)

    with pc.entry_lock(path):
        os.remove(path)
    _reindex_fast(root)
    pc.git_autocommit(root, f"rm: {entry_id}")
    return {"path": os.path.relpath(path, root), "backlinks_cleared": len(backlinks)}


def entry_move(root, entry_id, new_type=None, new_title=None):
    """Move a core entry to a different Diataxis type and/or rename its title,
    rewriting frontmatter and relocating the file to match -- the sanctioned
    way to fix a miscategorized or mistitled entry, since hand-editing
    frontmatter (or moving the file yourself, which would desync `type` from
    the directory it lives in) is off limits. Returns {"path"} on success, or
    {"error": ...}. Shared by cmd_mv (CLI) and kb web's move endpoint."""
    if new_type is None and new_title is None:
        return {"error": "need --type and/or --title"}
    if new_type is not None and new_type not in pc.CORE_TYPES:
        return {"error": f"type must be one of {list(pc.CORE_TYPES)}"}

    found = _find_entry(root, entry_id)
    if found is None:
        return {"error": f"no entry with id '{entry_id}'"}
    path, fm, _body = found
    if fm.get("type") not in pc.CORE_TYPES:
        return {"error": f"'{entry_id}' is type '{fm.get('type')}' -- kb mv only handles core "
                          f"content ({', '.join(pc.CORE_TYPES)}); inbox items use "
                          f"`kb inbox <id> promote`"}

    with pc.entry_lock(path):
        fm, body = pc.read_entry(path)
        target_type = new_type or fm["type"]
        target_title = new_title or fm["title"]
        if target_type == fm["type"] and target_title == fm["title"]:
            return {"path": os.path.relpath(path, root)}
        fm["type"] = target_type
        fm["title"] = target_title
        fm["updated"] = pc.now_iso()
        new_path = os.path.join(root, pc.TYPE_DIR[target_type], f"{entry_id}-{pc.slugify(target_title)}.md")
        pc.write_entry(new_path, fm, body)
        if new_path != path:
            os.remove(path)
    _reindex_fast(root)
    pc.git_autocommit(root, f"mv: {entry_id} -> {target_type}")
    return {"path": os.path.relpath(new_path, root)}


def inbox_list(root):
    """[{"id", "name", "title", "age_days", "created"}, ...] for everything in
    inbox/, sorted by filename -- the data behind `kb inbox`'s plain listing.
    Kept separate from cmd_inbox's own listing loop (which feeds items as bare
    tuples into the fzf interactive picker) so this can return a clean,
    JSON-friendly shape for kb web's /api/inbox without disturbing that path."""
    inbox_dir = os.path.join(root, "inbox")
    now = datetime.now().astimezone()
    files = sorted(f for f in os.listdir(inbox_dir) if f.endswith(".md")) if os.path.isdir(inbox_dir) else []
    items = []
    for name in files:
        path = os.path.join(inbox_dir, name)
        try:
            fm, _ = pc.read_entry(path)
            created, title, entry_id = fm.get("created"), fm.get("title") or name, fm.get("id")
        except ValueError:
            created, title, entry_id = None, name, None
        created_dt = pc.parse_iso(created)
        age_days = (now - created_dt).days if created_dt else None
        items.append({"id": entry_id, "name": name, "title": title, "age_days": age_days, "created": created})
    return items


def _iter_all_entries(root):
    """[{id, title, type, path}] for every entry in the repo (core + journal/
    inbox/sources) -- shared by the tag/link pickers below, which need to offer
    any entry as a target, not just core Diataxis content."""
    entries = []
    for path in pc.iter_markdown_files(root):
        try:
            fm, _ = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id"):
            entries.append({"id": fm["id"], "title": fm.get("title") or "",
                             "type": fm.get("type") or "", "path": path})
    entries.sort(key=lambda e: e["id"], reverse=True)
    return entries


def _all_tags(root):
    """Sorted set of every tag currently used anywhere in the repo -- offered as
    the pick list when adding a tag interactively, alongside the option to type
    a new one."""
    tags = set()
    for path in pc.iter_markdown_files(root):
        try:
            fm, _ = pc.read_entry(path)
        except ValueError:
            continue
        tags.update(fm.get("tags") or [])
    return sorted(tags)


def _entry_fzf_lines(entries):
    return [f"{e['id']}\t{e['type']}\t{e['title']}\t{e['path']}" for e in entries]


def _pick_entry(root, prompt, header, exclude_ids=()):
    """fzf picker over every entry in the repo, returning the chosen id (or None
    if cancelled/unavailable) -- used when `kb tag`/`kb link` are invoked with no
    id, so the id doesn't have to be hunted down by hand first."""
    entries = [e for e in _iter_all_entries(root) if e["id"] not in exclude_ids]
    if not entries:
        return None
    selected = _fzf_select(_entry_fzf_lines(entries), prompt, header, delimiter="\t",
                            with_nth="1,2,3", preview_cmd="cat {4}")
    return selected.split("\t")[0] if selected else None


def _pick_entries_multi(root, prompt, header, candidate_ids):
    """fzf multi-select picker restricted to `candidate_ids`, returning the
    chosen ids or None. Used for `kb link add` (candidates = every id not
    already linked, minus self)."""
    entries = [e for e in _iter_all_entries(root) if e["id"] in candidate_ids]
    if not entries:
        return None
    picked = _fzf_select(_entry_fzf_lines(entries), prompt, header, delimiter="\t",
                          with_nth="1,2,3", preview_cmd="cat {4}", multi=True)
    return [line.split("\t")[0] for line in picked] if picked else None


def _pick_tags_to_add(root, prompt, header):
    """fzf picker for `kb tag add` with no tags given: tab to multi-select from
    every tag already used in the repo, or type one or more new comma-separated
    tags and press enter with nothing selected to create them. Returns a list
    of tags, or None if cancelled."""
    cmd = ["fzf", "--multi", "--print-query", "--prompt", prompt, "--header", header]
    result = subprocess.run(cmd, input="\n".join(_all_tags(root)), text=True, stdout=subprocess.PIPE)
    if result.returncode == 130:
        return None  # esc / ctrl-c
    lines = result.stdout.split("\n")
    query, selected = lines[0], [l for l in lines[1:] if l.strip()]
    if selected:
        return selected
    if query.strip():
        return [t.strip() for t in query.split(",") if t.strip()]
    return None


def cmd_tag(args):
    """Add/remove tags on an entry -- the only sanctioned way to change `tags`,
    since hand-editing frontmatter is off limits. With no action, just list the
    entry's current tags.

    Anything left unspecified on the command line -- the id, or the tags to
    add/remove -- is filled in with an fzf picker when one is available
    (installed + both ends real terminals), same rule as every other
    interactive picker in this file."""
    root = pc.get_repo_root()
    interactive = shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()

    entry_id = args.id
    if entry_id is None:
        if not interactive:
            print("error: `kb tag` needs an entry id (install fzf and run from a "
                  "terminal for a picker)", file=sys.stderr)
            return 1
        entry_id = _pick_entry(root, "tag> ", "select an entry to tag")
        if entry_id is None:
            return 0  # cancelled, or nothing to pick from

    found = _find_entry(root, entry_id)
    if found is None:
        print(f"error: no entry with id '{entry_id}'", file=sys.stderr)
        return 1
    path, fm, body = found
    tags = list(fm.get("tags") or [])

    if args.action is None:
        print(", ".join(tags) if tags else "(no tags)")
        return 0

    values = args.values
    if not values:
        if not interactive:
            print(f"error: `kb tag {entry_id} {args.action}` needs at least one tag",
                  file=sys.stderr)
            return 1
        if args.action == "add":
            values = _pick_tags_to_add(
                root, "add tag> ",
                "tab: multi-select existing tags -- or type new ones (comma-separated) and enter")
        else:
            if not tags:
                print(f"no tags to remove on {entry_id}")
                return 0
            values = _fzf_select(tags, "rm tag> ", "tab: multi-select tags to remove", multi=True)
        if not values:
            return 0  # cancelled

    result = entry_set_tags(root, entry_id, add=values if args.action == "add" else None,
                             rm=values if args.action == "rm" else None)
    if isinstance(result, dict):  # {"error": "...", "readonly": True, ...}
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    changed = result != (fm.get("tags") or [])
    prefix = "" if changed else "no change -- "
    print(f"{prefix}tags for {entry_id}: {', '.join(result) if result else '(none)'}")
    return 0


def cmd_rm(args):
    """Delete an entry by id -- the sanctioned way to remove a file created
    under the Diataxis structure, since deleting it out from under kb (with
    `rm` directly) would leave the FTS index and any backlinks stale."""
    root = pc.get_repo_root()
    result = entry_delete(root, args.id, force=args.force)
    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    suffix = f" ({result['backlinks_cleared']} backlink(s) cleaned up)" if result["backlinks_cleared"] else ""
    print(f"deleted {result['path']}{suffix}")
    return 0


def cmd_mv(args):
    """Move an entry to a different Diataxis type and/or rename its title --
    the sanctioned way to recategorize or retitle a file created under the
    Diataxis structure, since hand-moving it would desync `type` from the
    directory it lives in."""
    root = pc.get_repo_root()
    result = entry_move(root, args.id, new_type=args.type, new_title=args.title)
    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    print(f"-> {result['path']}")
    return 0


def cmd_link(args):
    """Add/remove forward links on an entry -- the only sanctioned way to change
    `links`, since hand-editing frontmatter is off limits. With no action, show
    forward links + backlinks (same as kb links).

    Anything left unspecified on the command line -- the id, or the target
    ids to add/remove -- is filled in with an fzf picker when one is
    available, same rule as kb tag."""
    root = pc.get_repo_root()
    interactive = shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()

    entry_id = args.id
    if entry_id is None:
        if not interactive:
            print("error: `kb link` needs an entry id (install fzf and run from a "
                  "terminal for a picker)", file=sys.stderr)
            return 1
        entry_id = _pick_entry(root, "link> ", "select an entry to link")
        if entry_id is None:
            return 0

    if args.action is None:
        return show_links(root, entry_id, json_out=args.json)

    found = _find_entry(root, entry_id)
    if found is None:
        print(f"error: no entry with id '{entry_id}'", file=sys.stderr)
        return 1
    path, fm, body = found
    links = list(fm.get("links") or [])

    values = args.values
    if not values:
        if not interactive:
            print(f"error: `kb link {entry_id} {args.action}` needs at least one target id",
                  file=sys.stderr)
            return 1
        if args.action == "add":
            candidate_ids = {e["id"] for e in _iter_all_entries(root)} - {entry_id} - set(links)
            values = _pick_entries_multi(root, "add link> ",
                                          "tab: multi-select entries to link to", candidate_ids)
        else:
            if not links:
                print(f"no links to remove on {entry_id}")
                return 0
            values = _fzf_select(links, "rm link> ", "tab: multi-select links to remove", multi=True)
        if not values:
            return 0

    result = entry_set_links(root, entry_id, add=values if args.action == "add" else None,
                              rm=values if args.action == "rm" else None)
    if isinstance(result, dict):  # {"error": "unknown id(s) ..."}
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    changed = result != links
    prefix = "" if changed else "no change -- "
    print(f"{prefix}links for {entry_id}: {', '.join(result) if result else '(none)'}")
    return 0


def show_links(root, target_id, json_out=False):
    """Print forward links + backlinks for an entry. Shared by cmd_links and the
    interactive search picker's 'links' action."""
    forward = None
    backlinks = []
    target_path = None

    for path in pc.iter_markdown_files(root):
        try:
            fm, _ = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id") == target_id:
            forward = fm.get("links") or []
            target_path = os.path.relpath(path, root)
        if target_id in (fm.get("links") or []):
            backlinks.append((fm.get("id"), fm.get("title"), os.path.relpath(path, root)))

    if forward is None:
        if json_out:
            print(f'{{"error": "no entry with id \'{target_id}\'"}}', file=sys.stderr)
        else:
            print(f"error: no entry with id '{target_id}'", file=sys.stderr)
        return 1

    if json_out:
        import json
        print(json.dumps({
            "id": target_id,
            "path": target_path,
            "forward": forward,
            "backlinks": [{"id": lid, "title": title, "path": path} for lid, title, path in backlinks],
        }))
        return 0

    print(f"{target_id}  ({target_path})")
    print(f"\nforward links ({len(forward)}):")
    for link_id in forward:
        print(f"  -> {link_id}")
    print(f"\nbacklinks ({len(backlinks)}):")
    for link_id, title, path in backlinks:
        print(f"  <- {link_id}  {title}  ({path})")
    return 0


def cmd_links(args):
    root = pc.get_repo_root()
    return show_links(root, args.id, json_out=args.json)


def cmd_show(args):
    """Print an entry's full content by id -- the id-addressed counterpart to
    kb search/kb links, for when you already know the id and just want the
    content without looking up its path first."""
    root = pc.get_repo_root()
    found = _find_entry(root, args.id)
    if found is None:
        print(f"error: no entry with id '{args.id}'", file=sys.stderr)
        return 1
    path, fm, body = found

    if args.json:
        import json
        print(json.dumps({"id": args.id, "path": os.path.relpath(path, root),
                           "frontmatter": fm, "body": body}))
        return 0

    with open(path, "r", encoding="utf-8") as f:
        sys.stdout.write(f.read())
    return 0


def bd_available():
    return shutil.which("bd") is not None


def _bd_run(bd_args):
    """Run a `bd` subcommand, returning its stripped stdout. Raises
    RuntimeError(stderr) on failure. Shared by every bd_* helper below so the
    run/error/strip contract lives in exactly one place."""
    result = subprocess.run(bd_args, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())
    return result.stdout.strip()


def bd_list(root, include_all=False):
    """Open (or all, with include_all) bd issues as parsed JSON, sorted by
    priority. Raises RuntimeError(stderr) if bd itself errors. Shared by
    cmd_todo's non-add path and kb web's GET /api/todo."""
    bd_args = ["bd", "-C", root, "list", "--json", "--sort", "priority", "--limit", "0"]
    if include_all:
        bd_args.append("--all")
    return json.loads(_bd_run(bd_args))


def bd_create(root, title, description=None, priority="2", issue_type="task", labels=None):
    """Create a bd issue, returning bd's own confirmation text. Raises
    RuntimeError(stderr) on failure. Shared by _todo_add (kb todo -a TITLE)
    and kb web's POST /api/todo."""
    bd_args = ["bd", "-C", root, "create", "--title", title, "--type", issue_type, "--priority", priority]
    if description:
        bd_args += ["--description", description]
    if labels:
        bd_args += ["--labels", labels]
    return _bd_run(bd_args)


def bd_update(root, issue_id, priority=None, issue_type=None, description=None,
              assignee=None, add_label=None, remove_label=None):
    """Update fields on an existing bd issue, returning bd's own stdout. Raises
    RuntimeError(stderr) on failure. Used by kb web's PATCH /api/todo/{id} for
    editing an already-created todo. add_label/remove_label touch one label at
    a time, mirroring the tag chip add/remove UX used elsewhere in kb web."""
    bd_args = ["bd", "-C", root, "update", issue_id]
    if priority is not None:
        bd_args += ["--priority", str(priority)]
    if issue_type is not None:
        bd_args += ["--type", issue_type]
    if description is not None:
        bd_args += ["--description", description]
    if assignee is not None:
        bd_args += ["--assignee", assignee]
    if add_label:
        bd_args += ["--add-label", add_label]
    if remove_label:
        bd_args += ["--remove-label", remove_label]
    return _bd_run(bd_args)


def bd_reopen(root, issue_id):
    """Reopen a closed bd issue, returning bd's own stdout. Raises
    RuntimeError(stderr) on failure. Used by kb web's todo action endpoint."""
    return _bd_run(["bd", "-C", root, "reopen", issue_id])


def bd_delete(root, issue_id):
    """Permanently delete a bd issue, returning bd's own stdout. Raises
    RuntimeError(stderr) on failure. Used by kb web's DELETE /api/todo/{id}.
    --force is required since kb web already confirms the action client-side."""
    return _bd_run(["bd", "-C", root, "delete", issue_id, "--force"])


def bd_deps(root, issue_id, direction="down"):
    """List an issue's dependencies (direction='down', what it's blocked by) or
    dependents (direction='up', what it blocks) as parsed JSON. Raises
    RuntimeError(stderr) on failure. Used by kb web's GET /api/todo/{id}/deps."""
    bd_args = ["bd", "-C", root, "dep", "list", issue_id, "--direction", direction, "--json"]
    stdout = _bd_run(bd_args)
    return json.loads(stdout) if stdout else []


def bd_dep_add(root, from_id, to_id):
    """Record that `from_id` depends on (is blocked by) `to_id`, returning bd's
    own stdout. Raises RuntimeError(stderr) on failure."""
    return _bd_run(["bd", "-C", root, "dep", "add", from_id, to_id])


def bd_dep_remove(root, from_id, to_id):
    """Remove the dependency recorded by bd_dep_add(from_id, to_id), returning
    bd's own stdout. Raises RuntimeError(stderr) on failure."""
    return _bd_run(["bd", "-C", root, "dep", "remove", from_id, to_id])


def bd_action(root, action, issue_id, comment_text=None):
    """Run `bd show|close|comment|reopen` for one issue, returning bd's own
    stdout. Raises RuntimeError(stderr) on failure. Used by kb web's todo
    action endpoint -- the CLI's interactive picker (_todo_interactive) calls
    bd directly via subprocess instead, since it streams straight to the
    terminal rather than needing a return value."""
    bd_args = ["bd", "-C", root, action, issue_id]
    if action == "comment":
        bd_args.append(comment_text or "")
    result = subprocess.run(bd_args, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())
    return result.stdout.strip()


def cmd_todo(args):
    if not shutil.which("bd"):
        print("bd CLI not found -- install it (`brew install beads`) to track TODOs. "
              "See `kb doctor`.", file=sys.stderr)
        return 1

    root = pc.get_repo_root()

    if args.add is not None:
        return _todo_add(root, args)

    try:
        issues = bd_list(root, include_all=args.all)
    except RuntimeError as e:
        print(f"error: bd list failed: {e}", file=sys.stderr)
        return 1

    if args.json:
        import json
        print(json.dumps(issues))
        return 0

    if not issues:
        print("no open todos" if not args.all else "no todos")
        return 0

    # interactive by default when the tooling supports it: fzf installed, and both
    # ends are real terminals (not piped/redirected -- a script consuming `kb todo`
    # output must keep getting the plain list). --plain forces the old behavior.
    interactive = not args.plain and shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()
    if interactive:
        return _todo_interactive(root, issues)

    for i in issues:
        status = f" [{i['status']}]" if args.all and i["status"] != "open" else ""
        print(f"{i['id']:<10} P{i['priority']}  {i['title']}{status}")

    example = issues[0]["id"]
    hint = f"\nact on one: kb bd show {example}  |  kb bd close {example}  |  kb bd comment {example} \"...\""
    if not shutil.which("fzf"):
        hint += "  (install fzf for an interactive picker)"
    print(hint)
    return 0


def _todo_add(root, args):
    """Create a new TODO. With a title, this is a one-shot `bd create` -- fast to
    fire off, but still takes --description/--priority/--type/--labels so it can
    carry as much ticket-shaped detail as you want in one line. With no title
    (`kb todo -a`), hand off to bd's own interactive form instead of reinventing
    it -- that already prompts for every field a ticket needs."""
    if not args.add:
        os.execvp("bd", ["bd", "-C", root, "create-form"])  # replaces this process

    try:
        output = bd_create(root, args.add, description=args.description,
                            priority=args.priority, issue_type=args.type, labels=args.labels)
    except RuntimeError as e:
        print(f"error: bd create failed: {e}", file=sys.stderr)
        return 1
    print(output)
    return 0


def _todo_interactive(root, issues):
    """fzf-based picker: select an item (with a live `bd show` preview), then an
    action. Falls back to nothing fancy for the action step -- another small fzf
    menu, since that's the same tool the user just used to pick the item."""
    lines, by_id = [], {}
    for i in issues:
        status = f" [{i['status']}]" if i["status"] != "open" else ""
        lines.append(f"{i['id']}\tP{i['priority']}\t{i['title']}{status}")
        by_id[i["id"]] = i

    preview_cmd = f"bd -C {shlex.quote(root)} show {{1}}"
    selected = _fzf_select(lines, "todo> ", "enter: choose an action for this item",
                            delimiter="\t", with_nth="1,2,3", preview_cmd=preview_cmd)
    if selected is None:
        return 0  # cancelled (esc / ctrl-c)
    chosen_id = selected.split("\t", 1)[0].strip()
    chosen = by_id.get(chosen_id)

    is_closed = chosen and chosen["status"] != "open"
    actions = ["show", "reopen", "comment", "delete", "cancel"] if is_closed else \
        ["show", "close", "comment", "delete", "cancel"]
    choice = _fzf_select(actions, f"{chosen_id}> ",
                          f"{chosen['title'] if chosen else chosen_id} -- choose an action")
    if choice is None:
        return 0

    if choice == "show":
        subprocess.run(["bd", "-C", root, "show", chosen_id])
    elif choice == "close":
        subprocess.run(["bd", "-C", root, "close", chosen_id])
    elif choice == "reopen":
        subprocess.run(["bd", "-C", root, "reopen", chosen_id])
    elif choice == "comment":
        text = input(f"comment on {chosen_id}: ").strip()
        if text:
            subprocess.run(["bd", "-C", root, "comment", chosen_id, text])
    elif choice == "delete":
        confirm = input(f"type '{chosen_id}' to confirm delete: ").strip()
        if confirm == chosen_id:
            subprocess.run(["bd", "-C", root, "delete", chosen_id, "--force"])
        else:
            print("confirmation didn't match -- delete aborted", file=sys.stderr)
    return 0


def cmd_bd(args):
    """Passthrough to `bd`, pointed at the resolved data repo root via -C -- so
    every other bd action (show/close/comment/create/update/...) works from
    anywhere the same way `kb todo` does, without hand-wrapping each one."""
    if not shutil.which("bd"):
        print("bd CLI not found -- install it (`brew install beads`).", file=sys.stderr)
        return 1
    root = pc.get_repo_root()
    result = subprocess.run(["bd", "-C", root, *args.bd_args])
    return result.returncode


def cmd_secrets(args):
    """Open the resolved data repo's encrypted secrets file in sops, creating it
    (per .sops.yaml) on first run. Hands off to sops entirely via exec -- it needs
    real interactive control to spawn $EDITOR, same reasoning as `kb journal`'s
    EDITOR handoff. The real secret values never pass through kb or this process:
    sops decrypts straight into the editor and re-encrypts straight from it."""
    if not shutil.which("sops"):
        print("sops CLI not found -- install it to manage encrypted credentials "
              "(e.g. `brew install sops`), or export PKB_MEMOS_URL/PKB_MEMOS_TOKEN/"
              "PKB_GITLAB_PROJECT directly instead.", file=sys.stderr)
        return 1
    root = pc.get_repo_root()
    sops_config = os.path.join(root, ".sops.yaml")
    if not os.path.exists(sops_config):
        print(f"error: no .sops.yaml in {root} -- this data repo isn't set up for sops-encrypted "
              f"secrets yet. See pkb-cli's templates/secrets.env.example and README.", file=sys.stderr)
        return 1
    secrets_path = os.path.join(root, ".pkb", "secrets.enc.env")
    # sops discovers .sops.yaml relative to cwd, not the target file's path -- pass
    # it explicitly so this works regardless of where kb secrets was actually run
    # from (the whole point of resolving `root` in the first place). Re-editing an
    # existing file also needs the *private* key (sops_key_env), not just the
    # public recipient in .sops.yaml -- only first-time creation gets away without it.
    env = sops_key_env()
    if "EDITOR" not in env:
        editor = pc.get_editor()
        if editor:
            env["EDITOR"] = editor
    os.execvpe("sops", ["sops", "--config", sops_config, secrets_path], env)


def cmd_config(args):
    if args.value is None:
        env_editor = os.environ.get("EDITOR")
        if env_editor:
            print(f"editor: {env_editor}  (from $EDITOR)")
        else:
            saved = pc.load_kb_config().get("editor")
            print(f"editor: {saved}  (saved in {pc.kb_config_path()})" if saved else "editor: not set")
        return 0

    if pc.split_editor(args.value) is None:
        print(f"error: '{args.value}' doesn't look like a usable editor command "
              f"(empty, or can't be parsed -- check quoting)", file=sys.stderr)
        return 1

    cfg = pc.load_kb_config()
    cfg["editor"] = args.value
    pc.save_kb_config(cfg)
    print(f"saved -- kb will use '{args.value}' whenever $EDITOR isn't set")
    pc.warn_if_editor_missing(args.value)
    return 0


def _confirm(prompt, default, assume_yes=False):
    """Yes/no prompt for `kb setup`'s guided flow. Auto-accepts `default`
    without asking when `assume_yes` (--yes) is set, or when stdin isn't a
    tty (e.g. install.sh's `curl | bash`, where there's no terminal to read
    from) -- so scripted/non-interactive invocations still get a sane,
    fully-automated setup instead of hanging on input()."""
    if assume_yes or not sys.stdin.isatty():
        return default
    suffix = "Y/n" if default else "y/N"
    try:
        resp = input(f"{prompt} [{suffix}] ").strip().lower()
    except EOFError:
        return default
    if not resp:
        return default
    return resp.startswith("y")


def find_install_dir():
    """Return (dir, already_on_path). Prefers a candidate already on PATH; falls
    back to ~/.local/bin (created if needed) so --install always succeeds on a
    completely fresh machine, just with a note to update PATH."""
    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    candidates = (os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin")
    for candidate in candidates:
        if os.path.isdir(candidate) and candidate in path_dirs:
            return candidate, True
    return os.path.expanduser("~/.local/bin"), False


# --- shared status checks, used by both `kb setup` (which acts on them) and
# `kb doctor` (which only reports) -- one place to know how to detect each
# piece of state so the two commands can't drift apart on what "ok" means.

HOOK_MARKER = "# pkb-managed-hook"


def hook_expected_content():
    validate_path = os.path.join(SCRIPT_DIR, "validate_frontmatter.py")
    content = (
        "#!/bin/sh\n"
        f"{HOOK_MARKER} -- regenerated by `kb setup`, do not hand-edit\n"
        f'exec "{sys.executable}" "{validate_path}"\n'
    )
    return content, validate_path


def read_hook(root):
    hook_path = os.path.join(root, ".git", "hooks", "pre-commit")
    if os.path.exists(hook_path):
        with open(hook_path, "r", encoding="utf-8") as f:
            return hook_path, f.read()
    return hook_path, None


def hook_managed_validate_path(content):
    """Extract the validate_frontmatter.py path baked into a kb-managed hook's
    `exec "<python>" "<path>"` line, or None if content isn't ours."""
    if not content or HOOK_MARKER not in content:
        return None
    parts = content.split('"')
    return parts[3] if len(parts) > 3 else None


# brew formula names for the always-checked tools that aren't declared by a
# sync source's SOURCE_META (those declare their own "brew_formula").
BUILTIN_BREW_FORMULAS = {"sops": "sops", "rg": "ripgrep", "fzf": "fzf"}


def missing_deps_with_formulas(tools, sync_sources):
    """(tool, brew_formula) pairs for every optional CLI tool kb knows how to
    install that isn't currently on PATH -- the always-checked tools plus any
    sync source that declares both cli_tool and brew_formula."""
    missing = [(t, f) for t, f in BUILTIN_BREW_FORMULAS.items() if not tools.get(t)]
    for _name, (_fname, meta) in sync_sources.items():
        cli_tool, formula = meta.get("cli_tool"), meta.get("brew_formula")
        if cli_tool and formula and not tools.get(cli_tool):
            missing.append((cli_tool, formula))
    return missing


def tool_status(sync_sources=None):
    """Presence (and, where SOURCE_META declares an auth_check, auth status) of
    every CLI tool kb cares about: the always-checked ones (sops for encrypted
    credentials, rg/fzf for Tier 1 search) plus whatever cli_tool each
    auto-discovered sync source declares -- so a new sync_<name>.py with a
    cli_tool/auth_check in its SOURCE_META gets a "<tool>"/"<tool>_auth" entry
    here automatically, no edit needed. Callers that already discovered sync
    sources for their own use (e.g. `kb setup`) can pass them in to avoid
    re-scanning/re-importing every sync_<name>.py a second time."""
    if sync_sources is None:
        sync_sources = discover_sync_sources()
    cli_tools = set(BUILTIN_BREW_FORMULAS)
    for _name, (_fname, meta) in sync_sources.items():
        if meta.get("cli_tool"):
            cli_tools.add(meta["cli_tool"])
    status = {t: shutil.which(t) is not None for t in cli_tools}
    for _name, (_fname, meta) in sync_sources.items():
        cli_tool, auth_check = meta.get("cli_tool"), meta.get("auth_check")
        if cli_tool and auth_check:
            status[f"{cli_tool}_auth"] = (
                subprocess.run(auth_check, capture_output=True).returncode == 0
                if status[cli_tool] else False
            )
    return status


def index_status(root):
    return os.path.join(root, ".pkb", "fts.db")


def bd_store_status(root):
    store_exists = os.path.isdir(os.path.join(root, ".beads"))
    exclude_path = os.path.join(root, ".git", "info", "exclude")
    git_excluded = False
    if os.path.exists(exclude_path):
        with open(exclude_path, "r", encoding="utf-8") as f:
            git_excluded = ".beads/" in f.read()
    return store_exists, git_excluded


def secrets_status(root):
    sops_configured = os.path.exists(os.path.join(root, ".sops.yaml"))
    secrets_exists = os.path.exists(os.path.join(root, ".pkb", "secrets.enc.env"))
    return sops_configured, secrets_exists


def sops_key_env():
    """Env dict for invoking sops (decrypt operations specifically -- this is about
    the *private* key, unrelated to .sops.yaml's public recipients used for
    encryption). sops's own built-in default age key location on macOS is under
    ~/Library/Application Support, not the more common ~/.config/sops/age/keys.txt
    -- if that's where the key actually lives and SOPS_AGE_KEY_FILE isn't already
    set, point sops at it explicitly rather than relying on its own discovery."""
    env = dict(os.environ)
    if "SOPS_AGE_KEY_FILE" not in env:
        candidate = os.path.expanduser("~/.config/sops/age/keys.txt")
        if os.path.isfile(candidate):
            env["SOPS_AGE_KEY_FILE"] = candidate
    return env


def _git(*args, cwd=TOOL_ROOT):
    return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)


def _github_request(url):
    req = urllib.request.Request(url, headers={"User-Agent": "pkb-cli"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return resp.read()


def _fetch_remote_sha(slug=TOOL_REPO_SLUG, branch=TOOL_BRANCH):
    """Latest commit sha on `branch`, via the GitHub API (no auth, public repo)."""
    data = json.loads(_github_request(f"https://api.github.com/repos/{slug}/commits/{branch}"))
    return data["sha"]


def _read_local_version():
    """Returns the marker's stripped content, "" if it exists but is empty/corrupt
    (distinct from None so callers can tell "never installed via tarball" apart
    from "installed, but the marker got truncated"), or None if it doesn't exist."""
    if not os.path.exists(VERSION_FILE):
        return None
    with open(VERSION_FILE, encoding="utf-8") as f:
        return f.read().strip()


def _write_local_version(sha):
    with open(VERSION_FILE, "w", encoding="utf-8") as f:
        f.write(sha + "\n")


def _write_file_atomic(path, fileobj, mode=None):
    """Write fileobj's contents to path via a same-directory temp file + os.replace,
    so a reader never observes a partially-written file and a process killed
    mid-write leaves the original untouched -- important here because an update
    can be overwriting kb's own currently-running entry point."""
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(dir=directory, prefix=os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "wb") as f:
            shutil.copyfileobj(fileobj, f)
        if mode is not None:
            os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    except BaseException:
        os.unlink(tmp_path)
        raise


def _apply_tarball_update(sha, slug=TOOL_REPO_SLUG):
    """Download the archive for `sha` and overwrite TOOL_ROOT's files with it in
    place (no directory swap -- this process is running out of TOOL_ROOT, so
    replacing file contents is safer than deleting/recreating the directory).
    Each file is written atomically (see _write_file_atomic) since one of them
    is scripts/kb itself. Files removed upstream are left behind rather than
    deleted; harmless clutter, simpler and safer than trying to reconcile a
    delete list mid-update."""
    data = _github_request(f"https://github.com/{slug}/archive/{sha}.tar.gz")
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
        members = tar.getmembers()
        top = members[0].name.split("/")[0] + "/"
        for member in members:
            if not member.name.startswith(top):
                continue
            rel = member.name[len(top):]
            if not rel:
                continue
            dest_path = os.path.join(TOOL_ROOT, rel)
            if member.isdir():
                os.makedirs(dest_path, exist_ok=True)
            elif member.isfile():
                mode = (member.mode & 0o777) if (member.mode & 0o111) else None
                _write_file_atomic(dest_path, tar.extractfile(member), mode=mode)


def tarball_status(fetch=False):
    """Version check for a non-git (tarball) pkb-cli install -- the counterpart to
    update_status() for git checkouts. fetch=False (used by `kb doctor`) only reads
    the local .pkb-cli-version marker, no network; fetch=True (used by `kb update`)
    also queries GitHub for the latest commit on TOOL_BRANCH."""
    result = {"installed": os.path.exists(VERSION_FILE), "local": _read_local_version(), "remote": None}
    if fetch and result["local"] is not None:
        result["remote"] = _fetch_remote_sha()
    return result


def update_status(fetch=False):
    """Compare this pkb-cli checkout's HEAD against its upstream.

    fetch=False (used by `kb doctor`) never touches the network -- it only compares
    against whatever origin/<branch> was last fetched, so it can go stale, but stays
    within doctor's "never writes, never hits the network" contract. fetch=True (used
    by `kb update`) refreshes that ref first, so its answer is authoritative.

    Returns a dict: is_git, upstream, local, remote, behind, dirty. Fields are None
    when they don't apply (e.g. not a git checkout, or no upstream configured).
    """
    result = {"is_git": os.path.isdir(os.path.join(TOOL_ROOT, ".git")),
              "upstream": None, "local": None, "remote": None, "behind": None, "dirty": None}
    if not result["is_git"]:
        return result

    if fetch:
        _git("fetch", "--quiet", "origin")

    upstream = _git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream.returncode != 0:
        return result
    result["upstream"] = upstream.stdout.strip()

    result["local"] = _git("rev-parse", "HEAD").stdout.strip()
    result["remote"] = _git("rev-parse", result["upstream"]).stdout.strip()
    if result["local"] and result["remote"]:
        behind = _git("rev-list", "--count", f"{result['local']}..{result['remote']}")
        result["behind"] = int(behind.stdout.strip()) if behind.returncode == 0 else None
    result["dirty"] = bool(_git("status", "--porcelain").stdout.strip())
    return result


def push_status(root):
    """Local-only (no fetch) ahead/behind of a data repo's upstream -- the
    counterpart to update_status() but for the *data* repo's own remote, not
    pkb-cli's tool repo. Never touches the network, so this can go stale
    relative to what's actually on the remote, but stays within `kb doctor`'s
    "never writes, never hits the network" contract; `kb push` itself always
    attempts the real push regardless of what this reports.

    Returns a dict: is_git, upstream, ahead, behind. upstream/ahead/behind are
    None when they don't apply (not a git repo, or no upstream configured)."""
    result = {"is_git": os.path.isdir(os.path.join(root, ".git")),
              "upstream": None, "ahead": None, "behind": None}
    if not result["is_git"]:
        return result
    upstream = _git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}", cwd=root)
    if upstream.returncode != 0:
        return result
    result["upstream"] = upstream.stdout.strip()
    ahead = _git("rev-list", "--count", f"{result['upstream']}..HEAD", cwd=root)
    behind = _git("rev-list", "--count", f"HEAD..{result['upstream']}", cwd=root)
    result["ahead"] = int(ahead.stdout.strip()) if ahead.returncode == 0 else None
    result["behind"] = int(behind.stdout.strip()) if behind.returncode == 0 else None
    return result


def cmd_push(args):
    root = pc.get_repo_root()
    status = push_status(root)
    if not status["is_git"]:
        print("error: not a git repo", file=sys.stderr)
        return 1
    if not status["upstream"]:
        print("error: no upstream configured -- `git push -u <remote> <branch>` once to set one",
              file=sys.stderr)
        return 1
    if status["behind"]:
        print(f"note: {status['behind']} commit(s) behind {status['upstream']} as of the last fetch -- "
              f"push may be rejected; `git pull` first if so")
    if not status["ahead"]:
        print(f"up to date with {status['upstream']}")
        return 0
    print(f"pushing {status['ahead']} commit(s) to {status['upstream']}...")
    ok, message = pc.git_push(root)
    if not ok:
        print(f"error: {message}", file=sys.stderr)
        return 1
    print(f"pushed -> {message}")
    return 0


def cmd_setup(args):
    # root is optional: --install (and the tool/sync checks below) don't need a data
    # repo at all -- only the hook/index/bd/secrets steps do.
    ok, todo = [], []
    try:
        root = pc.get_repo_root()
    except SystemExit:
        # No data repo found anywhere (walking up from cwd) and no central kb at
        # ~/.pkb either -- this is a brand-new machine. Bootstrap the central kb
        # here instead of requiring a manual `mkdir -p ~/.pkb/.pkb && git init`
        # before setup can do anything, since that step was easy to miss (e.g.
        # when install.sh runs `kb setup --install` non-interactively).
        central = os.path.join(os.path.expanduser("~"), ".pkb")
        os.makedirs(os.path.join(central, ".pkb"), exist_ok=True)
        if shutil.which("git") and not os.path.isdir(os.path.join(central, ".git")):
            subprocess.run(["git", "init", "-q"], cwd=central, check=True)
        pc.REPO_ROOT = central
        root = central
        ok.append(f"created central kb at {central} (none found)")

    # 0. install kb itself onto PATH -- guided: asked interactively, or
    # auto-accepted (assume_yes) for scripted callers like install.sh, which
    # pipes through `curl | bash` and has no terminal to prompt against.
    script_path = os.path.abspath(os.path.join(SCRIPT_DIR, "kb"))
    install_dir, on_path = find_install_dir()
    target = os.path.join(install_dir, "kb")
    if os.path.islink(target) and os.readlink(target) == script_path:
        ok.append(f"kb already installed at {target}")
    elif os.path.lexists(target):
        todo.append(f"{target} already exists and isn't this repo's kb -- remove it yourself "
                     f"if you want kb symlinked there")
    elif _confirm(f"Install kb onto your PATH ({target})?", default=True, assume_yes=args.yes):
        os.makedirs(install_dir, exist_ok=True)
        os.symlink(script_path, target)
        if on_path:
            ok.append(f"installed kb -> {target}")
        else:
            ok.append(f"installed kb -> {target} (not yet on PATH)")
            todo.append(f'add this to your shell profile: export PATH="{install_dir}:$PATH"')
    else:
        todo.append("skipped installing kb onto PATH -- run `kb setup` again to add it later")

    # 0b. install the bundled Claude Code skill -- guided, default no (not
    # everyone using kb also uses Claude Code). A symlink, not a copy --
    # Claude Code follows a skill-directory symlink and reads SKILL.md from
    # the target, so this repo stays the single source of truth and a `kb
    # update` picks up any skill changes automatically, same reasoning as
    # symlinking the kb binary itself above.
    skill_src = os.path.abspath(os.path.join(TOOL_ROOT, "skills", "kb"))
    skill_dir = os.path.expanduser("~/.claude/skills")
    skill_target = os.path.join(skill_dir, "kb")
    if os.path.islink(skill_target) and os.readlink(skill_target) == skill_src:
        ok.append(f"kb skill already installed at {skill_target}")
    elif os.path.lexists(skill_target):
        todo.append(f"{skill_target} already exists and isn't this repo's skill -- remove it yourself "
                     f"if you want kb's version there")
    elif _confirm("Install the Claude Code skill for kb (lets Claude Code drive kb directly)?",
                   default=False, assume_yes=args.yes):
        os.makedirs(skill_dir, exist_ok=True)
        os.symlink(skill_src, skill_target)
        ok.append(f"installed kb skill -> {skill_target}")

    sync_sources = discover_sync_sources()
    tools = tool_status(sync_sources)

    # 0c. install missing optional CLI deps via brew -- guided, default yes
    # (this is the "including optional tooling" part of setup: bd/beads,
    # glab/gh for sync sources, rg/fzf for Tier 1 search, sops for secrets).
    to_install = missing_deps_with_formulas(tools, sync_sources)
    if not to_install:
        ok.append("all optional CLI deps (bd/glab/gh/rg/fzf/sops) already installed")
    elif not shutil.which("brew"):
        todo.append("brew not found -- install manually: " +
                    ", ".join(f"{t} (`{f}`)" for t, f in to_install))
    else:
        names = ", ".join(t for t, _f in to_install)
        if _confirm(f"Install missing optional CLI deps via brew ({names})?", default=True, assume_yes=args.yes):
            formulas = sorted({f for _t, f in to_install})
            result = subprocess.run(["brew", "install", *formulas], capture_output=True, text=True)
            if result.returncode == 0:
                ok.append(f"installed missing deps via brew: {', '.join(formulas)}")
                # just recheck presence of what we installed -- no need to re-discover
                # sync sources or re-run every auth_check subprocess again
                tools.update({t: shutil.which(t) is not None for t, _f in to_install})
            else:
                todo.append(f"brew install {' '.join(formulas)} failed: "
                            f"{result.stderr.strip() or result.stdout.strip()}")
        else:
            todo.append(f"skipped installing optional deps: {names} -- rerun `kb setup` "
                        f"or `brew install {' '.join(sorted({f for _t, f in to_install}))}` later")

    if root is None:
        todo.append("not inside a pkb data repo (no .pkb/ found) -- cd into one to also set up the "
                     "pre-commit hook, search index, and local bd store")
    else:
        # 1. pre-commit hook -- generated directly (not a symlinked template) since it
        # must hardcode this machine's path to the tool install, which lives in a
        # separate repo from the data repo the hook runs in.
        git_dir = os.path.join(root, ".git")
        if not os.path.isdir(git_dir):
            todo.append("not a git repo (or .git not found here) -- pre-commit hook skipped")
        else:
            hook_content, _validate_path = hook_expected_content()
            hook_path, existing = read_hook(root)
            if existing == hook_content:
                ok.append("pre-commit hook already installed")
            elif existing is not None and HOOK_MARKER not in existing:
                todo.append(f"{os.path.relpath(hook_path, root)} exists and isn't our hook -- leaving it alone")
            else:
                os.makedirs(os.path.dirname(hook_path), exist_ok=True)
                if os.path.lexists(hook_path):  # e.g. a stale/broken symlink from an older kb setup
                    os.remove(hook_path)
                with open(hook_path, "w", encoding="utf-8") as f:
                    f.write(hook_content)
                os.chmod(hook_path, 0o755)
                ok.append("installed pre-commit hook" if existing is None else "refreshed pre-commit hook path")

            # 1b. auto-commit excludes (fts.db, entry locks) -- every kb mutation
            # commits automatically, so these must be in place before that ever
            # runs, not just lazily on first write
            pc._ensure_git_excludes(root)
            ok.append("auto-commit excludes (fts.db, entry locks) are in place")

        # 2. FTS index
        db_path = index_status(root)
        full = not os.path.exists(db_path)
        rc = run_script("index_fts.py", ["--full"] if full else [])
        ok.append(f"{'built' if full else 'refreshed'} the FTS5 search index" if rc == 0 else "index build failed")

        # 3. local bd store
        if tools["bd"]:
            store_exists, _git_excluded = bd_store_status(root)
            if store_exists:
                ok.append("local bd (beads) store already initialized")
            else:
                result = subprocess.run(
                    ["bd", "init", "--stealth", "--non-interactive"],
                    cwd=root, capture_output=True, text=True,
                )
                if result.returncode == 0:
                    ok.append("initialized a local bd store (--stealth: excluded from git)")
                else:
                    todo.append(f"bd init failed: {result.stderr.strip() or result.stdout.strip()}")
        else:
            todo.append("bd CLI not found -- `brew install beads` if you want local TODO tracking via kb sync beads")

        # 4. secrets (sops), informational only -- never touch/create real secrets ourselves
        sops_configured, secrets_exists = secrets_status(root)
        if sops_configured:
            if secrets_exists:
                ok.append(".pkb/secrets.enc.env already set up")
            elif tools["sops"]:
                example_path = os.path.join(SCRIPT_DIR, "..", "templates", "secrets.env.example")
                todo.append("run `kb secrets` to create encrypted memos/gitlab/github credentials "
                            f"(see {os.path.normpath(example_path)} for the expected keys)")
            else:
                todo.append("sops CLI not found -- install it to use encrypted credentials, or export "
                            "PKB_MEMOS_URL/PKB_MEMOS_TOKEN/PKB_GITLAB_PROJECT/PKB_GITHUB_REPO directly")

    # 5. cli_tool sync sources (e.g. glab/gh, required for GitLab/GitHub issue sync)
    todo.extend(sync_tool_todos(sync_sources, tools))

    # 6. rg/fzf (Tier 1 search, optional -- kb search/index work without them)
    missing_search_tools = [t for t in ("rg", "fzf") if not tools[t]]
    if missing_search_tools:
        todo.append(f"{'/'.join(missing_search_tools)} not found -- optional, only needed for zero-setup "
                     f"search (`brew install ripgrep fzf`); kb search/index don't need them")

    # 7. what's actually configured for sync right now (informational)
    configured = sync_configured_sources(sync_sources, tools)
    if configured:
        ok.append(f"sync sources ready in this shell: {', '.join(configured)}")
    else:
        todo.append("no sync source has credentials in this shell yet (memos/gitlab/github need env vars, "
                     "see README 'Ingestion credentials')")

    print("kb setup\n")
    for line in ok:
        print(f"  [ok]   {line}")
    for line in todo:
        print(f"  [todo] {line}")
    return 1 if any("failed" in t for t in todo) else 0


def cmd_web(args):
    root = pc.get_repo_root()
    import kb_web
    return kb_web.serve(root, args.port, open_browser=not args.no_open)


# --- `kb service` / `kb sync-service` -- run `kb web` or `kb sync` as a
# login-scoped background job via launchd (macOS) or systemd --user (Linux).
# Both stay strictly per-user (no root, no system-wide daemon) and just wrap
# the same `kb web`/`kb sync` invocation a person would run by hand -- this
# only automates when it runs, nothing the underlying command doesn't already
# do. `kb service` keeps `kb web` alive continuously (RunAtLoad+KeepAlive /
# a plain systemd service); `kb sync-service` fires `kb sync` on a timer
# (StartInterval / a oneshot service driven by a systemd timer unit). Those
# two shapes differ enough (persistent vs interval-triggered) that both go
# through one shared installer, parameterized by everything else that's
# actually identical: label/unit naming, the launchctl/systemctl dance, PATH,
# and status/uninstall.

AGENTS = {
    "web": {
        "launchd_label": "dev.pkb-cli.web",
        "systemd_unit": "kb-web.service",
        "log_name": "kb-web",
    },
    "sync": {
        "launchd_label": "dev.pkb-cli.sync",
        "systemd_unit": "kb-sync.service",
        "systemd_timer": "kb-sync.timer",
        "log_name": "kb-sync",
    },
}


def _service_kind():
    if sys.platform == "darwin":
        return "launchd"
    if sys.platform.startswith("linux"):
        return "systemd"
    return None


def _agent_launchd_plist_path(agent):
    return os.path.expanduser(f"~/Library/LaunchAgents/{AGENTS[agent]['launchd_label']}.plist")


def _agent_systemd_unit_path(agent):
    return os.path.expanduser(f"~/.config/systemd/user/{AGENTS[agent]['systemd_unit']}")


def _agent_systemd_timer_path(agent):
    return os.path.expanduser(f"~/.config/systemd/user/{AGENTS[agent]['systemd_timer']}")


def _service_path_env():
    """PATH for a background `kb` job: os.defpath (the bare minimum
    launchd/systemd --user give a service) plus the standard Homebrew/local
    prefixes, so bd/glab/gh/rg/fzf resolve the same as they do under `kb
    setup`/`kb doctor`. Deterministic on purpose -- unlike snapshotting
    whoever ran `install`'s ambient PATH, this doesn't bake in transient
    shims (pyenv, an active venv) or go stale once install-time is behind us."""
    extra = ["/opt/homebrew/bin", "/opt/homebrew/sbin", "/usr/local/bin", "/usr/local/sbin"]
    return os.pathsep.join(extra + [os.defpath])


def _resolve_agent_repo(args):
    if args.repo:
        root = os.path.abspath(os.path.expanduser(args.repo))
        if not os.path.isdir(root):
            print(f"error: --repo {root} does not exist", file=sys.stderr)
            return None
        return root
    try:
        return pc.get_repo_root()
    except SystemExit:
        print("error: no pkb data repo found -- pass --repo DIR, or cd into one "
              "first (see `kb setup`)", file=sys.stderr)
        return None


def _launchd_load(label, plist_path):
    """(re)load a plist -- bootout first (ignore failure, fine if nothing was
    loaded yet) so a re-install picks up changes instead of bootstrap
    erroring "already loaded". Returns an error string, or None on success."""
    uid = os.getuid()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
    result = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", plist_path],
                             capture_output=True, text=True)
    if result.returncode != 0:
        return result.stderr.strip()
    return None


def _launchd_unload_and_remove(label, plist_path):
    uid = os.getuid()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
    if os.path.exists(plist_path):
        os.remove(plist_path)
        return True
    return False


def _launchd_status(label, plist_path):
    """(installed, running, detail) -- detail is a human string for the
    not-running/not-loaded cases."""
    if not os.path.exists(plist_path):
        return False, False, "not installed"
    uid = os.getuid()
    result = subprocess.run(["launchctl", "print", f"gui/{uid}/{label}"],
                             capture_output=True, text=True)
    if result.returncode != 0:
        return True, False, f"installed ({plist_path}) but not loaded -- run `install` again"
    return True, "state = running" in result.stdout, None


def _systemd_enable_now(unit_name):
    """daemon-reload then enable --now one unit. Returns an error string, or
    None on success."""
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    result = subprocess.run(["systemctl", "--user", "enable", "--now", unit_name],
                             capture_output=True, text=True)
    if result.returncode != 0:
        return result.stderr.strip()
    return None


def _systemd_disable_and_remove(unit_name, *paths):
    subprocess.run(["systemctl", "--user", "disable", "--now", unit_name], capture_output=True)
    removed = False
    for path in paths:
        if os.path.exists(path):
            os.remove(path)
            removed = True
    if removed:
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    return removed


def _systemd_active_state(unit_name):
    result = subprocess.run(["systemctl", "--user", "is-active", unit_name],
                             capture_output=True, text=True)
    return result.stdout.strip()


def _linger_note():
    """None, or a note to print when the current user isn't lingering --
    without it a systemd --user timer/service dies at logout."""
    user = os.environ.get("USER", "")
    result = subprocess.run(["loginctl", "show-user", user, "-p", "Linger"],
                             capture_output=True, text=True)
    if result.returncode == 0 and "Linger=no" in result.stdout:
        return (f"  note: enable lingering so this survives logout/reboot without an active "
                f"session: loginctl enable-linger {user}")
    return None


def cmd_service(args):
    kind = _service_kind()
    if kind is None:
        print(f"error: `kb service` isn't supported on {sys.platform} -- only macOS "
              f"(launchd) and Linux (systemd --user) are supported. See `kb web` to "
              f"run it by hand instead.", file=sys.stderr)
        return 1
    if args.action == "install":
        return _service_install(kind, args)
    if args.action == "uninstall":
        return _service_uninstall(kind, "web")
    return _service_status(kind, "web")


def _service_install(kind, args):
    root = _resolve_agent_repo(args)
    if root is None:
        return 1

    kb_path = os.path.abspath(os.path.join(SCRIPT_DIR, "kb"))
    port = args.port
    agent = AGENTS["web"]

    if kind == "launchd":
        import plistlib
        log_dir = os.path.expanduser("~/Library/Logs")
        os.makedirs(log_dir, exist_ok=True)
        plist_path = _agent_launchd_plist_path("web")
        os.makedirs(os.path.dirname(plist_path), exist_ok=True)
        plist = {
            "Label": agent["launchd_label"],
            "ProgramArguments": [sys.executable, kb_path, "web", "--port", str(port), "--no-open"],
            "WorkingDirectory": root,
            "RunAtLoad": True,
            "KeepAlive": True,
            "StandardOutPath": os.path.join(log_dir, f"{agent['log_name']}.log"),
            "StandardErrorPath": os.path.join(log_dir, f"{agent['log_name']}.err.log"),
            # launchd defaults to /usr/bin:/bin:/usr/sbin:/sbin (no Homebrew) --
            # without this, bd/glab/gh/rg/fzf all read as "not found" under the
            # service even though `kb setup`/`kb doctor` find them fine in a shell.
            "EnvironmentVariables": {"PATH": _service_path_env()},
        }
        with open(plist_path, "wb") as f:
            plistlib.dump(plist, f)

        error = _launchd_load(agent["launchd_label"], plist_path)
        if error:
            print(f"error: launchctl bootstrap failed: {error}", file=sys.stderr)
            return 1
        print(f"installed and started {agent['launchd_label']} -> http://127.0.0.1:{port}/")
        print(f"  repo:  {root}")
        print(f"  plist: {plist_path}")
        print(f"  logs:  {log_dir}/{agent['log_name']}.log")
        return 0

    # systemd --user
    unit_path = _agent_systemd_unit_path("web")
    os.makedirs(os.path.dirname(unit_path), exist_ok=True)
    unit = (
        "[Unit]\n"
        "Description=kb web -- pkb-cli local web UI\n"
        "\n"
        "[Service]\n"
        f'ExecStart="{sys.executable}" "{kb_path}" web --port {port} --no-open\n'
        f"WorkingDirectory={root}\n"
        # systemd --user services get a minimal PATH by default too -- see
        # _service_path_env() for why this is a fixed Homebrew-aware PATH
        # rather than a snapshot of the installer's shell PATH.
        f'Environment="PATH={_service_path_env()}"\n'
        "Restart=on-failure\n"
        "\n"
        "[Install]\n"
        "WantedBy=default.target\n"
    )
    with open(unit_path, "w", encoding="utf-8") as f:
        f.write(unit)
    error = _systemd_enable_now(agent["systemd_unit"])
    if error:
        print(f"error: systemctl enable --now failed: {error}", file=sys.stderr)
        return 1
    print(f"installed and started {agent['systemd_unit']} -> http://127.0.0.1:{port}/")
    print(f"  repo: {root}")
    print(f"  unit: {unit_path}")
    print(f"  logs: journalctl --user -u {agent['systemd_unit']} -f")
    note = _linger_note()
    if note:
        print(note)
    return 0


def _service_uninstall(kind, agent_name):
    agent = AGENTS[agent_name]
    if kind == "launchd":
        plist_path = _agent_launchd_plist_path(agent_name)
        if _launchd_unload_and_remove(agent["launchd_label"], plist_path):
            print(f"stopped and removed {agent['launchd_label']} ({plist_path})")
        else:
            print(f"{agent['launchd_label']} wasn't installed")
        return 0

    unit_path = _agent_systemd_unit_path(agent_name)
    if _systemd_disable_and_remove(agent["systemd_unit"], unit_path):
        print(f"stopped and removed {agent['systemd_unit']} ({unit_path})")
    else:
        print(f"{agent['systemd_unit']} wasn't installed")
    return 0


def _service_status(kind, agent_name):
    agent = AGENTS[agent_name]
    if kind == "launchd":
        plist_path = _agent_launchd_plist_path(agent_name)
        installed, running, detail = _launchd_status(agent["launchd_label"], plist_path)
        if not installed:
            print(detail)
            return 1
        if detail:
            print(detail)
            return 1
        print(f"installed and {'running' if running else 'loaded but not running'} ({plist_path})")
        return 0 if running else 1

    unit_path = _agent_systemd_unit_path(agent_name)
    if not os.path.exists(unit_path):
        print("not installed")
        return 1
    state = _systemd_active_state(agent["systemd_unit"])
    print(f"installed ({unit_path}), {state}")
    return 0 if state == "active" else 1


# --- `kb sync-service` -- runs `kb sync` on a recurring interval via launchd
# (macOS, StartInterval) or a systemd --user timer (Linux), instead of
# `kb service`'s persistent process. Shares everything above but the plist/
# unit shape and status/uninstall need the extra timer unit on systemd.


def cmd_sync_service(args):
    kind = _service_kind()
    if kind is None:
        print(f"error: `kb sync-service` isn't supported on {sys.platform} -- only macOS "
              f"(launchd) and Linux (systemd --user) are supported. See `kb sync` to "
              f"run it by hand instead.", file=sys.stderr)
        return 1
    if args.action == "install":
        return _sync_service_install(kind, args)
    if args.action == "uninstall":
        return _sync_service_uninstall(kind)
    return _sync_service_status(kind)


def _sync_service_install(kind, args):
    root = _resolve_agent_repo(args)
    if root is None:
        return 1

    kb_path = os.path.abspath(os.path.join(SCRIPT_DIR, "kb"))
    agent = AGENTS["sync"]

    if kind == "launchd":
        import plistlib
        log_dir = os.path.expanduser("~/Library/Logs")
        os.makedirs(log_dir, exist_ok=True)
        plist_path = _agent_launchd_plist_path("sync")
        os.makedirs(os.path.dirname(plist_path), exist_ok=True)
        plist = {
            "Label": agent["launchd_label"],
            "ProgramArguments": [sys.executable, kb_path, "sync"],
            "WorkingDirectory": root,
            "StartInterval": args.interval_minutes * 60,
            "StandardOutPath": os.path.join(log_dir, f"{agent['log_name']}.log"),
            "StandardErrorPath": os.path.join(log_dir, f"{agent['log_name']}.err.log"),
            # see _service_path_env() -- launchd's default PATH has no Homebrew
            "EnvironmentVariables": {"PATH": _service_path_env()},
        }
        with open(plist_path, "wb") as f:
            plistlib.dump(plist, f)

        error = _launchd_load(agent["launchd_label"], plist_path)
        if error:
            print(f"error: launchctl bootstrap failed: {error}", file=sys.stderr)
            return 1
        print(f"installed and started {agent['launchd_label']} -> `kb sync` every {args.interval_minutes}m")
        print(f"  repo:  {root}")
        print(f"  plist: {plist_path}")
        print(f"  logs:  {log_dir}/{agent['log_name']}.log")
        return 0

    # systemd --user: a oneshot service triggered by a timer
    service_path = _agent_systemd_unit_path("sync")
    timer_path = _agent_systemd_timer_path("sync")
    os.makedirs(os.path.dirname(service_path), exist_ok=True)
    service_unit = (
        "[Unit]\n"
        "Description=kb sync -- pull in pkb-cli sync sources\n"
        "\n"
        "[Service]\n"
        "Type=oneshot\n"
        f'ExecStart="{sys.executable}" "{kb_path}" sync\n'
        f"WorkingDirectory={root}\n"
        f'Environment="PATH={_service_path_env()}"\n'
    )
    with open(service_path, "w", encoding="utf-8") as f:
        f.write(service_unit)
    timer_unit = (
        "[Unit]\n"
        "Description=run kb-sync.service on an interval\n"
        "\n"
        "[Timer]\n"
        f"OnBootSec={args.interval_minutes}min\n"
        f"OnUnitActiveSec={args.interval_minutes}min\n"
        "Persistent=true\n"
        "\n"
        "[Install]\n"
        "WantedBy=timers.target\n"
    )
    with open(timer_path, "w", encoding="utf-8") as f:
        f.write(timer_unit)
    error = _systemd_enable_now(agent["systemd_timer"])
    if error:
        print(f"error: systemctl enable --now failed: {error}", file=sys.stderr)
        return 1
    print(f"installed and started {agent['systemd_timer']} -> `kb sync` every {args.interval_minutes}m")
    print(f"  repo:    {root}")
    print(f"  service: {service_path}")
    print(f"  timer:   {timer_path}")
    print(f"  logs:    journalctl --user -u {agent['systemd_unit']} -f")
    note = _linger_note()
    if note:
        print(note)
    return 0


def _sync_service_uninstall(kind):
    agent = AGENTS["sync"]
    if kind == "launchd":
        plist_path = _agent_launchd_plist_path("sync")
        if _launchd_unload_and_remove(agent["launchd_label"], plist_path):
            print(f"stopped and removed {agent['launchd_label']} ({plist_path})")
        else:
            print(f"{agent['launchd_label']} wasn't installed")
        return 0

    service_path = _agent_systemd_unit_path("sync")
    timer_path = _agent_systemd_timer_path("sync")
    if _systemd_disable_and_remove(agent["systemd_timer"], timer_path, service_path):
        print(f"stopped and removed {agent['systemd_timer']} ({timer_path})")
    else:
        print(f"{agent['systemd_timer']} wasn't installed")
    return 0


def _sync_service_status(kind):
    agent = AGENTS["sync"]
    if kind == "launchd":
        plist_path = _agent_launchd_plist_path("sync")
        installed, _running, detail = _launchd_status(agent["launchd_label"], plist_path)
        if not installed:
            print(detail)
            return 1
        if detail:
            print(detail.replace("`install`", "`kb sync-service install`"))
            return 1
        print(f"installed and scheduled ({plist_path})")
        return 0

    timer_path = _agent_systemd_timer_path("sync")
    if not os.path.exists(timer_path):
        print("not installed")
        return 1
    state = _systemd_active_state(agent["systemd_timer"])
    print(f"installed ({timer_path}), timer {state}")
    return 0 if state == "active" else 1


def doctor_checks(root, push=None):
    """(ok, todo) lists of human-readable status lines -- the actual health
    check logic behind `kb doctor`, factored out so `kb web`'s Admin panel can
    show (and poll) the exact same read-only checks as data instead of parsing
    printed output. Never writes anything. root may be None (tool-level checks
    -- glab/rg/fzf, pkb-cli's own update status -- don't need a data repo;
    only frontmatter/hook/index/bd/secrets/cursors do).

    `push` lets a caller that already computed push_status(root) (kb web's
    /api/admin/status also reports it separately) pass it in instead of this
    function running its own -- push_status shells out to git twice
    (rev-list ahead + behind), not worth doing twice per request."""
    ok, todo = [], []

    if root is None:
        todo.append("not inside a pkb data repo (no .pkb/ found) -- cd into one to check "
                     "frontmatter, the pre-commit hook, the search index, and cursors.json")
    else:
        # frontmatter integrity (reuses validate_frontmatter.py itself)
        result = subprocess.run(
            [sys.executable, os.path.join(SCRIPT_DIR, "validate_frontmatter.py")],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            ok.append("frontmatter validates cleanly")
        else:
            todo.append("frontmatter validation is failing -- run `kb validate` for details")

        # pre-commit hook: installed, ours, matches what we'd generate now, and points
        # at a file that still exists (setup doesn't check that last part)
        hook_content, _validate_path = hook_expected_content()
        hook_path, existing = read_hook(root)
        if existing is None:
            todo.append("no pre-commit hook installed -- run `kb setup`")
        elif HOOK_MARKER not in existing:
            todo.append(f"{os.path.relpath(hook_path, root)} exists but isn't kb-managed")
        else:
            hooked_path = hook_managed_validate_path(existing)
            if hooked_path and not os.path.exists(hooked_path):
                todo.append(f"pre-commit hook points at a missing file ({hooked_path}) -- "
                            f"the pkb-cli checkout that wrote it may have moved; run `kb setup`")
            elif existing != hook_content:
                todo.append("pre-commit hook is stale (points at a different pkb-cli install/interpreter "
                            "than this one) -- run `kb setup`")
            else:
                ok.append("pre-commit hook is current")

        # FTS index: present, and its row count matches the number of files on disk
        # (a mismatch means something changed without a reindex)
        db_path = index_status(root)
        if not os.path.exists(db_path):
            todo.append("no search index -- run `kb index --full`")
        else:
            import sqlite3
            file_count = sum(1 for _ in pc.iter_markdown_files(root))
            conn = sqlite3.connect(db_path)
            try:
                indexed_count = conn.execute("SELECT COUNT(*) FROM files").fetchone()[0]
            except sqlite3.OperationalError:
                indexed_count = None
            conn.close()
            if indexed_count is None:
                todo.append(f"{os.path.relpath(db_path, root)} exists but doesn't look like a kb index -- "
                            f"run `kb index --full`")
            elif indexed_count != file_count:
                todo.append(f"search index is stale ({indexed_count} indexed vs {file_count} files on disk) "
                            f"-- run `kb index`")
            else:
                ok.append(f"search index is current ({indexed_count} files)")

        # promoted entries whose source (e.g. an edited usememos memo) has been
        # re-synced since promotion -- promotion is a one-time copy, so nothing
        # else notices the source moving on without this
        stale_promoted = pc.stale_promoted_entries(root)
        if stale_promoted:
            for promoted_path, mirror_path in stale_promoted:
                todo.append(
                    f"{os.path.relpath(promoted_path, root)} is stale -- its source "
                    f"{os.path.relpath(mirror_path, root)} was updated since promotion; review and reconcile"
                )
        else:
            ok.append("no promoted entries are stale relative to their source")

        # auto-commit: every kb mutation commits automatically, but only when root
        # is a git repo -- and the derived files it must never stage need to
        # actually be excluded, or every commit picks up index/lock churn
        if not os.path.isdir(os.path.join(root, ".git")):
            todo.append("not a git repo -- kb won't auto-commit changes; `git init` this data repo "
                        "to get commit-per-action history")
        else:
            exclude_path = os.path.join(root, ".git", "info", "exclude")
            excluded_text = ""
            if os.path.exists(exclude_path):
                with open(exclude_path, "r", encoding="utf-8") as f:
                    excluded_text = f.read()
            missing = [p for p in pc.AUTOCOMMIT_EXCLUDES if p not in excluded_text]
            if missing:
                todo.append(f"auto-commit excludes missing ({', '.join(missing)}) -- run `kb setup` "
                            f"(fixed automatically on the next mutation regardless)")
            else:
                ok.append("auto-commit excludes (fts.db, entry locks) are in place")

            # every kb mutation auto-commits, so anything left uncommitted means
            # that failed -- most likely the pre-commit hook rejected invalid
            # frontmatter, or something outside kb touched the repo directly
            status = subprocess.run(["git", "-C", root, "status", "--porcelain"],
                                     capture_output=True, text=True)
            dirty = status.returncode == 0 and status.stdout.strip()
            if dirty:
                n = len(status.stdout.strip().splitlines())
                todo.append(f"{n} uncommitted change(s) in the data repo -- auto-commit should have caught "
                            f"this; run `git -C {root} status` (a failing pre-commit hook is the likely cause)")
            elif status.returncode == 0:
                ok.append("data repo is clean (auto-commit is keeping up)")

            # push: local commits waiting on the remote -- informational (offline
            # work is normal), but auto-commit's durability guarantee only holds
            # up to "this machine" until these are actually pushed. Only reported
            # when an upstream is actually configured -- a local-only data repo
            # (no remote at all) is a legitimate setup, not something to flag.
            push = push if push is not None else push_status(root)
            if push["upstream"]:
                if push["ahead"]:
                    todo.append(f"{push['ahead']} commit(s) ahead of {push['upstream']}, not yet pushed "
                                f"-- run `kb push`")
                else:
                    ok.append(f"up to date with {push['upstream']}")

    # local bd store: present and actually git-excluded
    tools = tool_status()
    if root is not None:
        if tools["bd"]:
            store_exists, git_excluded = bd_store_status(root)
            if not store_exists:
                todo.append("no local bd store -- run `kb setup`")
            elif not git_excluded:
                todo.append(".beads/ exists but isn't in .git/info/exclude -- it may get committed accidentally")
            else:
                ok.append("local bd store is present and git-excluded")
        else:
            todo.append("bd CLI not found -- `brew install beads` if you want local TODO tracking")

        # secrets
        sops_configured, secrets_exists = secrets_status(root)
        if sops_configured and not secrets_exists:
            todo.append("no .pkb/secrets.enc.env yet -- run `kb secrets` if you sync memos/gitlab/github")
        elif sops_configured:
            ok.append(".pkb/secrets.enc.env is present")

    # cli_tool sync sources / rg / fzf -- not data-repo-specific, always checked
    todo.extend(sync_tool_todos(discover_sync_sources(), tools))
    missing_search_tools = [t for t in ("rg", "fzf") if not tools[t]]
    if missing_search_tools:
        todo.append(f"{'/'.join(missing_search_tools)} not found (optional, Tier 1 search)")

    # cursors.json sanity
    if root is not None:
        cursors = pc.load_cursors(root)
        now = datetime.now().astimezone()
        for source, fields in cursors.items():
            for key, value in (fields or {}).items():
                if value is None:
                    continue
                dt = pc.parse_iso(value)
                if dt is None:
                    todo.append(f"cursors.json: {source}.{key} = {value!r} doesn't parse as a timestamp")
                elif dt > now:
                    todo.append(f"cursors.json: {source}.{key} = {value} is in the future")
        if not any("cursors.json" in t for t in todo):
            ok.append("cursors.json looks sane")

    # pkb-cli version, checked against whatever was last fetched -- no network call
    # here (that's `kb update`'s job), so this can go stale but never blocks/slows
    # down a doctor run or touches the network on its own.
    update = update_status(fetch=False)
    if update["is_git"]:
        if update["upstream"]:
            if update["behind"]:
                todo.append(f"pkb-cli is {update['behind']} commit(s) behind {update['upstream']} as of the last "
                            f"fetch -- run `kb update` to check for real and pull")
            else:
                ok.append(f"pkb-cli is up to date with {update['upstream']} as of the last fetch")
    else:
        tarball = tarball_status(fetch=False)
        if tarball["local"] is None:
            todo.append(f"no version marker at {os.path.relpath(VERSION_FILE, TOOL_ROOT)} -- "
                        f"`kb update` won't know what to compare against; reinstall via install.sh to fix")
        elif not tarball["local"]:
            todo.append(f"version marker at {os.path.relpath(VERSION_FILE, TOOL_ROOT)} exists but is empty -- "
                        f"probably an interrupted write; run `kb update` to fix")
        else:
            ok.append(f"pkb-cli installed at {tarball['local'][:8]} (run `kb update` to check for a newer version)")

    return ok, todo


def cmd_doctor(args):
    """Read-only health check -- reuses the same detection helpers as `kb setup`
    but never writes anything, and adds a few deeper checks setup doesn't do."""
    try:
        root = pc.get_repo_root()
    except SystemExit:
        root = None
    ok, todo = doctor_checks(root)

    print("kb doctor\n")
    for line in ok:
        print(f"  [ok]   {line}")
    for line in todo:
        print(f"  [todo] {line}")
    if not todo:
        print("\nall clear")
    return 1 if todo else 0


def cmd_update(args):
    """Check this pkb-cli install against upstream; update if behind. Branches on
    how it was installed: a git checkout (e.g. a contributor's manual `git clone`)
    uses git fetch/pull; the common case -- install.sh's tarball snapshot, no git
    required -- compares the local .pkb-cli-version marker against the latest
    commit sha via the GitHub API and, if different, overwrites TOOL_ROOT's files
    with a fresh tarball. The only kb command besides `kb sync` that touches the
    network."""
    if not os.path.isdir(os.path.join(TOOL_ROOT, ".git")):
        return _cmd_update_tarball(args)

    fetch = _git("fetch", "--quiet", "origin")
    if fetch.returncode != 0:
        print(f"error: git fetch failed: {fetch.stderr.strip()}", file=sys.stderr)
        return 1

    status = update_status(fetch=False)  # already fetched above, no need to do it twice
    if not status["upstream"]:
        print(f"error: no upstream branch configured for {TOOL_ROOT}", file=sys.stderr)
        return 1

    if not status["behind"]:
        print(f"kb is up to date with {status['upstream']} ({status['local'][:8]})")
        return 0

    print(f"kb is {status['behind']} commit(s) behind {status['upstream']} "
          f"({status['local'][:8]} -> {status['remote'][:8]})")

    if args.check:
        print("run `kb update` (without --check) to pull")
        return 1

    if status["dirty"]:
        print(f"error: {TOOL_ROOT} has local changes -- commit or stash them before updating", file=sys.stderr)
        return 1

    pull = _git("pull", "--ff-only")
    if pull.returncode != 0:
        print(f"error: git pull failed: {pull.stderr.strip()}", file=sys.stderr)
        return 1
    print(pull.stdout.strip())
    print("updated -- run `kb setup` again if this changed onboarding behavior (e.g. hook logic).")
    return 0


def _cmd_update_tarball(args):
    local_sha = _read_local_version()
    if local_sha is None:
        print(f"error: no version marker at {VERSION_FILE} -- reinstall via install.sh", file=sys.stderr)
        return 1

    try:
        remote_sha = _fetch_remote_sha()
    except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
        print(f"error: couldn't check for updates: {e}", file=sys.stderr)
        return 1

    if not local_sha:
        # exists but empty/corrupt (e.g. an interrupted _write_local_version) --
        # distinct from a missing marker: still install-able, just can't say
        # whether it's "behind"; treat it as needing a refresh either way.
        print(f"warning: {VERSION_FILE} exists but is empty -- can't tell what's currently "
              f"installed, refreshing to {TOOL_REPO_SLUG}@{TOOL_BRANCH} ({remote_sha[:8]})")
    elif local_sha == remote_sha:
        print(f"kb is up to date with {TOOL_REPO_SLUG}@{TOOL_BRANCH} ({local_sha[:8]})")
        return 0
    else:
        print(f"kb is behind {TOOL_REPO_SLUG}@{TOOL_BRANCH} ({local_sha[:8]} -> {remote_sha[:8]})")

    if args.check:
        print("run `kb update` (without --check) to pull")
        return 1

    try:
        _apply_tarball_update(remote_sha)
    except (urllib.error.URLError, OSError, tarfile.TarError) as e:
        print(f"error: update failed: {e}", file=sys.stderr)
        return 1
    _write_local_version(remote_sha)
    print(f"updated -> {remote_sha[:8]}")
    print("updated -- run `kb setup` again if this changed onboarding behavior (e.g. hook logic).")
    return 0


EPILOG = """\
examples:
  kb new how-to "Tailscale sidecar config for Synology"
  kb search tailscale --type how-to
  kb sync all && kb triage
  kb setup --install
  kb update

kb operates on a data repo found by walking up from the current directory to a
.pkb/ directory. Run 'kb <command> -h' for details on a specific command.
"""


