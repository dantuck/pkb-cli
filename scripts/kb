#!/usr/bin/env python3
"""kb — thin CLI wrapper dispatching to sibling scripts in this tool repo. No daemon;
one-shot per invocation. Operates on a data repo (found by walking up from cwd to a
.pkb/ directory), which lives separately from wherever this tool is installed."""
import argparse
import os
import shutil
import subprocess
import sys
from datetime import datetime, timedelta

SCRIPT_DIR = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
TOOL_ROOT = os.path.dirname(SCRIPT_DIR)  # the pkb-cli checkout itself, not the data repo
sys.path.insert(0, SCRIPT_DIR)
import pkb_common as pc


def run_script(name, args=None):
    cmd = [sys.executable, os.path.join(SCRIPT_DIR, name)] + (args or [])
    result = subprocess.run(cmd)
    return result.returncode


def cmd_search(args):
    root = pc.get_repo_root()
    db_path = os.path.join(root, ".pkb", "fts.db")
    if not os.path.exists(db_path):
        print("no FTS index found. Run `kb index` first, or use ripgrep directly:")
        print(f"  rg --heading -n {args.query!r} tutorials how-to reference explanation")
        return 1

    import sqlite3
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()

    where = ["fts MATCH ?"]
    params = [args.query]
    if not args.all:
        placeholders = ",".join("?" for _ in pc.CORE_TYPES)
        where.append(f"fts.type IN ({placeholders})")
        params.extend(pc.CORE_TYPES)
    if args.type:
        where.append("fts.type = ?")
        params.append(args.type)
    if args.tag:
        where.append("fts.tags MATCH ?")
        params.append(args.tag)

    sql = f"""
        SELECT f.id, f.title, f.type, f.path, bm25(fts) as rank
        FROM fts JOIN files f ON f.id = fts.id
        WHERE {' AND '.join(where)}
        ORDER BY rank LIMIT 50
    """
    try:
        rows = cur.execute(sql, params).fetchall()
    except sqlite3.OperationalError as e:
        print(f"search error: {e}")
        return 1

    if not rows:
        print("no results")
        return 0
    for entry_id, title, entry_type, path, _rank in rows:
        print(f"[{entry_type:11}] {entry_id}  {title}\n    {path}")
    return 0


def cmd_new(args):
    root = pc.get_repo_root()
    entry_type = args.type
    if entry_type not in pc.CORE_TYPES:
        print(f"error: type must be one of {pc.CORE_TYPES}", file=sys.stderr)
        return 1

    all_ids = pc.collect_existing_ids(root)
    entry_id = pc.gen_id(all_ids)
    now = pc.now_iso()
    fm = {
        "id": entry_id,
        "created": now,
        "updated": now,
        "type": entry_type,
        "extension": None,
        "source": "manual",
        "source_id": None,
        "tags": [],
        "links": [],
        "title": args.title,
    }
    slug = "".join(c if c.isalnum() else "-" for c in args.title.lower()).strip("-")
    slug = "-".join(filter(None, slug.split("-")))[:60] or "untitled"
    path = os.path.join(root, pc.TYPE_DIR[entry_type], f"{entry_id}-{slug}.md")
    pc.write_entry(path, fm, f"# {args.title}\n\n")
    print(path)
    return 0


def cmd_journal(args):
    root = pc.get_repo_root()
    if args.date in (None, "today"):
        target = datetime.now().date()
    else:
        target = datetime.strptime(args.date, "%Y-%m-%d").date()

    dir_path = os.path.join(root, "journal", f"{target.year:04d}", f"{target.month:02d}")
    file_path = os.path.join(dir_path, f"{target.isoformat()}.md")

    if not os.path.exists(file_path):
        all_ids = pc.collect_existing_ids(root)
        now = pc.now_iso()
        entry_id = pc.gen_id(all_ids, dt=datetime.combine(target, datetime.now().time()))
        fm = {
            "id": entry_id,
            "created": now,
            "updated": now,
            "type": "journal",
            "extension": "journal",
            "source": "manual",
            "source_id": None,
            "tags": [],
            "links": [],
            "title": target.isoformat(),
        }
        pc.write_entry(file_path, fm, f"# {target.isoformat()}\n\n")

    editor = os.environ.get("EDITOR")
    if editor:
        os.execvp(editor, [editor, file_path])
    else:
        print(file_path)
    return 0


def cmd_inbox(args):
    root = pc.get_repo_root()
    inbox_dir = os.path.join(root, "inbox")
    now = datetime.now().astimezone()
    files = sorted(
        f for f in os.listdir(inbox_dir) if f.endswith(".md")
    ) if os.path.isdir(inbox_dir) else []
    if not files:
        print("inbox is empty")
        return 0
    for name in files:
        path = os.path.join(inbox_dir, name)
        try:
            fm, _ = pc.read_entry(path)
            created = fm.get("created")
            title = fm.get("title") or name
        except ValueError:
            created = None
            title = name
        created_dt = pc.parse_iso(created)
        age = (now - created_dt).days if created_dt else "?"
        print(f"{age!s:>4}d  {name:<30} {title}")
    return 0


def cmd_triage(args):
    return run_script("triage_report.py")


def cmd_sync(args):
    scripts = {
        "memos": "sync_memos.py",
        "gitlab": "sync_gitlab.py",
        "beads": "sync_beads.py",
    }
    targets = list(scripts.keys()) if args.source in (None, "all") else [args.source]
    rc = 0
    for t in targets:
        print(f"--- sync: {t} ---")
        rc = run_script(scripts[t]) or rc
    return rc


def cmd_index(args):
    return run_script("index_fts.py", ["--full"] if args.full else [])


def cmd_validate(args):
    return run_script("validate_frontmatter.py")


def cmd_links(args):
    root = pc.get_repo_root()
    target_id = args.id
    forward = None
    backlinks = []
    target_path = None

    for path in pc.iter_markdown_files(root):
        try:
            fm, _ = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id") == target_id:
            forward = fm.get("links") or []
            target_path = os.path.relpath(path, root)
        if target_id in (fm.get("links") or []):
            backlinks.append((fm.get("id"), fm.get("title"), os.path.relpath(path, root)))

    if forward is None:
        print(f"error: no entry with id '{target_id}'", file=sys.stderr)
        return 1

    print(f"{target_id}  ({target_path})")
    print(f"\nforward links ({len(forward)}):")
    for link_id in forward:
        print(f"  -> {link_id}")
    print(f"\nbacklinks ({len(backlinks)}):")
    for link_id, title, path in backlinks:
        print(f"  <- {link_id}  {title}  ({path})")
    return 0


def cmd_todo(args):
    if not shutil.which("bd"):
        print("bd CLI not found -- install it (`brew install beads`) to track TODOs. "
              "See `kb doctor`.", file=sys.stderr)
        return 1

    root = pc.get_repo_root()
    bd_args = ["bd", "-C", root, "list", "--json", "--sort", "priority", "--limit", "0"]
    if args.all:
        bd_args.append("--all")
    result = subprocess.run(bd_args, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"error: bd list failed: {result.stderr.strip()}", file=sys.stderr)
        return 1

    import json
    issues = json.loads(result.stdout)
    if not issues:
        print("no open todos" if not args.all else "no todos")
        return 0
    for i in issues:
        status = f" [{i['status']}]" if args.all and i["status"] != "open" else ""
        print(f"{i['id']:<10} P{i['priority']}  {i['title']}{status}")
    return 0


def cmd_bd(args):
    """Passthrough to `bd`, pointed at the resolved data repo root via -C -- so
    every other bd action (show/close/comment/create/update/...) works from
    anywhere the same way `kb todo` does, without hand-wrapping each one."""
    if not shutil.which("bd"):
        print("bd CLI not found -- install it (`brew install beads`).", file=sys.stderr)
        return 1
    root = pc.get_repo_root()
    result = subprocess.run(["bd", "-C", root, *args.bd_args])
    return result.returncode


def find_install_dir():
    """Return (dir, already_on_path). Prefers a candidate already on PATH; falls
    back to ~/.local/bin (created if needed) so --install always succeeds on a
    completely fresh machine, just with a note to update PATH."""
    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    candidates = (os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin")
    for candidate in candidates:
        if os.path.isdir(candidate) and candidate in path_dirs:
            return candidate, True
    return os.path.expanduser("~/.local/bin"), False


# --- shared status checks, used by both `kb setup` (which acts on them) and
# `kb doctor` (which only reports) -- one place to know how to detect each
# piece of state so the two commands can't drift apart on what "ok" means.

HOOK_MARKER = "# pkb-managed-hook"


def hook_expected_content():
    validate_path = os.path.join(SCRIPT_DIR, "validate_frontmatter.py")
    content = (
        "#!/bin/sh\n"
        f"{HOOK_MARKER} -- regenerated by `kb setup`, do not hand-edit\n"
        f'exec "{sys.executable}" "{validate_path}"\n'
    )
    return content, validate_path


def read_hook(root):
    hook_path = os.path.join(root, ".git", "hooks", "pre-commit")
    if os.path.exists(hook_path):
        with open(hook_path, "r", encoding="utf-8") as f:
            return hook_path, f.read()
    return hook_path, None


def hook_managed_validate_path(content):
    """Extract the validate_frontmatter.py path baked into a kb-managed hook's
    `exec "<python>" "<path>"` line, or None if content isn't ours."""
    if not content or HOOK_MARKER not in content:
        return None
    parts = content.split('"')
    return parts[3] if len(parts) > 3 else None


def tool_status():
    status = {t: shutil.which(t) is not None for t in ("bd", "sops", "glab", "rg", "fzf")}
    status["glab_auth"] = (
        subprocess.run(["glab", "auth", "status"], capture_output=True).returncode == 0
        if status["glab"] else False
    )
    return status


def index_status(root):
    return os.path.join(root, ".pkb", "fts.db")


def bd_store_status(root):
    store_exists = os.path.isdir(os.path.join(root, ".beads"))
    exclude_path = os.path.join(root, ".git", "info", "exclude")
    git_excluded = False
    if os.path.exists(exclude_path):
        with open(exclude_path, "r", encoding="utf-8") as f:
            git_excluded = ".beads/" in f.read()
    return store_exists, git_excluded


def secrets_status(root):
    sops_configured = os.path.exists(os.path.join(root, ".sops.yaml"))
    secrets_exists = os.path.exists(os.path.join(root, ".pkb", "secrets.enc.env"))
    return sops_configured, secrets_exists


def _git(*args, cwd=TOOL_ROOT):
    return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)


def update_status(fetch=False):
    """Compare this pkb-cli checkout's HEAD against its upstream.

    fetch=False (used by `kb doctor`) never touches the network -- it only compares
    against whatever origin/<branch> was last fetched, so it can go stale, but stays
    within doctor's "never writes, never hits the network" contract. fetch=True (used
    by `kb update`) refreshes that ref first, so its answer is authoritative.

    Returns a dict: is_git, upstream, local, remote, behind, dirty. Fields are None
    when they don't apply (e.g. not a git checkout, or no upstream configured).
    """
    result = {"is_git": os.path.isdir(os.path.join(TOOL_ROOT, ".git")),
              "upstream": None, "local": None, "remote": None, "behind": None, "dirty": None}
    if not result["is_git"]:
        return result

    if fetch:
        _git("fetch", "--quiet", "origin")

    upstream = _git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream.returncode != 0:
        return result
    result["upstream"] = upstream.stdout.strip()

    result["local"] = _git("rev-parse", "HEAD").stdout.strip()
    result["remote"] = _git("rev-parse", result["upstream"]).stdout.strip()
    if result["local"] and result["remote"]:
        behind = _git("rev-list", "--count", f"{result['local']}..{result['remote']}")
        result["behind"] = int(behind.stdout.strip()) if behind.returncode == 0 else None
    result["dirty"] = bool(_git("status", "--porcelain").stdout.strip())
    return result


def cmd_setup(args):
    # root is optional: --install (and the tool/sync checks below) don't need a data
    # repo at all -- only the hook/index/bd/secrets steps do.
    try:
        root = pc.get_repo_root()
    except SystemExit:
        root = None
    ok, todo = [], []

    # 0. install kb itself onto PATH (opt-in via --install [DIR])
    if args.install is not None:
        script_path = os.path.abspath(os.path.join(SCRIPT_DIR, "kb"))
        if args.install:
            install_dir, on_path = os.path.expanduser(args.install), args.install in os.environ.get("PATH", "").split(os.pathsep)
        else:
            install_dir, on_path = find_install_dir()
        target = os.path.join(install_dir, "kb")
        if os.path.islink(target) and os.readlink(target) == script_path:
            ok.append(f"kb already installed at {target}")
        elif os.path.exists(target):
            todo.append(f"--install: {target} already exists and isn't this repo's kb -- remove it "
                        f"or pass a different --install <dir>")
        else:
            os.makedirs(install_dir, exist_ok=True)
            os.symlink(script_path, target)
            if on_path:
                ok.append(f"installed kb -> {target}")
            else:
                ok.append(f"installed kb -> {target} (not yet on PATH)")
                todo.append(f'add this to your shell profile: export PATH="{install_dir}:$PATH"')

    tools = tool_status()

    if root is None:
        todo.append("not inside a pkb data repo (no .pkb/ found) -- cd into one to also set up the "
                     "pre-commit hook, search index, and local bd store")
    else:
        # 1. pre-commit hook -- generated directly (not a symlinked template) since it
        # must hardcode this machine's path to the tool install, which lives in a
        # separate repo from the data repo the hook runs in.
        git_dir = os.path.join(root, ".git")
        if not os.path.isdir(git_dir):
            todo.append("not a git repo (or .git not found here) -- pre-commit hook skipped")
        else:
            hook_content, _validate_path = hook_expected_content()
            hook_path, existing = read_hook(root)
            if existing == hook_content:
                ok.append("pre-commit hook already installed")
            elif existing is not None and HOOK_MARKER not in existing:
                todo.append(f"{os.path.relpath(hook_path, root)} exists and isn't our hook -- leaving it alone")
            else:
                os.makedirs(os.path.dirname(hook_path), exist_ok=True)
                if os.path.lexists(hook_path):  # e.g. a stale/broken symlink from an older kb setup
                    os.remove(hook_path)
                with open(hook_path, "w", encoding="utf-8") as f:
                    f.write(hook_content)
                os.chmod(hook_path, 0o755)
                ok.append("installed pre-commit hook" if existing is None else "refreshed pre-commit hook path")

        # 2. FTS index
        db_path = index_status(root)
        full = not os.path.exists(db_path)
        rc = run_script("index_fts.py", ["--full"] if full else [])
        ok.append(f"{'built' if full else 'refreshed'} the FTS5 search index" if rc == 0 else "index build failed")

        # 3. local bd store
        if tools["bd"]:
            store_exists, _git_excluded = bd_store_status(root)
            if store_exists:
                ok.append("local bd (beads) store already initialized")
            else:
                result = subprocess.run(
                    ["bd", "init", "--stealth", "--non-interactive"],
                    cwd=root, capture_output=True, text=True,
                )
                if result.returncode == 0:
                    ok.append("initialized a local bd store (--stealth: excluded from git)")
                else:
                    todo.append(f"bd init failed: {result.stderr.strip() or result.stdout.strip()}")
        else:
            todo.append("bd CLI not found -- `brew install beads` if you want local TODO tracking via kb sync beads")

        # 4. secrets (sops), informational only -- never touch/create real secrets ourselves
        sops_configured, secrets_exists = secrets_status(root)
        if sops_configured:
            if secrets_exists:
                ok.append(".pkb/secrets.enc.env already set up")
            elif tools["sops"]:
                example_path = os.path.join(SCRIPT_DIR, "..", "templates", "secrets.env.example")
                todo.append("run `sops .pkb/secrets.enc.env` to create encrypted memos/gitlab credentials "
                            f"(see {os.path.normpath(example_path)})")
            else:
                todo.append("sops CLI not found -- install it to use encrypted credentials, or export "
                            "PKB_MEMOS_URL/PKB_MEMOS_TOKEN/PKB_GITLAB_PROJECT directly")

    # 5. glab (required for GitLab sync)
    if tools["glab"]:
        if not tools["glab_auth"]:
            todo.append("glab is installed but not authenticated -- run `glab auth login` for kb sync gitlab")
    else:
        todo.append("glab CLI not found -- `brew install glab` (+ `glab auth login`) if you want kb sync gitlab")

    # 6. rg/fzf (Tier 1 search, optional -- kb search/index work without them)
    missing_search_tools = [t for t in ("rg", "fzf") if not tools[t]]
    if missing_search_tools:
        todo.append(f"{'/'.join(missing_search_tools)} not found -- optional, only needed for zero-setup "
                     f"search (`brew install ripgrep fzf`); kb search/index don't need them")

    # 7. what's actually configured for sync right now (informational)
    configured = []
    if os.environ.get("PKB_MEMOS_URL") and os.environ.get("PKB_MEMOS_TOKEN"):
        configured.append("memos")
    if os.environ.get("PKB_GITLAB_PROJECT") and tools["glab_auth"]:
        configured.append("gitlab")
    if tools["bd"]:
        configured.append("beads")
    if configured:
        ok.append(f"sync sources ready in this shell: {', '.join(configured)}")
    else:
        todo.append("no sync source has credentials in this shell yet (memos/gitlab need env vars, "
                     "see README 'Ingestion credentials')")

    print("kb setup\n")
    for line in ok:
        print(f"  [ok]   {line}")
    for line in todo:
        print(f"  [todo] {line}")
    return 1 if any("failed" in t for t in todo) else 0


def cmd_doctor(args):
    """Read-only health check -- reuses the same detection helpers as `kb setup`
    but never writes anything, and adds a few deeper checks setup doesn't do."""
    # root is optional: tool-level checks (glab/rg/fzf, pkb-cli's own update status)
    # don't need a data repo -- only frontmatter/hook/index/bd/secrets/cursors do.
    try:
        root = pc.get_repo_root()
    except SystemExit:
        root = None
    ok, todo = [], []

    if root is None:
        todo.append("not inside a pkb data repo (no .pkb/ found) -- cd into one to check "
                     "frontmatter, the pre-commit hook, the search index, and cursors.json")
    else:
        # frontmatter integrity (reuses validate_frontmatter.py itself)
        result = subprocess.run(
            [sys.executable, os.path.join(SCRIPT_DIR, "validate_frontmatter.py")],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            ok.append("frontmatter validates cleanly")
        else:
            todo.append("frontmatter validation is failing -- run `kb validate` for details")

        # pre-commit hook: installed, ours, matches what we'd generate now, and points
        # at a file that still exists (setup doesn't check that last part)
        hook_content, _validate_path = hook_expected_content()
        hook_path, existing = read_hook(root)
        if existing is None:
            todo.append("no pre-commit hook installed -- run `kb setup`")
        elif HOOK_MARKER not in existing:
            todo.append(f"{os.path.relpath(hook_path, root)} exists but isn't kb-managed")
        else:
            hooked_path = hook_managed_validate_path(existing)
            if hooked_path and not os.path.exists(hooked_path):
                todo.append(f"pre-commit hook points at a missing file ({hooked_path}) -- "
                            f"the pkb-cli checkout that wrote it may have moved; run `kb setup`")
            elif existing != hook_content:
                todo.append("pre-commit hook is stale (points at a different pkb-cli install/interpreter "
                            "than this one) -- run `kb setup`")
            else:
                ok.append("pre-commit hook is current")

        # FTS index: present, and its row count matches the number of files on disk
        # (a mismatch means something changed without a reindex)
        db_path = index_status(root)
        if not os.path.exists(db_path):
            todo.append("no search index -- run `kb index --full`")
        else:
            import sqlite3
            file_count = sum(1 for _ in pc.iter_markdown_files(root))
            conn = sqlite3.connect(db_path)
            try:
                indexed_count = conn.execute("SELECT COUNT(*) FROM files").fetchone()[0]
            except sqlite3.OperationalError:
                indexed_count = None
            conn.close()
            if indexed_count is None:
                todo.append(f"{os.path.relpath(db_path, root)} exists but doesn't look like a kb index -- "
                            f"run `kb index --full`")
            elif indexed_count != file_count:
                todo.append(f"search index is stale ({indexed_count} indexed vs {file_count} files on disk) "
                            f"-- run `kb index`")
            else:
                ok.append(f"search index is current ({indexed_count} files)")

    # local bd store: present and actually git-excluded
    tools = tool_status()
    if root is not None:
        if tools["bd"]:
            store_exists, git_excluded = bd_store_status(root)
            if not store_exists:
                todo.append("no local bd store -- run `kb setup`")
            elif not git_excluded:
                todo.append(".beads/ exists but isn't in .git/info/exclude -- it may get committed accidentally")
            else:
                ok.append("local bd store is present and git-excluded")
        else:
            todo.append("bd CLI not found -- `brew install beads` if you want local TODO tracking")

        # secrets
        sops_configured, secrets_exists = secrets_status(root)
        if sops_configured and not secrets_exists:
            todo.append("no .pkb/secrets.enc.env yet -- run `sops .pkb/secrets.enc.env` if you sync memos/gitlab")
        elif sops_configured:
            ok.append(".pkb/secrets.enc.env is present")

    # glab / rg / fzf -- not data-repo-specific, always checked
    if tools["glab"] and not tools["glab_auth"]:
        todo.append("glab is installed but not authenticated -- run `glab auth login`")
    elif not tools["glab"]:
        todo.append("glab CLI not found -- needed for kb sync gitlab")
    missing_search_tools = [t for t in ("rg", "fzf") if not tools[t]]
    if missing_search_tools:
        todo.append(f"{'/'.join(missing_search_tools)} not found (optional, Tier 1 search)")

    # cursors.json sanity
    if root is not None:
        cursors = pc.load_cursors(root)
        now = datetime.now().astimezone()
        for source, fields in cursors.items():
            for key, value in (fields or {}).items():
                if value is None:
                    continue
                dt = pc.parse_iso(value)
                if dt is None:
                    todo.append(f"cursors.json: {source}.{key} = {value!r} doesn't parse as a timestamp")
                elif dt > now:
                    todo.append(f"cursors.json: {source}.{key} = {value} is in the future")
        if not any("cursors.json" in t for t in todo):
            ok.append("cursors.json looks sane")

    # pkb-cli version, checked against whatever was last fetched -- no network call
    # here (that's `kb update`'s job), so this can go stale but never blocks/slows
    # down a doctor run or touches the network on its own.
    update = update_status(fetch=False)
    if update["is_git"] and update["upstream"]:
        if update["behind"]:
            todo.append(f"pkb-cli is {update['behind']} commit(s) behind {update['upstream']} as of the last "
                        f"fetch -- run `kb update` to check for real and pull")
        else:
            ok.append(f"pkb-cli is up to date with {update['upstream']} as of the last fetch")

    print("kb doctor\n")
    for line in ok:
        print(f"  [ok]   {line}")
    for line in todo:
        print(f"  [todo] {line}")
    if not todo:
        print("\nall clear")
    return 1 if todo else 0


def cmd_update(args):
    """Fetch + check this pkb-cli checkout against its upstream; pull if behind
    and clean. The only kb command besides `kb sync` that touches the network."""
    if not os.path.isdir(os.path.join(TOOL_ROOT, ".git")):
        print(f"error: {TOOL_ROOT} isn't a git checkout -- can't check for updates", file=sys.stderr)
        return 1

    fetch = _git("fetch", "--quiet", "origin")
    if fetch.returncode != 0:
        print(f"error: git fetch failed: {fetch.stderr.strip()}", file=sys.stderr)
        return 1

    status = update_status(fetch=False)  # already fetched above, no need to do it twice
    if not status["upstream"]:
        print(f"error: no upstream branch configured for {TOOL_ROOT}", file=sys.stderr)
        return 1

    if not status["behind"]:
        print(f"kb is up to date with {status['upstream']} ({status['local'][:8]})")
        return 0

    print(f"kb is {status['behind']} commit(s) behind {status['upstream']} "
          f"({status['local'][:8]} -> {status['remote'][:8]})")

    if args.check:
        print("run `kb update` (without --check) to pull")
        return 1

    if status["dirty"]:
        print(f"error: {TOOL_ROOT} has local changes -- commit or stash them before updating", file=sys.stderr)
        return 1

    pull = _git("pull", "--ff-only")
    if pull.returncode != 0:
        print(f"error: git pull failed: {pull.stderr.strip()}", file=sys.stderr)
        return 1
    print(pull.stdout.strip())
    print("updated -- run `kb setup` again if this changed onboarding behavior (e.g. hook logic).")
    return 0


EPILOG = """\
examples:
  kb new how-to "Tailscale sidecar config for Synology"
  kb search tailscale --type how-to
  kb sync all && kb triage
  kb setup --install
  kb update

kb operates on a data repo found by walking up from the current directory to a
.pkb/ directory. Run 'kb <command> -h' for details on a specific command.
"""


def main():
    parser = argparse.ArgumentParser(
        prog="kb",
        description="A CLI for a Diataxis-based personal knowledge base: search, "
                     "create, triage, and sync your notes.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True, title="commands", metavar="<command>")

    p = sub.add_parser("search", help="search indexed content")
    p.add_argument("query", help="search terms (FTS5 match syntax)")
    p.add_argument("--type", choices=pc.CORE_TYPES, help="restrict to one Diataxis type")
    p.add_argument("--tag", help="restrict to entries with this tag")
    p.add_argument("--all", action="store_true", help="include journal/inbox/sources (default: core content only)")
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("new", help="scaffold a new core entry")
    p.add_argument("type", choices=pc.CORE_TYPES, help="Diataxis type")
    p.add_argument("title", help="entry title")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("journal", help="open or create a journal entry")
    p.add_argument("date", nargs="?", default=None, metavar="DATE",
                    help="YYYY-MM-DD, or 'today' (default)")
    p.set_defaults(func=cmd_journal)

    p = sub.add_parser("inbox", help="list inbox contents with age")
    p.set_defaults(func=cmd_inbox)

    p = sub.add_parser("triage", help="flag inbox items overdue for triage")
    p.set_defaults(func=cmd_triage)

    p = sub.add_parser("sync", help="pull in usememos / GitLab / beads")
    p.add_argument("source", nargs="?", choices=["memos", "gitlab", "beads", "all"], default="all",
                    help="which source to sync (default: all)")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("index", help="rebuild or refresh the FTS5 search index")
    p.add_argument("--full", action="store_true", help="rebuild from scratch instead of incrementally")
    p.set_defaults(func=cmd_index)

    p = sub.add_parser("validate", help="check frontmatter, id, and link integrity")
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("links", help="show forward links and backlinks for an entry")
    p.add_argument("id", help="entry id, e.g. 2026-08-31-1423")
    p.set_defaults(func=cmd_links)

    p = sub.add_parser("todo", help="list open bd (beads) TODOs, sorted by priority")
    p.add_argument("--all", action="store_true", help="include closed issues")
    p.set_defaults(func=cmd_todo)

    p = sub.add_parser("bd", help="run any bd command against the resolved data repo "
                                   "(e.g. kb bd show kb-nux, kb bd close kb-nux)")
    p.add_argument("bd_args", nargs=argparse.REMAINDER, help="arguments passed straight to bd")
    p.set_defaults(func=cmd_bd)

    p = sub.add_parser("setup", help="onboarding: pre-commit hook, index, bd store, PATH install")
    p.add_argument("--install", nargs="?", const="", default=None, metavar="DIR",
                    help="also symlink kb onto PATH (auto-detects ~/.local/bin, /opt/homebrew/bin, "
                         "/usr/local/bin, or pass a specific DIR)")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("doctor", help="diagnose issues (read-only, never writes anything)")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("update", help="check for and pull kb tool updates")
    p.add_argument("--check", action="store_true", help="only check, don't pull even if behind")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("help", help="show this help message")
    p.set_defaults(func=lambda args: parser.print_help() or 0)

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
