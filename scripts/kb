#!/usr/bin/env python3
"""Compatibility shim for installs made by the old tarball installer, whose `kb`
symlink points here (as do their launchd/systemd units). Their updater overwrites
this file with the new tarball's copy, which forwards to the packaged CLI so those
installs keep working. Safe to delete once nobody is on a pre-package install."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from pkb_cli.cli import main

main()
