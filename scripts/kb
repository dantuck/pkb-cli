#!/usr/bin/env python3
"""kb — thin CLI wrapper dispatching to sibling scripts in this tool repo. No daemon;
one-shot per invocation. Operates on a data repo (found by walking up from cwd to a
.pkb/ directory), which lives separately from wherever this tool is installed."""
import argparse
import calendar
import difflib
import json
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta

SCRIPT_DIR = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
TOOL_ROOT = os.path.dirname(SCRIPT_DIR)  # the pkb-cli checkout itself, not the data repo
sys.path.insert(0, SCRIPT_DIR)
import pkb_common as pc


class KBArgumentParser(argparse.ArgumentParser):
    """argparse.ArgumentParser that gives an unknown top-level command a short,
    readable error (with a 'did you mean' suggestion) instead of the default
    'invalid choice: ... (choose from ...)' wall of text listing every command
    on one line."""

    _INVALID_COMMAND_RE = re.compile(r"^argument <command>: invalid choice: '(.+?)'")

    def __init__(self, *args, subcommands=None, **kwargs):
        self._subcommands = subcommands or []
        super().__init__(*args, **kwargs)

    def error(self, message):
        m = self._INVALID_COMMAND_RE.match(message)
        if not m:
            super().error(message)
        bad = m.group(1)
        self.print_usage(sys.stderr)
        suggestion = difflib.get_close_matches(bad, self._subcommands, n=1)
        print(f"kb: unknown command '{bad}'" +
              (f" -- did you mean '{suggestion[0]}'?" if suggestion else ""),
              file=sys.stderr)
        print("run `kb help` to see all commands", file=sys.stderr)
        sys.exit(2)


def run_script(name, args=None):
    cmd = [sys.executable, os.path.join(SCRIPT_DIR, name)] + (args or [])
    result = subprocess.run(cmd)
    return result.returncode


def _reindex_fast(root):
    """In-process incremental reindex -- same work as `run_script("index_fts.py")`
    but without paying for a fresh interpreter + subprocess on every call.
    Used by entry_set_tags/entry_set_links/entry_update_content, which kb
    web's edit panel can trigger repeatedly in quick succession; other
    callers keep using run_script for output capture / exit-code parity with
    `kb reindex`."""
    import index_fts
    index_fts.index_repo(root)


_FTS_OPERATORS = {"AND", "OR", "NOT", "NEAR"}


def _fts_autoprefix(query):
    """Append FTS5 prefix syntax (*) to bare word tokens, so `kb search dar`
    matches "Darren" the way a user typing a partial word expects. Leaves
    quoted phrases, boolean operators, column filters (title:...), and
    tokens that already use FTS5 syntax (*, parens, ^) untouched."""
    tokens = re.findall(r'"[^"]*"|\S+', query)
    out = []
    for tok in tokens:
        if tok.startswith('"') or tok.upper() in _FTS_OPERATORS or any(c in tok for c in '*():^'):
            out.append(tok)
        else:
            out.append(tok + "*")
    return " ".join(out)


def search_entries(root, query, entry_type=None, tag=None, include_all=False, limit=50):
    """Run an FTS5 search over the index, returning (id, title, type, path, rank)
    rows ordered by relevance -- the core of `kb search`, factored out so both
    the CLI and `kb web`'s /api/search can call the same query instead of
    duplicating the SQL. Raises sqlite3.OperationalError on a bad FTS5 query
    (e.g. unbalanced quotes) so callers can report it however fits their
    context (stderr print vs. a JSON error response)."""
    db_path = os.path.join(root, ".pkb", "fts.db")
    if not os.path.exists(db_path):
        return None  # no index -- distinct from "no results" (empty list)

    conn = sqlite3.connect(db_path)
    cur = conn.cursor()

    where = ["fts MATCH ?"]
    params = [_fts_autoprefix(query)]
    if not include_all:
        placeholders = ",".join("?" for _ in pc.CORE_TYPES)
        where.append(f"fts.type IN ({placeholders})")
        params.extend(pc.CORE_TYPES)
    if entry_type:
        where.append("fts.type = ?")
        params.append(entry_type)
    if tag:
        where.append("fts.tags MATCH ?")
        params.append(tag)

    sql = f"""
        SELECT f.id, f.title, f.type, f.path, bm25(fts) as rank
        FROM fts JOIN files f ON f.id = fts.id
        WHERE {' AND '.join(where)}
        ORDER BY rank LIMIT ?
    """
    try:
        rows = cur.execute(sql, params + [limit]).fetchall()
    finally:
        conn.close()
    return rows


def cmd_search(args):
    root = pc.get_repo_root()
    try:
        rows = search_entries(root, args.query, entry_type=args.type, tag=args.tag,
                               include_all=args.all)
    except sqlite3.OperationalError as e:
        print(f"search error: {e}")
        return 1
    if rows is None:
        print("no FTS index found. Run `kb index` first, or use ripgrep directly:")
        print(f"  rg --heading -n {args.query!r} tutorials how-to reference explanation")
        return 1

    if not rows:
        if args.json:
            print("[]")
            return 0
        print("no results")
        return 0

    if args.json:
        print(json.dumps([
            {"id": entry_id, "title": title, "type": entry_type, "path": path}
            for entry_id, title, entry_type, path, _rank in rows
        ]))
        return 0

    # interactive by default when the tooling supports it, same rule as kb todo:
    # fzf installed, both ends real terminals (never for piped/scripted use).
    interactive = not args.plain and shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()
    if interactive:
        return _search_interactive(root, rows)

    for entry_id, title, entry_type, path, _rank in rows:
        print(f"[{entry_type:11}] {entry_id}  {title}\n    {path}")
    if not shutil.which("fzf"):
        print("\n(install fzf for an interactive picker)")
    return 0


def _fzf_select(lines, prompt, header, delimiter=None, with_nth=None,
                 preview_cmd=None, preview_window="right:60%", multi=False):
    """Run fzf over `lines`, returning the raw selected line, or None if
    cancelled (esc/ctrl-c) or nothing was selected. Shared by every
    interactive picker in this file -- search/inbox/todo/journal each used to
    hand-roll this same subprocess.run + cancel-check.

    With multi=True (tab to toggle multiple matches in fzf), returns a list of
    selected lines instead of a single string, or None if nothing was picked."""
    cmd = ["fzf", "--prompt", prompt, "--header", header]
    if multi:
        cmd.append("--multi")
    if delimiter is not None:
        cmd += ["--delimiter", delimiter]
    if with_nth is not None:
        cmd += ["--with-nth", with_nth]
    if preview_cmd is not None:
        cmd += ["--preview", preview_cmd, "--preview-window", preview_window]
    result = subprocess.run(cmd, input="\n".join(lines), text=True, stdout=subprocess.PIPE)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    out = result.stdout.rstrip("\n")
    return out.split("\n") if multi else out


def _search_interactive(root, rows):
    """fzf-based picker: select a result (with a live file-content preview), then
    an action -- view (print full content), edit ($EDITOR), links (forward/back),
    or cancel. Same two-stage shape as kb todo's picker, for consistency."""
    lines, by_id = [], {}
    for entry_id, title, entry_type, path, _rank in rows:
        abs_path = os.path.join(root, path)
        lines.append(f"{entry_id}\t{entry_type}\t{title}\t{abs_path}")
        by_id[entry_id] = (title, abs_path)

    selected = _fzf_select(lines, "search> ", "enter: choose an action for this result",
                            delimiter="\t", with_nth="1,2,3", preview_cmd="cat {4}")
    if selected is None:
        return 0  # cancelled
    fields = selected.split("\t")
    chosen_id, chosen_path = fields[0], fields[3]
    title = by_id.get(chosen_id, ("", chosen_path))[0]

    choice = _fzf_select(["view", "edit", "links", "cancel"],
                          f"{chosen_id}> ", f"{title} -- choose an action")
    if choice is None:
        return 0

    if choice == "view":
        subprocess.run(["cat", chosen_path])
    elif choice == "edit":
        editor = pc.get_editor()
        parts = pc.resolve_editor_argv(editor) if editor else None
        if not parts:
            print(f"no editor available -- set $EDITOR or run `kb config editor <cmd>` -- {chosen_path}",
                  file=sys.stderr)
        else:
            try:
                subprocess.run(parts + [chosen_path])
            except FileNotFoundError:
                print(f"error: editor '{parts[0]}' not found on PATH -- fix it with `kb config editor <cmd>`",
                      file=sys.stderr)
    elif choice == "links":
        show_links(root, chosen_id)
    return 0


def cmd_new(args):
    root = pc.get_repo_root()
    tags = args.tags.split(",") if args.tags else []
    links = args.links.split(",") if args.links else []
    result = entry_new(root, args.type, args.title, tags=tags, links=links, body=args.body)
    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    print(result["path"])
    return 0


def _looks_like_date(text):
    try:
        datetime.strptime(text, "%Y-%m-%d")
    except ValueError:
        return False
    return True


def _journal_path(root, target):
    dir_path = os.path.join(root, "journal", f"{target.year:04d}", f"{target.month:02d}")
    return os.path.join(dir_path, f"{target.isoformat()}.md")


def _ensure_journal_entry(root, target):
    """Create target's journal file (with frontmatter) if it doesn't exist yet.
    Returns its path either way."""
    file_path = _journal_path(root, target)
    if not os.path.exists(file_path):
        all_ids = pc.collect_existing_ids(root)
        now = pc.now_iso()
        entry_id = pc.gen_id(all_ids, dt=datetime.combine(target, datetime.now().time()))
        fm = {
            "id": entry_id,
            "created": now,
            "updated": now,
            "type": "journal",
            "extension": "journal",
            "source": "manual",
            "source_id": None,
            "tags": [],
            "links": [],
            "title": target.isoformat(),
        }
        pc.write_entry(file_path, fm, f"# {target.isoformat()}\n\n")
    return file_path


def _open_in_editor(file_path):
    editor = pc.get_editor()
    parts = pc.resolve_editor_argv(editor) if editor else None
    if not parts:
        print(f"no editor available -- set $EDITOR or run `kb config editor <cmd>` -- {file_path}",
              file=sys.stderr)
        return
    sys.stdout.flush()  # os.execvp below replaces this process without flushing buffered stdout
    try:
        os.execvp(parts[0], parts + [file_path])  # replaces this process; nothing after this runs
    except FileNotFoundError:
        print(f"error: editor '{parts[0]}' not found on PATH -- fix it with `kb config editor <cmd>` "
              f"-- {file_path}", file=sys.stderr)
        sys.exit(1)


def list_journal_entries(root, limit=None):
    """(date_str, path) for journal files, newest first.

    Walks journal/YYYY/MM/ in descending order and stops as soon as `limit`
    entries are collected, instead of always listing every entry ever written
    just to keep the most recent few -- callers like cmd_journal's "recent
    entries" hint only ever want a handful.
    """
    journal_dir = os.path.join(root, "journal")
    if not os.path.isdir(journal_dir):
        return []

    def _subdirs_desc(path):
        return sorted((d for d in os.listdir(path) if os.path.isdir(os.path.join(path, d))), reverse=True)

    entries = []
    for year in _subdirs_desc(journal_dir):
        year_dir = os.path.join(journal_dir, year)
        for month in _subdirs_desc(year_dir):
            month_dir = os.path.join(year_dir, month)
            names = sorted((n for n in os.listdir(month_dir) if n.endswith(".md")), reverse=True)
            for name in names:
                entries.append((name[:-3], os.path.join(month_dir, name)))
                if limit and len(entries) >= limit:
                    return entries
    return entries


def _shift_months(date, delta):
    """date, shifted by `delta` months, clamped to the shifted month's length
    (e.g. Aug 31 - 1 month -> Jul 31, not an overflow into August)."""
    month_index = date.month - 1 + delta
    year = date.year + month_index // 12
    month = month_index % 12 + 1
    day = min(date.day, calendar.monthrange(year, month)[1])
    return date.replace(year=year, month=month, day=day)


def _on_this_day(root, target):
    """(label, date_str, path) for past journal entries at the offsets a
    "look back" feature cares about -- a week ago, a month ago, and this same
    month/day in each earlier year -- restricted to offsets that actually have
    an entry, so this never pads the list with empty prompts to fill in the
    past."""
    candidates = [("1 week ago", target - timedelta(days=7)),
                  ("1 month ago", _shift_months(target, -1))]
    for years in range(1, 11):
        try:
            d = target.replace(year=target.year - years)
        except ValueError:  # target is Feb 29 and this year isn't a leap year
            d = target.replace(year=target.year - years, day=28)
        label = "1 year ago" if years == 1 else f"{years} years ago"
        candidates.append((label, d))

    seen, results = set(), []
    for label, d in candidates:
        if d >= target or d in seen:
            continue
        seen.add(d)
        path = _journal_path(root, d)
        if os.path.exists(path):
            results.append((label, d.isoformat(), path))
    return results


def journal_append(root, target, text):
    """Append `text` to target's journal entry, creating it (with frontmatter)
    first if needed. No editor involved -- for jotting something down without
    leaving the shell (or, for `kb web`'s quick-capture box, without leaving the
    browser). A single line becomes a timestamped bullet; multiple lines (e.g.
    from _journal_add_editor) become a timestamped heading block, same shape
    `kb inbox`'s redirect action already uses.

    Returns {"path": <relpath>, "time": "HH:MM"} on success, or None if `text`
    was empty (nothing written). Shared by the CLI and the web capture endpoint
    so there's exactly one place this logic lives."""
    text = text.strip("\n")
    if not text:
        return None

    file_path = _ensure_journal_entry(root, target)
    fm, body = pc.read_entry(file_path)
    stamp = datetime.now().strftime("%H:%M")
    block = f"## {stamp}\n\n{text}\n" if "\n" in text else f"- {stamp}  {text}\n"
    body = body.rstrip("\n") + f"\n\n{block}"
    fm["updated"] = pc.now_iso()
    pc.write_entry(file_path, fm, body)
    run_script("index_fts.py")
    return {"path": os.path.relpath(file_path, root), "time": stamp}


def _journal_add(root, target, text):
    result = journal_append(root, target, text)
    if result is None:
        print("empty -- nothing added")
        return 0
    print(f"added -> {result['path']}")
    return 0


def _journal_add_editor(root, target):
    """Open a blank scratch buffer in $EDITOR for multiline input, then append
    whatever was written to target's journal entry -- like `git commit` with no
    -m, but scoped to a throwaway temp file so the entry's frontmatter (and any
    earlier entries in the file) never has to be touched or scrolled past."""
    editor = pc.get_editor()
    parts = pc.resolve_editor_argv(editor) if editor else None
    if not parts:
        print("no editor available -- set $EDITOR or run `kb config editor <cmd>`", file=sys.stderr)
        return 1

    fd, tmp_path = tempfile.mkstemp(prefix="kb-journal-", suffix=".md")
    os.close(fd)
    try:
        try:
            subprocess.run(parts + [tmp_path], check=True)
        except FileNotFoundError:
            print(f"error: editor '{parts[0]}' not found on PATH -- fix it with `kb config editor <cmd>`",
                  file=sys.stderr)
            return 1
        except subprocess.CalledProcessError:
            print("editor exited with an error -- nothing added", file=sys.stderr)
            return 1
        with open(tmp_path, "r", encoding="utf-8") as f:
            text = f.read()
    finally:
        os.remove(tmp_path)

    return _journal_add(root, target, text)


def cmd_journal(args):
    root = pc.get_repo_root()

    if args.date == "rollup":
        return _journal_rollup(root, args.month)
    if args.tag:
        return _journal_by_tag(root, args.tag)

    explicit_date = args.date not in (None, "today")
    target = (datetime.now().date() if args.date in (None, "today")
              else datetime.strptime(args.date, "%Y-%m-%d").date())

    if args.add is not None:
        if args.add == "":  # -m/--add with no TEXT: open a scratch buffer instead
            return _journal_add_editor(root, target)
        if args.date is None and _looks_like_date(args.add):
            # `-m` typed before DATE: argparse's nargs='?' greedily consumes the
            # date token as -m's own TEXT instead of leaving it for the `date`
            # positional. Silently writing to today under those circumstances
            # would put the note on the wrong day with no indication anything
            # went wrong -- refuse instead, and say what order actually works.
            print(f"error: `-m {args.add}` was parsed as the note text, not a date -- "
                  f"put the date first: `kb journal {args.add} -m ...`", file=sys.stderr)
            return 1
        return _journal_add(root, target, args.add)

    if not explicit_date:
        # only the default "today" invocation gets the interactive picker -- an
        # explicit date means the user already knows exactly what they want open.
        interactive = not args.plain and shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()
        if interactive:
            return _journal_interactive(root)

    file_path = _ensure_journal_entry(root, target)

    if not explicit_date:
        # no fzf/terminal for a full picker -- still surface nearby entries and
        # this-day-in-the-past ones for context instead of silently jumping
        # straight into today's.
        on_this_day = _on_this_day(root, target)
        if on_this_day:
            print("on this day:")
            for label, date_str, path in on_this_day:
                print(f"  {label:12} {date_str}  {os.path.relpath(path, root)}")
            print()

        recent = [(d, p) for d, p in list_journal_entries(root, limit=6) if d != target.isoformat()][:5]
        if recent:
            print("recent entries:")
            for date_str, path in recent:
                print(f"  {date_str}  {os.path.relpath(path, root)}")
            print()

    _open_in_editor(file_path)
    return 0


def _journal_interactive(root):
    """fzf-based picker over journal entries: pick one (with a live content
    preview) to open in $EDITOR. Today is included even if it doesn't exist yet
    (tagged "new"), so this always offers a way to start today's entry too --
    same two-stage-friendly shape as the other pickers, minus the action step,
    since there's only one thing to do with a journal entry: open it."""
    today = datetime.now().date()
    today_iso = today.isoformat()
    entries = list_journal_entries(root)
    if today_iso not in {d for d, _ in entries}:
        entries = [(today_iso, _journal_path(root, today))] + entries

    on_this_day = _on_this_day(root, today)
    lines = [f"{date_str}\t{label}\t{path}" for label, date_str, path in on_this_day]
    for date_str, path in entries:
        tag = "new" if not os.path.exists(path) else ""
        lines.append(f"{date_str}\t{tag}\t{path}")

    selected = _fzf_select(lines, "journal> ", "enter: open this entry (created if new)",
                            delimiter="\t", with_nth="1,2",
                            preview_cmd="cat {3} 2>/dev/null || echo '(no entry yet)'")
    if selected is None:
        return 0  # cancelled

    date_str = selected.split("\t", 1)[0].strip()
    target = datetime.strptime(date_str, "%Y-%m-%d").date()
    file_path = _ensure_journal_entry(root, target)
    _open_in_editor(file_path)
    return 0


def _journal_by_tag(root, tag):
    """List journal entries carrying `tag`, newest first -- browsing a theme
    across time (e.g. everything tagged "homelab") rather than kb search's
    relevance ranking, which scatters same-theme entries by match strength
    instead of keeping them in chronological order."""
    matches = []
    for date_str, path in list_journal_entries(root):
        fm, _ = pc.read_entry(path)
        if tag in (fm.get("tags") or []):
            matches.append((date_str, path))

    if not matches:
        print(f"no journal entries tagged '{tag}'")
        return 0
    for date_str, path in matches:
        print(f"{date_str}  {os.path.relpath(path, root)}")
    return 0


def _rollup_month(month_arg):
    """(year, month) for `month_arg` (YYYY-MM), or the previous calendar month
    if not given -- the current month is usually still in progress, so it's a
    poor default for "summarize what happened"."""
    if month_arg:
        try:
            dt = datetime.strptime(month_arg, "%Y-%m")
        except ValueError:
            return None
        return dt.year, dt.month
    today = datetime.now().date()
    year, month = today.year, today.month - 1
    if month == 0:
        year, month = year - 1, 12
    return year, month


def _journal_rollup(root, month_arg):
    """Generate/refresh reference/journal-summaries/YYYY-MM.md: every day's
    entry in the month concatenated under a heading, plus a tag-frequency line,
    so a month of daily files can be browsed as one page instead of opened one
    by one. Deliberately not AI summarization -- just the raw entries assembled
    in one place; the point is browsability, not compression."""
    parsed = _rollup_month(month_arg)
    if parsed is None:
        print(f"error: invalid month '{month_arg}' -- expected YYYY-MM", file=sys.stderr)
        return 1
    year, month = parsed
    month_label = f"{year:04d}-{month:02d}"

    month_dir = os.path.join(root, "journal", f"{year:04d}", f"{month:02d}")
    if not os.path.isdir(month_dir):
        print(f"no journal entries found for {month_label}")
        return 1

    days = []
    for name in sorted(os.listdir(month_dir)):
        if not name.endswith(".md"):
            continue
        fm, body = pc.read_entry(os.path.join(month_dir, name))
        days.append((name[:-3], fm, body))
    if not days:
        print(f"no journal entries found for {month_label}")
        return 1

    tag_counts, day_ids, sections = {}, [], []
    for date_str, fm, body in days:
        if fm.get("id"):
            day_ids.append(fm["id"])
        for t in fm.get("tags") or []:
            tag_counts[t] = tag_counts.get(t, 0) + 1

        text = body.strip("\n")
        heading = f"# {date_str}"
        if text.startswith(heading):
            text = text[len(heading):].lstrip("\n")
        sections.append(f"## {date_str}\n\n{text.strip() or '(no content)'}\n")

    out_path = os.path.join(root, "reference", "journal-summaries", f"{month_label}.md")
    now = pc.now_iso()
    existing_fm = pc.read_entry(out_path)[0] if os.path.exists(out_path) else None
    if existing_fm and existing_fm.get("id"):
        entry_id, created = existing_fm["id"], existing_fm.get("created", now)
    else:
        entry_id = pc.gen_id(pc.collect_existing_ids(root), dt=datetime(year, month, 1))
        created = now

    fm = {
        "id": entry_id,
        "created": created,
        "updated": now,
        "type": "reference",
        "extension": None,
        "source": "manual",
        "source_id": None,
        "tags": ["journal-summary"],
        "links": day_ids,
        "title": f"Journal summary: {month_label}",
    }

    body = f"# Journal summary: {month_label}\n\n{len(days)} entries.\n"
    if tag_counts:
        top = sorted(tag_counts.items(), key=lambda kv: (-kv[1], kv[0]))
        body += "tags: " + ", ".join(f"{t} ({n})" for t, n in top) + "\n"
    body += "\n---\n\n" + "\n".join(sections)

    pc.write_entry(out_path, fm, body)
    run_script("index_fts.py")
    print(out_path)
    return 0


def cmd_inbox(args):
    root = pc.get_repo_root()
    inbox_dir = os.path.join(root, "inbox")

    if args.id is not None:
        return _inbox_act(root, inbox_dir, args)

    now = datetime.now().astimezone()
    files = sorted(
        f for f in os.listdir(inbox_dir) if f.endswith(".md")
    ) if os.path.isdir(inbox_dir) else []
    if not files:
        print("inbox is empty")
        return 0

    items = []
    for name in files:
        path = os.path.join(inbox_dir, name)
        try:
            fm, _ = pc.read_entry(path)
            created = fm.get("created")
            title = fm.get("title") or name
        except ValueError:
            created = None
            title = name
        created_dt = pc.parse_iso(created)
        age = (now - created_dt).days if created_dt else "?"
        items.append((name, age, title))

    interactive = not args.plain and shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()
    if interactive:
        return _inbox_interactive(root, items)

    for name, age, title in items:
        print(f"{age!s:>4}d  {name:<30} {title}")
    if not shutil.which("fzf"):
        print("\n(install fzf for an interactive picker: promote/redirect/discard)")
    return 0


def _inbox_act(root, inbox_dir, args):
    """Non-interactive triage: `kb inbox <id> promote|redirect|discard`. The
    only way to resolve an inbox item when fzf/a real terminal aren't
    available -- e.g. scripted use or an AI agent driving kb, neither of which
    ever gets the interactive picker."""
    if args.action is None:
        print(f"error: `kb inbox {args.id}` needs an action: promote <type> | redirect | discard",
              file=sys.stderr)
        return 1
    found = _inbox_find(inbox_dir, args.id)
    if found is None:
        print(f"error: no inbox item with id '{args.id}'", file=sys.stderr)
        return 1
    path, fm, body = found

    if args.action == "promote":
        if not args.type:
            print(f"error: `kb inbox {args.id} promote` needs a Diataxis type: {', '.join(pc.CORE_TYPES)}",
                  file=sys.stderr)
            return 1
        return _inbox_promote(root, path, fm, body, args.type)
    elif args.action == "redirect":
        return _inbox_redirect(root, path, fm, body)
    else:
        return _inbox_discard(root, path)


def _inbox_promote(root, path, fm, body, target_type):
    """Move an inbox item into core content as `target_type`, clearing
    `extension`. Shared by the interactive picker and non-interactive
    `kb inbox <id> promote <type>`."""
    title = fm.get("title") or os.path.basename(path)
    fm["type"] = target_type
    fm["extension"] = None
    fm["updated"] = pc.now_iso()
    new_path = os.path.join(root, pc.TYPE_DIR[target_type], f"{fm['id']}-{pc.slugify(title)}.md")
    pc.write_entry(new_path, fm, body)
    os.remove(path)
    print(f"promoted -> {os.path.relpath(new_path, root)}")
    run_script("index_fts.py")
    return 0


def _inbox_redirect(root, path, fm, body):
    """Append an inbox item into its created-date's journal entry (creating
    that entry first if needed) and remove it from inbox/. Shared by the
    interactive picker and non-interactive `kb inbox <id> redirect`."""
    title = fm.get("title") or os.path.basename(path)
    created_dt = pc.parse_iso(fm.get("created")) or datetime.now().astimezone()
    journal_dir = os.path.join(root, "journal", f"{created_dt.year:04d}", f"{created_dt.month:02d}")
    journal_path = os.path.join(journal_dir, f"{created_dt.date().isoformat()}.md")
    if not os.path.exists(journal_path):
        all_ids = pc.collect_existing_ids(root)
        jid = pc.gen_id(all_ids, dt=created_dt)
        now_s = pc.now_iso()
        jfm = {
            "id": jid, "created": now_s, "updated": now_s,
            "type": "journal", "extension": "journal", "source": "manual",
            "source_id": None, "tags": [], "links": [],
            "title": created_dt.date().isoformat(),
        }
        pc.write_entry(journal_path, jfm, f"# {created_dt.date().isoformat()}\n\n")
    with open(journal_path, "r", encoding="utf-8") as f:
        existing = f.read()
    with open(journal_path, "w", encoding="utf-8") as f:
        f.write(existing.rstrip("\n") + f"\n\n## {title}\n\n{body.strip()}\n")
    os.remove(path)
    print(f"redirected -> {os.path.relpath(journal_path, root)}")
    run_script("index_fts.py")
    return 0


def _inbox_discard(root, path):
    name = os.path.basename(path)
    os.remove(path)
    print(f"discarded {name}")
    run_script("index_fts.py")
    return 0


def _inbox_find(inbox_dir, item_id):
    """(path, fm, body) for the inbox item with this id, or None. Inbox items
    are addressed by id here, same as kb tag/kb link, not by filename."""
    if not os.path.isdir(inbox_dir):
        return None
    for name in os.listdir(inbox_dir):
        if not name.endswith(".md"):
            continue
        path = os.path.join(inbox_dir, name)
        try:
            fm, body = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id") == item_id:
            return path, fm, body
    return None


def _inbox_interactive(root, items):
    """fzf-based triage: select an item (live content preview), then promote
    (choose a Diataxis type, moved there with extension cleared), redirect
    (appended into that day's journal entry, per its created date), or discard.
    Every inbox item must end in one of exactly these three states (spec S5) --
    this is what lets kb inbox actually resolve that, not just report on it."""
    inbox_dir = os.path.join(root, "inbox")
    lines = []
    for name, age, title in items:
        lines.append(f"{name}\t{age}d\t{title}")

    preview_cmd = f"cat {shlex.quote(inbox_dir)}/{{1}}"
    selected = _fzf_select(lines, "inbox> ", "enter: promote / redirect / discard this item",
                            delimiter="\t", with_nth="1,2,3", preview_cmd=preview_cmd)
    if selected is None:
        return 0  # cancelled
    chosen_name = selected.split("\t", 1)[0].strip()
    chosen_path = os.path.join(inbox_dir, chosen_name)
    fm, body = pc.read_entry(chosen_path)
    title = fm.get("title") or chosen_name

    choice = _fzf_select(["promote", "redirect", "discard", "cancel"],
                          f"{chosen_name}> ", f"{title} -- promote/redirect/discard/cancel")
    if choice is None or choice == "cancel":
        return 0

    if choice == "promote":
        target_type = _fzf_select(pc.CORE_TYPES, "type> ", "promote to which Diataxis type?")
        if target_type is None:
            return 0
        return _inbox_promote(root, chosen_path, fm, body, target_type)
    elif choice == "redirect":
        return _inbox_redirect(root, chosen_path, fm, body)
    elif choice == "discard":
        return _inbox_discard(root, chosen_path)
    return 0


def cmd_triage(args):
    return run_script("triage_report.py", ["--json"] if args.json else [])


def cmd_sync(args):
    scripts = {
        "memos": "sync_memos.py",
        "gitlab": "sync_gitlab.py",
        "beads": "sync_beads.py",
    }
    # memos/gitlab read credentials from the environment; if this data repo keeps
    # them sops-encrypted, decrypt straight into that one subprocess's env via
    # `sops exec-env` -- no wrapping needed at the call site, and the values never
    # pass through kb's own environment or output. beads has no secret to inject.
    targets = list(scripts.keys()) if args.source in (None, "all") else [args.source]
    root = pc.get_repo_root()
    secrets_path = os.path.join(root, ".pkb", "secrets.enc.env")
    use_sops = shutil.which("sops") and os.path.exists(secrets_path)

    rc = 0
    for t in targets:
        print(f"--- sync: {t} ---")
        script_path = os.path.join(SCRIPT_DIR, scripts[t])
        if use_sops and t in ("memos", "gitlab"):
            cmd_str = f"{shlex.quote(sys.executable)} {shlex.quote(script_path)}"
            result = subprocess.run(["sops", "exec-env", secrets_path, cmd_str], env=sops_key_env())
        else:
            result = subprocess.run([sys.executable, script_path])
        rc = result.returncode or rc
    return rc


def cmd_index(args):
    return run_script("index_fts.py", ["--full"] if args.full else [])


def cmd_validate(args):
    return run_script("validate_frontmatter.py")


def _find_entry(root, entry_id):
    """(path, fm, body) for the entry with this id, or None. Shared by kb tag and
    kb link -- both need to locate and rewrite one specific entry by id, the only
    sanctioned way to touch tags/links now that hand-editing frontmatter is off
    limits (see SKILL.md's "never hand-edit frontmatter" rule)."""
    for path in pc.iter_markdown_files(root):
        try:
            fm, body = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id") == entry_id:
            return path, fm, body
    return None


def _apply_tag_changes(tags, add=None, rm=None):
    """Pure list transform: apply add/rm to a list, returning (new_list,
    changed) -- the only place the actual add/rm set-diff logic lives. Used
    for both tags and links (the semantics are identical: dedup on add, drop
    on rm), via entry_set_tags/entry_set_links."""
    new_tags = list(tags)
    changed = False
    if add:
        additions = [t for t in add if t not in new_tags]
        new_tags.extend(additions)
        changed = changed or bool(additions)
    if rm:
        before = len(new_tags)
        new_tags = [t for t in new_tags if t not in rm]
        changed = changed or before != len(new_tags)
    return new_tags, changed


def _clean_list(items):
    """Strip whitespace, drop blanks, and dedupe (order-preserving) --
    shared by entry_new so every caller gets the same tags/links hygiene
    regardless of whether its input arrived pre-cleaned (CLI comma-split
    args) or raw (a JSON POST body)."""
    seen = set()
    cleaned = []
    for item in items or []:
        item = item.strip()
        if item and item not in seen:
            seen.add(item)
            cleaned.append(item)
    return cleaned


def entry_new(root, entry_type, title, tags=None, links=None, body=None):
    """Create a new core-content entry (tutorial/how-to/reference/explanation)
    with correct frontmatter, write it to disk, and reindex. Returns
    {"id", "path"} for the created entry, or {"error": ...} if `entry_type`
    is invalid or `links` names id(s) that don't exist in this repo. Shared
    by cmd_new (CLI) and kb web's entry-creation endpoint."""
    if entry_type not in pc.CORE_TYPES:
        return {"error": f"type must be one of {list(pc.CORE_TYPES)}"}

    tags = _clean_list(tags)
    links = _clean_list(links)

    # kb web's server is threaded, so two POST /api/entries calls (or a web
    # create racing a CLI `kb new`) can otherwise both scan existing ids,
    # both land in the same gen_id() minute bucket, and both write the same
    # path -- the second write silently clobbering the first entry. Serialize
    # the scan-through-write on a repo-level lock (there's no entry file yet
    # to lock on, unlike entry_set_tags/entry_set_links/entry_update_content).
    pkb_dir = os.path.join(root, ".pkb")
    os.makedirs(pkb_dir, exist_ok=True)
    with pc.entry_lock(os.path.join(pkb_dir, "entry-new")):
        all_ids = pc.collect_existing_ids(root)
        unknown = [t for t in links if t not in all_ids]
        if unknown:
            return {"error": f"unknown link target id(s), not found in this repo: {', '.join(unknown)}"}

        entry_id = pc.gen_id(all_ids)
        now = pc.now_iso()
        fm = {
            "id": entry_id,
            "created": now,
            "updated": now,
            "type": entry_type,
            "extension": None,
            "source": "manual",
            "source_id": None,
            "tags": tags,
            "links": links,
            "title": title,
        }
        path = os.path.join(root, pc.TYPE_DIR[entry_type], f"{entry_id}-{pc.slugify(title)}.md")
        entry_body = f"# {title}\n\n{body.strip()}\n" if body else f"# {title}\n\n"
        pc.write_entry(path, fm, entry_body)
        _reindex_fast(root)
    return {"id": entry_id, "path": path}


def entry_set_tags(root, entry_id, add=None, rm=None):
    """Apply add/rm to an entry's tags and persist if anything changed.
    Returns the resulting tag list, or None if no entry has this id. Shared
    by cmd_tag (CLI) and kb web's tag-edit endpoint."""
    found = _find_entry(root, entry_id)
    if found is None:
        return None
    path, _fm, _body = found
    with pc.entry_lock(path):
        fm, body = pc.read_entry(path)
        tags, changed = _apply_tag_changes(fm.get("tags") or [], add=add, rm=rm)
        if changed:
            fm["tags"] = tags
            fm["updated"] = pc.now_iso()
            pc.write_entry(path, fm, body)
            _reindex_fast(root)
    return tags


def entry_set_links(root, entry_id, add=None, rm=None):
    """Same as entry_set_tags but for links. Returns the resulting link list;
    None if no entry has this id; {"error": ...} if `add` names id(s) that
    don't exist in the repo. Shared by cmd_link (CLI) and kb web's link-edit
    endpoint."""
    found = _find_entry(root, entry_id)
    if found is None:
        return None
    path, _fm, _body = found
    if add:
        all_ids = pc.collect_existing_ids(root)
        unknown = [t for t in add if t not in all_ids]
        if unknown:
            return {"error": f"unknown id(s), not found in this repo: {', '.join(unknown)}"}
    with pc.entry_lock(path):
        fm, body = pc.read_entry(path)
        links, changed = _apply_tag_changes(list(fm.get("links") or []), add=add, rm=rm)
        if changed:
            fm["links"] = links
            fm["updated"] = pc.now_iso()
            pc.write_entry(path, fm, body)
            _reindex_fast(root)
    return links


def entry_update_content(root, entry_id, title=None, body=None):
    """Overwrite an entry's title and/or body and persist if anything changed.
    Returns {"title", "body"} for the resulting entry, or None if no entry has
    this id. Shared by kb web's content-edit endpoint (no CLI counterpart yet
    -- editing full content is currently a web-only affordance)."""
    found = _find_entry(root, entry_id)
    if found is None:
        return None
    path, _fm, _body = found
    with pc.entry_lock(path):
        fm, cur_body = pc.read_entry(path)
        changed = False
        if title is not None and title != fm.get("title"):
            fm["title"] = title
            changed = True
        if body is not None and body != cur_body:
            cur_body = body
            changed = True
        if changed:
            fm["updated"] = pc.now_iso()
            pc.write_entry(path, fm, cur_body)
            _reindex_fast(root)
    return {"title": fm.get("title"), "body": cur_body}


def inbox_list(root):
    """[{"id", "name", "title", "age_days", "created"}, ...] for everything in
    inbox/, sorted by filename -- the data behind `kb inbox`'s plain listing.
    Kept separate from cmd_inbox's own listing loop (which feeds items as bare
    tuples into the fzf interactive picker) so this can return a clean,
    JSON-friendly shape for kb web's /api/inbox without disturbing that path."""
    inbox_dir = os.path.join(root, "inbox")
    now = datetime.now().astimezone()
    files = sorted(f for f in os.listdir(inbox_dir) if f.endswith(".md")) if os.path.isdir(inbox_dir) else []
    items = []
    for name in files:
        path = os.path.join(inbox_dir, name)
        try:
            fm, _ = pc.read_entry(path)
            created, title, entry_id = fm.get("created"), fm.get("title") or name, fm.get("id")
        except ValueError:
            created, title, entry_id = None, name, None
        created_dt = pc.parse_iso(created)
        age_days = (now - created_dt).days if created_dt else None
        items.append({"id": entry_id, "name": name, "title": title, "age_days": age_days, "created": created})
    return items


def _iter_all_entries(root):
    """[{id, title, type, path}] for every entry in the repo (core + journal/
    inbox/sources) -- shared by the tag/link pickers below, which need to offer
    any entry as a target, not just core Diataxis content."""
    entries = []
    for path in pc.iter_markdown_files(root):
        try:
            fm, _ = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id"):
            entries.append({"id": fm["id"], "title": fm.get("title") or "",
                             "type": fm.get("type") or "", "path": path})
    entries.sort(key=lambda e: e["id"], reverse=True)
    return entries


def _all_tags(root):
    """Sorted set of every tag currently used anywhere in the repo -- offered as
    the pick list when adding a tag interactively, alongside the option to type
    a new one."""
    tags = set()
    for path in pc.iter_markdown_files(root):
        try:
            fm, _ = pc.read_entry(path)
        except ValueError:
            continue
        tags.update(fm.get("tags") or [])
    return sorted(tags)


def _entry_fzf_lines(entries):
    return [f"{e['id']}\t{e['type']}\t{e['title']}\t{e['path']}" for e in entries]


def _pick_entry(root, prompt, header, exclude_ids=()):
    """fzf picker over every entry in the repo, returning the chosen id (or None
    if cancelled/unavailable) -- used when `kb tag`/`kb link` are invoked with no
    id, so the id doesn't have to be hunted down by hand first."""
    entries = [e for e in _iter_all_entries(root) if e["id"] not in exclude_ids]
    if not entries:
        return None
    selected = _fzf_select(_entry_fzf_lines(entries), prompt, header, delimiter="\t",
                            with_nth="1,2,3", preview_cmd="cat {4}")
    return selected.split("\t")[0] if selected else None


def _pick_entries_multi(root, prompt, header, candidate_ids):
    """fzf multi-select picker restricted to `candidate_ids`, returning the
    chosen ids or None. Used for `kb link add` (candidates = every id not
    already linked, minus self)."""
    entries = [e for e in _iter_all_entries(root) if e["id"] in candidate_ids]
    if not entries:
        return None
    picked = _fzf_select(_entry_fzf_lines(entries), prompt, header, delimiter="\t",
                          with_nth="1,2,3", preview_cmd="cat {4}", multi=True)
    return [line.split("\t")[0] for line in picked] if picked else None


def _pick_tags_to_add(root, prompt, header):
    """fzf picker for `kb tag add` with no tags given: tab to multi-select from
    every tag already used in the repo, or type one or more new comma-separated
    tags and press enter with nothing selected to create them. Returns a list
    of tags, or None if cancelled."""
    cmd = ["fzf", "--multi", "--print-query", "--prompt", prompt, "--header", header]
    result = subprocess.run(cmd, input="\n".join(_all_tags(root)), text=True, stdout=subprocess.PIPE)
    if result.returncode == 130:
        return None  # esc / ctrl-c
    lines = result.stdout.split("\n")
    query, selected = lines[0], [l for l in lines[1:] if l.strip()]
    if selected:
        return selected
    if query.strip():
        return [t.strip() for t in query.split(",") if t.strip()]
    return None


def cmd_tag(args):
    """Add/remove tags on an entry -- the only sanctioned way to change `tags`,
    since hand-editing frontmatter is off limits. With no action, just list the
    entry's current tags.

    Anything left unspecified on the command line -- the id, or the tags to
    add/remove -- is filled in with an fzf picker when one is available
    (installed + both ends real terminals), same rule as every other
    interactive picker in this file."""
    root = pc.get_repo_root()
    interactive = shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()

    entry_id = args.id
    if entry_id is None:
        if not interactive:
            print("error: `kb tag` needs an entry id (install fzf and run from a "
                  "terminal for a picker)", file=sys.stderr)
            return 1
        entry_id = _pick_entry(root, "tag> ", "select an entry to tag")
        if entry_id is None:
            return 0  # cancelled, or nothing to pick from

    found = _find_entry(root, entry_id)
    if found is None:
        print(f"error: no entry with id '{entry_id}'", file=sys.stderr)
        return 1
    path, fm, body = found
    tags = list(fm.get("tags") or [])

    if args.action is None:
        print(", ".join(tags) if tags else "(no tags)")
        return 0

    values = args.values
    if not values:
        if not interactive:
            print(f"error: `kb tag {entry_id} {args.action}` needs at least one tag",
                  file=sys.stderr)
            return 1
        if args.action == "add":
            values = _pick_tags_to_add(
                root, "add tag> ",
                "tab: multi-select existing tags -- or type new ones (comma-separated) and enter")
        else:
            if not tags:
                print(f"no tags to remove on {entry_id}")
                return 0
            values = _fzf_select(tags, "rm tag> ", "tab: multi-select tags to remove", multi=True)
        if not values:
            return 0  # cancelled

    tags = entry_set_tags(root, entry_id, add=values if args.action == "add" else None,
                           rm=values if args.action == "rm" else None)
    changed = tags != (fm.get("tags") or [])
    prefix = "" if changed else "no change -- "
    print(f"{prefix}tags for {entry_id}: {', '.join(tags) if tags else '(none)'}")
    return 0


def cmd_link(args):
    """Add/remove forward links on an entry -- the only sanctioned way to change
    `links`, since hand-editing frontmatter is off limits. With no action, show
    forward links + backlinks (same as kb links).

    Anything left unspecified on the command line -- the id, or the target
    ids to add/remove -- is filled in with an fzf picker when one is
    available, same rule as kb tag."""
    root = pc.get_repo_root()
    interactive = shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()

    entry_id = args.id
    if entry_id is None:
        if not interactive:
            print("error: `kb link` needs an entry id (install fzf and run from a "
                  "terminal for a picker)", file=sys.stderr)
            return 1
        entry_id = _pick_entry(root, "link> ", "select an entry to link")
        if entry_id is None:
            return 0

    if args.action is None:
        return show_links(root, entry_id, json_out=args.json)

    found = _find_entry(root, entry_id)
    if found is None:
        print(f"error: no entry with id '{entry_id}'", file=sys.stderr)
        return 1
    path, fm, body = found
    links = list(fm.get("links") or [])

    values = args.values
    if not values:
        if not interactive:
            print(f"error: `kb link {entry_id} {args.action}` needs at least one target id",
                  file=sys.stderr)
            return 1
        if args.action == "add":
            candidate_ids = {e["id"] for e in _iter_all_entries(root)} - {entry_id} - set(links)
            values = _pick_entries_multi(root, "add link> ",
                                          "tab: multi-select entries to link to", candidate_ids)
        else:
            if not links:
                print(f"no links to remove on {entry_id}")
                return 0
            values = _fzf_select(links, "rm link> ", "tab: multi-select links to remove", multi=True)
        if not values:
            return 0

    result = entry_set_links(root, entry_id, add=values if args.action == "add" else None,
                              rm=values if args.action == "rm" else None)
    if isinstance(result, dict):  # {"error": "unknown id(s) ..."}
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    changed = result != links
    prefix = "" if changed else "no change -- "
    print(f"{prefix}links for {entry_id}: {', '.join(result) if result else '(none)'}")
    return 0


def show_links(root, target_id, json_out=False):
    """Print forward links + backlinks for an entry. Shared by cmd_links and the
    interactive search picker's 'links' action."""
    forward = None
    backlinks = []
    target_path = None

    for path in pc.iter_markdown_files(root):
        try:
            fm, _ = pc.read_entry(path)
        except ValueError:
            continue
        if fm.get("id") == target_id:
            forward = fm.get("links") or []
            target_path = os.path.relpath(path, root)
        if target_id in (fm.get("links") or []):
            backlinks.append((fm.get("id"), fm.get("title"), os.path.relpath(path, root)))

    if forward is None:
        if json_out:
            print(f'{{"error": "no entry with id \'{target_id}\'"}}', file=sys.stderr)
        else:
            print(f"error: no entry with id '{target_id}'", file=sys.stderr)
        return 1

    if json_out:
        import json
        print(json.dumps({
            "id": target_id,
            "path": target_path,
            "forward": forward,
            "backlinks": [{"id": lid, "title": title, "path": path} for lid, title, path in backlinks],
        }))
        return 0

    print(f"{target_id}  ({target_path})")
    print(f"\nforward links ({len(forward)}):")
    for link_id in forward:
        print(f"  -> {link_id}")
    print(f"\nbacklinks ({len(backlinks)}):")
    for link_id, title, path in backlinks:
        print(f"  <- {link_id}  {title}  ({path})")
    return 0


def cmd_links(args):
    root = pc.get_repo_root()
    return show_links(root, args.id, json_out=args.json)


def cmd_show(args):
    """Print an entry's full content by id -- the id-addressed counterpart to
    kb search/kb links, for when you already know the id and just want the
    content without looking up its path first."""
    root = pc.get_repo_root()
    found = _find_entry(root, args.id)
    if found is None:
        print(f"error: no entry with id '{args.id}'", file=sys.stderr)
        return 1
    path, fm, body = found

    if args.json:
        import json
        print(json.dumps({"id": args.id, "path": os.path.relpath(path, root),
                           "frontmatter": fm, "body": body}))
        return 0

    with open(path, "r", encoding="utf-8") as f:
        sys.stdout.write(f.read())
    return 0


def bd_available():
    return shutil.which("bd") is not None


def bd_list(root, include_all=False):
    """Open (or all, with include_all) bd issues as parsed JSON, sorted by
    priority. Raises RuntimeError(stderr) if bd itself errors. Shared by
    cmd_todo's non-add path and kb web's GET /api/todo."""
    bd_args = ["bd", "-C", root, "list", "--json", "--sort", "priority", "--limit", "0"]
    if include_all:
        bd_args.append("--all")
    result = subprocess.run(bd_args, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())
    return json.loads(result.stdout)


def bd_create(root, title, description=None, priority="2", issue_type="task", labels=None):
    """Create a bd issue, returning bd's own confirmation text. Raises
    RuntimeError(stderr) on failure. Shared by _todo_add (kb todo -a TITLE)
    and kb web's POST /api/todo."""
    bd_args = ["bd", "-C", root, "create", "--title", title, "--type", issue_type, "--priority", priority]
    if description:
        bd_args += ["--description", description]
    if labels:
        bd_args += ["--labels", labels]
    result = subprocess.run(bd_args, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())
    return result.stdout.strip()


def bd_action(root, action, issue_id, comment_text=None):
    """Run `bd show|close|comment` for one issue, returning bd's own stdout.
    Raises RuntimeError(stderr) on failure. Used by kb web's todo action
    endpoint -- the CLI's interactive picker (_todo_interactive) calls bd
    directly via subprocess instead, since it streams straight to the
    terminal rather than needing a return value."""
    bd_args = ["bd", "-C", root, action, issue_id]
    if action == "comment":
        bd_args.append(comment_text or "")
    result = subprocess.run(bd_args, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())
    return result.stdout.strip()


def cmd_todo(args):
    if not shutil.which("bd"):
        print("bd CLI not found -- install it (`brew install beads`) to track TODOs. "
              "See `kb doctor`.", file=sys.stderr)
        return 1

    root = pc.get_repo_root()

    if args.add is not None:
        return _todo_add(root, args)

    try:
        issues = bd_list(root, include_all=args.all)
    except RuntimeError as e:
        print(f"error: bd list failed: {e}", file=sys.stderr)
        return 1

    if args.json:
        import json
        print(json.dumps(issues))
        return 0

    if not issues:
        print("no open todos" if not args.all else "no todos")
        return 0

    # interactive by default when the tooling supports it: fzf installed, and both
    # ends are real terminals (not piped/redirected -- a script consuming `kb todo`
    # output must keep getting the plain list). --plain forces the old behavior.
    interactive = not args.plain and shutil.which("fzf") and sys.stdout.isatty() and sys.stdin.isatty()
    if interactive:
        return _todo_interactive(root, issues)

    for i in issues:
        status = f" [{i['status']}]" if args.all and i["status"] != "open" else ""
        print(f"{i['id']:<10} P{i['priority']}  {i['title']}{status}")

    example = issues[0]["id"]
    hint = f"\nact on one: kb bd show {example}  |  kb bd close {example}  |  kb bd comment {example} \"...\""
    if not shutil.which("fzf"):
        hint += "  (install fzf for an interactive picker)"
    print(hint)
    return 0


def _todo_add(root, args):
    """Create a new TODO. With a title, this is a one-shot `bd create` -- fast to
    fire off, but still takes --description/--priority/--type/--labels so it can
    carry as much ticket-shaped detail as you want in one line. With no title
    (`kb todo -a`), hand off to bd's own interactive form instead of reinventing
    it -- that already prompts for every field a ticket needs."""
    if not args.add:
        os.execvp("bd", ["bd", "-C", root, "create-form"])  # replaces this process

    try:
        output = bd_create(root, args.add, description=args.description,
                            priority=args.priority, issue_type=args.type, labels=args.labels)
    except RuntimeError as e:
        print(f"error: bd create failed: {e}", file=sys.stderr)
        return 1
    print(output)
    return 0


def _todo_interactive(root, issues):
    """fzf-based picker: select an item (with a live `bd show` preview), then an
    action. Falls back to nothing fancy for the action step -- another small fzf
    menu, since that's the same tool the user just used to pick the item."""
    lines, by_id = [], {}
    for i in issues:
        status = f" [{i['status']}]" if i["status"] != "open" else ""
        lines.append(f"{i['id']}\tP{i['priority']}\t{i['title']}{status}")
        by_id[i["id"]] = i

    preview_cmd = f"bd -C {shlex.quote(root)} show {{1}}"
    selected = _fzf_select(lines, "todo> ", "enter: choose an action for this item",
                            delimiter="\t", with_nth="1,2,3", preview_cmd=preview_cmd)
    if selected is None:
        return 0  # cancelled (esc / ctrl-c)
    chosen_id = selected.split("\t", 1)[0].strip()
    chosen = by_id.get(chosen_id)

    choice = _fzf_select(["show", "close", "comment", "cancel"], f"{chosen_id}> ",
                          f"{chosen['title'] if chosen else chosen_id} -- choose an action")
    if choice is None:
        return 0

    if choice == "show":
        subprocess.run(["bd", "-C", root, "show", chosen_id])
    elif choice == "close":
        subprocess.run(["bd", "-C", root, "close", chosen_id])
    elif choice == "comment":
        text = input(f"comment on {chosen_id}: ").strip()
        if text:
            subprocess.run(["bd", "-C", root, "comment", chosen_id, text])
    return 0


def cmd_bd(args):
    """Passthrough to `bd`, pointed at the resolved data repo root via -C -- so
    every other bd action (show/close/comment/create/update/...) works from
    anywhere the same way `kb todo` does, without hand-wrapping each one."""
    if not shutil.which("bd"):
        print("bd CLI not found -- install it (`brew install beads`).", file=sys.stderr)
        return 1
    root = pc.get_repo_root()
    result = subprocess.run(["bd", "-C", root, *args.bd_args])
    return result.returncode


def cmd_secrets(args):
    """Open the resolved data repo's encrypted secrets file in sops, creating it
    (per .sops.yaml) on first run. Hands off to sops entirely via exec -- it needs
    real interactive control to spawn $EDITOR, same reasoning as `kb journal`'s
    EDITOR handoff. The real secret values never pass through kb or this process:
    sops decrypts straight into the editor and re-encrypts straight from it."""
    if not shutil.which("sops"):
        print("sops CLI not found -- install it to manage encrypted credentials "
              "(e.g. `brew install sops`), or export PKB_MEMOS_URL/PKB_MEMOS_TOKEN/"
              "PKB_GITLAB_PROJECT directly instead.", file=sys.stderr)
        return 1
    root = pc.get_repo_root()
    sops_config = os.path.join(root, ".sops.yaml")
    if not os.path.exists(sops_config):
        print(f"error: no .sops.yaml in {root} -- this data repo isn't set up for sops-encrypted "
              f"secrets yet. See pkb-cli's templates/secrets.env.example and README.", file=sys.stderr)
        return 1
    secrets_path = os.path.join(root, ".pkb", "secrets.enc.env")
    # sops discovers .sops.yaml relative to cwd, not the target file's path -- pass
    # it explicitly so this works regardless of where kb secrets was actually run
    # from (the whole point of resolving `root` in the first place). Re-editing an
    # existing file also needs the *private* key (sops_key_env), not just the
    # public recipient in .sops.yaml -- only first-time creation gets away without it.
    env = sops_key_env()
    if "EDITOR" not in env:
        editor = pc.get_editor()
        if editor:
            env["EDITOR"] = editor
    os.execvpe("sops", ["sops", "--config", sops_config, secrets_path], env)


def cmd_config(args):
    if args.value is None:
        env_editor = os.environ.get("EDITOR")
        if env_editor:
            print(f"editor: {env_editor}  (from $EDITOR)")
        else:
            saved = pc.load_kb_config().get("editor")
            print(f"editor: {saved}  (saved in {pc.kb_config_path()})" if saved else "editor: not set")
        return 0

    if pc.split_editor(args.value) is None:
        print(f"error: '{args.value}' doesn't look like a usable editor command "
              f"(empty, or can't be parsed -- check quoting)", file=sys.stderr)
        return 1

    cfg = pc.load_kb_config()
    cfg["editor"] = args.value
    pc.save_kb_config(cfg)
    print(f"saved -- kb will use '{args.value}' whenever $EDITOR isn't set")
    pc.warn_if_editor_missing(args.value)
    return 0


def find_install_dir():
    """Return (dir, already_on_path). Prefers a candidate already on PATH; falls
    back to ~/.local/bin (created if needed) so --install always succeeds on a
    completely fresh machine, just with a note to update PATH."""
    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    candidates = (os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin")
    for candidate in candidates:
        if os.path.isdir(candidate) and candidate in path_dirs:
            return candidate, True
    return os.path.expanduser("~/.local/bin"), False


# --- shared status checks, used by both `kb setup` (which acts on them) and
# `kb doctor` (which only reports) -- one place to know how to detect each
# piece of state so the two commands can't drift apart on what "ok" means.

HOOK_MARKER = "# pkb-managed-hook"


def hook_expected_content():
    validate_path = os.path.join(SCRIPT_DIR, "validate_frontmatter.py")
    content = (
        "#!/bin/sh\n"
        f"{HOOK_MARKER} -- regenerated by `kb setup`, do not hand-edit\n"
        f'exec "{sys.executable}" "{validate_path}"\n'
    )
    return content, validate_path


def read_hook(root):
    hook_path = os.path.join(root, ".git", "hooks", "pre-commit")
    if os.path.exists(hook_path):
        with open(hook_path, "r", encoding="utf-8") as f:
            return hook_path, f.read()
    return hook_path, None


def hook_managed_validate_path(content):
    """Extract the validate_frontmatter.py path baked into a kb-managed hook's
    `exec "<python>" "<path>"` line, or None if content isn't ours."""
    if not content or HOOK_MARKER not in content:
        return None
    parts = content.split('"')
    return parts[3] if len(parts) > 3 else None


def tool_status():
    status = {t: shutil.which(t) is not None for t in ("bd", "sops", "glab", "rg", "fzf")}
    status["glab_auth"] = (
        subprocess.run(["glab", "auth", "status"], capture_output=True).returncode == 0
        if status["glab"] else False
    )
    return status


def index_status(root):
    return os.path.join(root, ".pkb", "fts.db")


def bd_store_status(root):
    store_exists = os.path.isdir(os.path.join(root, ".beads"))
    exclude_path = os.path.join(root, ".git", "info", "exclude")
    git_excluded = False
    if os.path.exists(exclude_path):
        with open(exclude_path, "r", encoding="utf-8") as f:
            git_excluded = ".beads/" in f.read()
    return store_exists, git_excluded


def secrets_status(root):
    sops_configured = os.path.exists(os.path.join(root, ".sops.yaml"))
    secrets_exists = os.path.exists(os.path.join(root, ".pkb", "secrets.enc.env"))
    return sops_configured, secrets_exists


def sops_key_env():
    """Env dict for invoking sops (decrypt operations specifically -- this is about
    the *private* key, unrelated to .sops.yaml's public recipients used for
    encryption). sops's own built-in default age key location on macOS is under
    ~/Library/Application Support, not the more common ~/.config/sops/age/keys.txt
    -- if that's where the key actually lives and SOPS_AGE_KEY_FILE isn't already
    set, point sops at it explicitly rather than relying on its own discovery."""
    env = dict(os.environ)
    if "SOPS_AGE_KEY_FILE" not in env:
        candidate = os.path.expanduser("~/.config/sops/age/keys.txt")
        if os.path.isfile(candidate):
            env["SOPS_AGE_KEY_FILE"] = candidate
    return env


def _git(*args, cwd=TOOL_ROOT):
    return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)


def update_status(fetch=False):
    """Compare this pkb-cli checkout's HEAD against its upstream.

    fetch=False (used by `kb doctor`) never touches the network -- it only compares
    against whatever origin/<branch> was last fetched, so it can go stale, but stays
    within doctor's "never writes, never hits the network" contract. fetch=True (used
    by `kb update`) refreshes that ref first, so its answer is authoritative.

    Returns a dict: is_git, upstream, local, remote, behind, dirty. Fields are None
    when they don't apply (e.g. not a git checkout, or no upstream configured).
    """
    result = {"is_git": os.path.isdir(os.path.join(TOOL_ROOT, ".git")),
              "upstream": None, "local": None, "remote": None, "behind": None, "dirty": None}
    if not result["is_git"]:
        return result

    if fetch:
        _git("fetch", "--quiet", "origin")

    upstream = _git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream.returncode != 0:
        return result
    result["upstream"] = upstream.stdout.strip()

    result["local"] = _git("rev-parse", "HEAD").stdout.strip()
    result["remote"] = _git("rev-parse", result["upstream"]).stdout.strip()
    if result["local"] and result["remote"]:
        behind = _git("rev-list", "--count", f"{result['local']}..{result['remote']}")
        result["behind"] = int(behind.stdout.strip()) if behind.returncode == 0 else None
    result["dirty"] = bool(_git("status", "--porcelain").stdout.strip())
    return result


def cmd_setup(args):
    # root is optional: --install (and the tool/sync checks below) don't need a data
    # repo at all -- only the hook/index/bd/secrets steps do.
    try:
        root = pc.get_repo_root()
    except SystemExit:
        root = None
    ok, todo = [], []

    # 0. install kb itself onto PATH (opt-in via --install [DIR])
    if args.install is not None:
        script_path = os.path.abspath(os.path.join(SCRIPT_DIR, "kb"))
        if args.install:
            install_dir, on_path = os.path.expanduser(args.install), args.install in os.environ.get("PATH", "").split(os.pathsep)
        else:
            install_dir, on_path = find_install_dir()
        target = os.path.join(install_dir, "kb")
        if os.path.islink(target) and os.readlink(target) == script_path:
            ok.append(f"kb already installed at {target}")
        elif os.path.exists(target):
            todo.append(f"--install: {target} already exists and isn't this repo's kb -- remove it "
                        f"or pass a different --install <dir>")
        else:
            os.makedirs(install_dir, exist_ok=True)
            os.symlink(script_path, target)
            if on_path:
                ok.append(f"installed kb -> {target}")
            else:
                ok.append(f"installed kb -> {target} (not yet on PATH)")
                todo.append(f'add this to your shell profile: export PATH="{install_dir}:$PATH"')

    # 0b. install the bundled Claude Code skill (opt-in via --install-skill [DIR]).
    # A symlink, not a copy -- Claude Code follows a skill-directory symlink and
    # reads SKILL.md from the target, so this repo stays the single source of
    # truth and a `kb update` picks up any skill changes automatically, the same
    # reasoning as symlinking the kb binary itself above.
    if args.install_skill is not None:
        skill_src = os.path.abspath(os.path.join(TOOL_ROOT, "skills", "kb"))
        skill_dir = os.path.expanduser(args.install_skill) if args.install_skill else os.path.expanduser("~/.claude/skills")
        target = os.path.join(skill_dir, "kb")
        if os.path.islink(target) and os.readlink(target) == skill_src:
            ok.append(f"kb skill already installed at {target}")
        elif os.path.lexists(target):
            todo.append(f"--install-skill: {target} already exists and isn't this repo's skill -- remove it "
                        f"or pass a different --install-skill <dir>")
        else:
            os.makedirs(skill_dir, exist_ok=True)
            os.symlink(skill_src, target)
            ok.append(f"installed kb skill -> {target}")

    tools = tool_status()

    if root is None:
        todo.append("not inside a pkb data repo (no .pkb/ found) -- cd into one to also set up the "
                     "pre-commit hook, search index, and local bd store")
    else:
        # 1. pre-commit hook -- generated directly (not a symlinked template) since it
        # must hardcode this machine's path to the tool install, which lives in a
        # separate repo from the data repo the hook runs in.
        git_dir = os.path.join(root, ".git")
        if not os.path.isdir(git_dir):
            todo.append("not a git repo (or .git not found here) -- pre-commit hook skipped")
        else:
            hook_content, _validate_path = hook_expected_content()
            hook_path, existing = read_hook(root)
            if existing == hook_content:
                ok.append("pre-commit hook already installed")
            elif existing is not None and HOOK_MARKER not in existing:
                todo.append(f"{os.path.relpath(hook_path, root)} exists and isn't our hook -- leaving it alone")
            else:
                os.makedirs(os.path.dirname(hook_path), exist_ok=True)
                if os.path.lexists(hook_path):  # e.g. a stale/broken symlink from an older kb setup
                    os.remove(hook_path)
                with open(hook_path, "w", encoding="utf-8") as f:
                    f.write(hook_content)
                os.chmod(hook_path, 0o755)
                ok.append("installed pre-commit hook" if existing is None else "refreshed pre-commit hook path")

        # 2. FTS index
        db_path = index_status(root)
        full = not os.path.exists(db_path)
        rc = run_script("index_fts.py", ["--full"] if full else [])
        ok.append(f"{'built' if full else 'refreshed'} the FTS5 search index" if rc == 0 else "index build failed")

        # 3. local bd store
        if tools["bd"]:
            store_exists, _git_excluded = bd_store_status(root)
            if store_exists:
                ok.append("local bd (beads) store already initialized")
            else:
                result = subprocess.run(
                    ["bd", "init", "--stealth", "--non-interactive"],
                    cwd=root, capture_output=True, text=True,
                )
                if result.returncode == 0:
                    ok.append("initialized a local bd store (--stealth: excluded from git)")
                else:
                    todo.append(f"bd init failed: {result.stderr.strip() or result.stdout.strip()}")
        else:
            todo.append("bd CLI not found -- `brew install beads` if you want local TODO tracking via kb sync beads")

        # 4. secrets (sops), informational only -- never touch/create real secrets ourselves
        sops_configured, secrets_exists = secrets_status(root)
        if sops_configured:
            if secrets_exists:
                ok.append(".pkb/secrets.enc.env already set up")
            elif tools["sops"]:
                example_path = os.path.join(SCRIPT_DIR, "..", "templates", "secrets.env.example")
                todo.append("run `kb secrets` to create encrypted memos/gitlab credentials "
                            f"(see {os.path.normpath(example_path)} for the expected keys)")
            else:
                todo.append("sops CLI not found -- install it to use encrypted credentials, or export "
                            "PKB_MEMOS_URL/PKB_MEMOS_TOKEN/PKB_GITLAB_PROJECT directly")

    # 5. glab (required for GitLab sync)
    if tools["glab"]:
        if not tools["glab_auth"]:
            todo.append("glab is installed but not authenticated -- run `glab auth login` for kb sync gitlab")
    else:
        todo.append("glab CLI not found -- `brew install glab` (+ `glab auth login`) if you want kb sync gitlab")

    # 6. rg/fzf (Tier 1 search, optional -- kb search/index work without them)
    missing_search_tools = [t for t in ("rg", "fzf") if not tools[t]]
    if missing_search_tools:
        todo.append(f"{'/'.join(missing_search_tools)} not found -- optional, only needed for zero-setup "
                     f"search (`brew install ripgrep fzf`); kb search/index don't need them")

    # 7. what's actually configured for sync right now (informational)
    configured = []
    if os.environ.get("PKB_MEMOS_URL") and os.environ.get("PKB_MEMOS_TOKEN"):
        configured.append("memos")
    if os.environ.get("PKB_GITLAB_PROJECT") and tools["glab_auth"]:
        configured.append("gitlab")
    if tools["bd"]:
        configured.append("beads")
    if configured:
        ok.append(f"sync sources ready in this shell: {', '.join(configured)}")
    else:
        todo.append("no sync source has credentials in this shell yet (memos/gitlab need env vars, "
                     "see README 'Ingestion credentials')")

    print("kb setup\n")
    for line in ok:
        print(f"  [ok]   {line}")
    for line in todo:
        print(f"  [todo] {line}")
    return 1 if any("failed" in t for t in todo) else 0


def cmd_web(args):
    root = pc.get_repo_root()
    import kb_web
    return kb_web.serve(root, args.port)


def cmd_doctor(args):
    """Read-only health check -- reuses the same detection helpers as `kb setup`
    but never writes anything, and adds a few deeper checks setup doesn't do."""
    # root is optional: tool-level checks (glab/rg/fzf, pkb-cli's own update status)
    # don't need a data repo -- only frontmatter/hook/index/bd/secrets/cursors do.
    try:
        root = pc.get_repo_root()
    except SystemExit:
        root = None
    ok, todo = [], []

    if root is None:
        todo.append("not inside a pkb data repo (no .pkb/ found) -- cd into one to check "
                     "frontmatter, the pre-commit hook, the search index, and cursors.json")
    else:
        # frontmatter integrity (reuses validate_frontmatter.py itself)
        result = subprocess.run(
            [sys.executable, os.path.join(SCRIPT_DIR, "validate_frontmatter.py")],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            ok.append("frontmatter validates cleanly")
        else:
            todo.append("frontmatter validation is failing -- run `kb validate` for details")

        # pre-commit hook: installed, ours, matches what we'd generate now, and points
        # at a file that still exists (setup doesn't check that last part)
        hook_content, _validate_path = hook_expected_content()
        hook_path, existing = read_hook(root)
        if existing is None:
            todo.append("no pre-commit hook installed -- run `kb setup`")
        elif HOOK_MARKER not in existing:
            todo.append(f"{os.path.relpath(hook_path, root)} exists but isn't kb-managed")
        else:
            hooked_path = hook_managed_validate_path(existing)
            if hooked_path and not os.path.exists(hooked_path):
                todo.append(f"pre-commit hook points at a missing file ({hooked_path}) -- "
                            f"the pkb-cli checkout that wrote it may have moved; run `kb setup`")
            elif existing != hook_content:
                todo.append("pre-commit hook is stale (points at a different pkb-cli install/interpreter "
                            "than this one) -- run `kb setup`")
            else:
                ok.append("pre-commit hook is current")

        # FTS index: present, and its row count matches the number of files on disk
        # (a mismatch means something changed without a reindex)
        db_path = index_status(root)
        if not os.path.exists(db_path):
            todo.append("no search index -- run `kb index --full`")
        else:
            import sqlite3
            file_count = sum(1 for _ in pc.iter_markdown_files(root))
            conn = sqlite3.connect(db_path)
            try:
                indexed_count = conn.execute("SELECT COUNT(*) FROM files").fetchone()[0]
            except sqlite3.OperationalError:
                indexed_count = None
            conn.close()
            if indexed_count is None:
                todo.append(f"{os.path.relpath(db_path, root)} exists but doesn't look like a kb index -- "
                            f"run `kb index --full`")
            elif indexed_count != file_count:
                todo.append(f"search index is stale ({indexed_count} indexed vs {file_count} files on disk) "
                            f"-- run `kb index`")
            else:
                ok.append(f"search index is current ({indexed_count} files)")

    # local bd store: present and actually git-excluded
    tools = tool_status()
    if root is not None:
        if tools["bd"]:
            store_exists, git_excluded = bd_store_status(root)
            if not store_exists:
                todo.append("no local bd store -- run `kb setup`")
            elif not git_excluded:
                todo.append(".beads/ exists but isn't in .git/info/exclude -- it may get committed accidentally")
            else:
                ok.append("local bd store is present and git-excluded")
        else:
            todo.append("bd CLI not found -- `brew install beads` if you want local TODO tracking")

        # secrets
        sops_configured, secrets_exists = secrets_status(root)
        if sops_configured and not secrets_exists:
            todo.append("no .pkb/secrets.enc.env yet -- run `kb secrets` if you sync memos/gitlab")
        elif sops_configured:
            ok.append(".pkb/secrets.enc.env is present")

    # glab / rg / fzf -- not data-repo-specific, always checked
    if tools["glab"] and not tools["glab_auth"]:
        todo.append("glab is installed but not authenticated -- run `glab auth login`")
    elif not tools["glab"]:
        todo.append("glab CLI not found -- needed for kb sync gitlab")
    missing_search_tools = [t for t in ("rg", "fzf") if not tools[t]]
    if missing_search_tools:
        todo.append(f"{'/'.join(missing_search_tools)} not found (optional, Tier 1 search)")

    # cursors.json sanity
    if root is not None:
        cursors = pc.load_cursors(root)
        now = datetime.now().astimezone()
        for source, fields in cursors.items():
            for key, value in (fields or {}).items():
                if value is None:
                    continue
                dt = pc.parse_iso(value)
                if dt is None:
                    todo.append(f"cursors.json: {source}.{key} = {value!r} doesn't parse as a timestamp")
                elif dt > now:
                    todo.append(f"cursors.json: {source}.{key} = {value} is in the future")
        if not any("cursors.json" in t for t in todo):
            ok.append("cursors.json looks sane")

    # pkb-cli version, checked against whatever was last fetched -- no network call
    # here (that's `kb update`'s job), so this can go stale but never blocks/slows
    # down a doctor run or touches the network on its own.
    update = update_status(fetch=False)
    if update["is_git"] and update["upstream"]:
        if update["behind"]:
            todo.append(f"pkb-cli is {update['behind']} commit(s) behind {update['upstream']} as of the last "
                        f"fetch -- run `kb update` to check for real and pull")
        else:
            ok.append(f"pkb-cli is up to date with {update['upstream']} as of the last fetch")

    print("kb doctor\n")
    for line in ok:
        print(f"  [ok]   {line}")
    for line in todo:
        print(f"  [todo] {line}")
    if not todo:
        print("\nall clear")
    return 1 if todo else 0


def cmd_update(args):
    """Fetch + check this pkb-cli checkout against its upstream; pull if behind
    and clean. The only kb command besides `kb sync` that touches the network."""
    if not os.path.isdir(os.path.join(TOOL_ROOT, ".git")):
        print(f"error: {TOOL_ROOT} isn't a git checkout -- can't check for updates", file=sys.stderr)
        return 1

    fetch = _git("fetch", "--quiet", "origin")
    if fetch.returncode != 0:
        print(f"error: git fetch failed: {fetch.stderr.strip()}", file=sys.stderr)
        return 1

    status = update_status(fetch=False)  # already fetched above, no need to do it twice
    if not status["upstream"]:
        print(f"error: no upstream branch configured for {TOOL_ROOT}", file=sys.stderr)
        return 1

    if not status["behind"]:
        print(f"kb is up to date with {status['upstream']} ({status['local'][:8]})")
        return 0

    print(f"kb is {status['behind']} commit(s) behind {status['upstream']} "
          f"({status['local'][:8]} -> {status['remote'][:8]})")

    if args.check:
        print("run `kb update` (without --check) to pull")
        return 1

    if status["dirty"]:
        print(f"error: {TOOL_ROOT} has local changes -- commit or stash them before updating", file=sys.stderr)
        return 1

    pull = _git("pull", "--ff-only")
    if pull.returncode != 0:
        print(f"error: git pull failed: {pull.stderr.strip()}", file=sys.stderr)
        return 1
    print(pull.stdout.strip())
    print("updated -- run `kb setup` again if this changed onboarding behavior (e.g. hook logic).")
    return 0


EPILOG = """\
examples:
  kb new how-to "Tailscale sidecar config for Synology"
  kb search tailscale --type how-to
  kb sync all && kb triage
  kb setup --install
  kb update

kb operates on a data repo found by walking up from the current directory to a
.pkb/ directory. Run 'kb <command> -h' for details on a specific command.
"""


def main():
    commands = ["search", "new", "journal", "inbox", "triage", "sync", "index", "validate",
                "links", "show", "tag", "link", "todo", "bd", "secrets", "config", "setup",
                "web", "doctor", "update", "help"]
    parser = KBArgumentParser(
        prog="kb",
        description="A CLI for a Diataxis-based personal knowledge base: search, "
                     "create, triage, and sync your notes.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        subcommands=commands,
    )
    sub = parser.add_subparsers(dest="command", required=True, title="commands", metavar="<command>")

    p = sub.add_parser(
        "search", help="search indexed content",
        description="Search indexed content by keyword (FTS5 match syntax).",
        epilog=(
            "if fzf is installed and you're in a real terminal, this opens an "
            "interactive picker by default: select a result (with a live file "
            "preview), then an action (view/edit/links). --plain always skips it."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("query", help="search terms (bare words match as prefixes; FTS5 match syntax also works)")
    p.add_argument("--type", choices=pc.CORE_TYPES, help="restrict to one Diataxis type")
    p.add_argument("--tag", help="restrict to entries with this tag")
    p.add_argument("--all", action="store_true", help="include journal/inbox/sources (default: core content only)")
    p.add_argument("--plain", action="store_true",
                    help="force the plain list even if fzf + a terminal make interactive mode available")
    p.add_argument("--json", action="store_true", help="machine-readable output; implies --plain")
    p.set_defaults(func=cmd_search)

    p = sub.add_parser(
        "new", help="scaffold a new core entry",
        description="Scaffold a new core entry with valid frontmatter.",
        epilog=(
            "  kb new how-to \"Tailscale sidecar config\" --tags networking,tailscale "
            "--links 2026-08-20-0900 --body \"first draft notes...\""
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("type", choices=pc.CORE_TYPES, help="Diataxis type")
    p.add_argument("title", help="entry title")
    p.add_argument("--tags", metavar="TAG,TAG", help="comma-separated initial tags")
    p.add_argument("--links", metavar="ID,ID", help="comma-separated ids of related entries (must already exist)")
    p.add_argument("--body", metavar="TEXT", help="initial body text, after the title heading")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser(
        "journal", help="open or create a journal entry",
        description="Open or create a journal entry.",
        epilog=(
            "with no DATE (the default), and if fzf is installed and you're in a "
            "real terminal, this opens an interactive picker over past entries "
            "(today included, created on selection if it doesn't exist yet), with "
            "on-this-day entries (1 week/month/year+ ago) pinned to the top. "
            "--plain always skips it and opens/creates today's entry directly, "
            "printing on-this-day and nearby entries for context.\n\n"
            "-m/--add TEXT appends a timestamped line instead of opening the entry "
            "-- no frontmatter to deal with, works whether it exists yet or not:\n"
            "  kb journal -m \"fixed the flaky test\"\n"
            "  kb journal 2026-08-30 -m \"forgot to log this\"\n\n"
            "-m/--add with no TEXT opens a blank scratch buffer in $EDITOR instead "
            "-- for multiline input -- and appends whatever you save as one "
            "timestamped block, again without touching the entry's frontmatter:\n"
            "  kb journal -m\n\n"
            "--tag TAG lists past entries carrying TAG, newest first, for "
            "browsing one theme across time:\n"
            "  kb journal --tag homelab\n\n"
            "`rollup` generates/refreshes a browsable month-at-a-glance page at "
            "reference/journal-summaries/YYYY-MM.md (every day's entry concatenated, "
            "plus a tag-frequency line) -- defaults to last month if MONTH is omitted:\n"
            "  kb journal rollup\n"
            "  kb journal rollup 2026-07"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("date", nargs="?", default=None, metavar="DATE",
                    help="YYYY-MM-DD, 'today' (default), or 'rollup' to generate a monthly summary")
    p.add_argument("month", nargs="?", default=None, metavar="MONTH",
                    help="YYYY-MM, only used with `rollup` (default: last month)")
    p.add_argument("-m", "--add", nargs="?", const="", default=None, metavar="TEXT",
                    help="append TEXT as a timestamped line; with no TEXT, open a scratch "
                         "buffer in $EDITOR for multiline input instead")
    p.add_argument("--tag", metavar="TAG", help="list past entries tagged TAG instead of opening one")
    p.add_argument("--plain", action="store_true",
                    help="force opening/creating today's entry directly, skipping the interactive picker")
    p.set_defaults(func=cmd_journal)

    p = sub.add_parser(
        "inbox", help="list inbox contents with age",
        description="List inbox contents with age.",
        epilog=(
            "with no arguments, and if fzf is installed and you're in a real terminal, "
            "this opens an interactive picker by default: select an item (with a live "
            "preview), then promote (to a Diataxis type), redirect (into that day's "
            "journal entry), or discard -- resolving it, not just reporting on it. "
            "--plain always skips it, falling back to a plain list.\n\n"
            "for scripted/non-interactive use (no picker available), resolve one item "
            "directly by id instead:\n"
            "  kb inbox <id> promote how-to     move into core content as that type\n"
            "  kb inbox <id> redirect           append into that day's journal entry\n"
            "  kb inbox <id> discard            delete it outright"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("id", nargs="?", default=None, help="inbox item id -- with an action, resolve it non-interactively")
    p.add_argument("action", nargs="?", choices=["promote", "redirect", "discard"], default=None)
    p.add_argument("type", nargs="?", choices=pc.CORE_TYPES, default=None,
                    help="Diataxis type, required for `promote`")
    p.add_argument("--plain", action="store_true",
                    help="force the plain list even if fzf + a terminal make interactive mode available")
    p.set_defaults(func=cmd_inbox)

    p = sub.add_parser("triage", help="flag inbox items overdue for triage")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(func=cmd_triage)

    p = sub.add_parser("sync", help="pull in usememos / GitLab / beads")
    p.add_argument("source", nargs="?", choices=["memos", "gitlab", "beads", "all"], default="all",
                    help="which source to sync (default: all)")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("index", help="rebuild or refresh the FTS5 search index")
    p.add_argument("--full", action="store_true", help="rebuild from scratch instead of incrementally")
    p.set_defaults(func=cmd_index)

    p = sub.add_parser("validate", help="check frontmatter, id, and link integrity")
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("links", help="show forward links and backlinks for an entry")
    p.add_argument("id", help="entry id, e.g. 2026-08-31-1423")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(func=cmd_links)

    p = sub.add_parser("show", help="print an entry's full content by id")
    p.add_argument("id", help="entry id, e.g. 2026-08-31-1423")
    p.add_argument("--json", action="store_true",
                    help="machine-readable output ({id, path, frontmatter, body})")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser(
        "tag", help="view, add, or remove tags on an entry",
        description="View, add, or remove tags on an entry -- the sanctioned way to "
                    "change `tags` (never hand-edit frontmatter). Anything left out "
                    "(the id, or which tags to add/remove) opens an fzf picker instead, "
                    "when fzf is installed and you're in a real terminal.",
        epilog=(
            "  kb tag 2026-08-31-1423                  list current tags\n"
            "  kb tag 2026-08-31-1423 add networking homelab\n"
            "  kb tag 2026-08-31-1423 rm homelab\n"
            "  kb tag                                  pick an entry, then list its tags\n"
            "  kb tag 2026-08-31-1423 add              pick tags: multi-select existing ones,\n"
            "                                           or type new ones (comma-separated)\n"
            "  kb tag 2026-08-31-1423 rm                pick which current tags to remove"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("id", nargs="?", default=None,
                    help="entry id, e.g. 2026-08-31-1423 (omit for an fzf picker)")
    p.add_argument("action", nargs="?", choices=["add", "rm"], default=None)
    p.add_argument("values", nargs="*", metavar="TAG",
                    help="tag(s) to add/remove (omit for an fzf picker)")
    p.set_defaults(func=cmd_tag)

    p = sub.add_parser(
        "link", help="view, add, or remove links (forward references) on an entry",
        description="View, add, or remove links on an entry -- the sanctioned way to "
                    "change `links` (never hand-edit frontmatter). With no action, same "
                    "as `kb links` (forward links + backlinks). Anything left out (the id, "
                    "or which entries to link/unlink) opens an fzf picker instead, when "
                    "fzf is installed and you're in a real terminal.",
        epilog=(
            "  kb link 2026-08-31-1423                        forward links + backlinks\n"
            "  kb link 2026-08-31-1423 add 2026-08-20-0900\n"
            "  kb link 2026-08-31-1423 rm 2026-08-20-0900\n"
            "  kb link                                        pick an entry, show its links\n"
            "  kb link 2026-08-31-1423 add                    multi-select entries to link to\n"
            "  kb link 2026-08-31-1423 rm                     multi-select links to remove"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("id", nargs="?", default=None,
                    help="entry id, e.g. 2026-08-31-1423 (omit for an fzf picker)")
    p.add_argument("action", nargs="?", choices=["add", "rm"], default=None)
    p.add_argument("values", nargs="*", metavar="TARGET_ID",
                    help="id(s) to link/unlink (omit for an fzf picker)")
    p.add_argument("--json", action="store_true", help="machine-readable output (no-action form only)")
    p.set_defaults(func=cmd_link)

    p = sub.add_parser(
        "todo", help="list open bd (beads) TODOs, sorted by priority",
        description="List open bd (beads) TODOs, sorted by priority.",
        epilog=(
            "if fzf is installed and you're in a real terminal, this opens an "
            "interactive picker by default: select an item (with a live preview), "
            "then an action (show/close/comment). --plain always skips it; --json "
            "prints bd's own issue JSON instead (implies --plain).\n\n"
            "otherwise (or with --plain/--json), act on one with `kb bd`, which points any "
            "bd command at the resolved data repo the same way this command does:\n"
            "  kb bd show <id>              full details\n"
            "  kb bd comment <id> \"...\"      log progress\n"
            "  kb bd close <id>              mark done\n"
            "  kb bd update <id> --priority <0-4>\n"
            "see `bd --help` (or `kb bd <command> --help`) for the full bd surface.\n\n"
            "-a/--add TITLE creates a new one -- fast, but still ticket-shaped:\n"
            "  kb todo -a \"fix the flaky test\" -p 1 -t bug -d \"fails ~1/10 runs in CI\"\n"
            "-a/--add with no TITLE opens bd's interactive form instead, for filling "
            "in every field (title, description, type, priority, labels, ...) by hand:\n"
            "  kb todo -a"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--all", action="store_true", help="include closed issues")
    p.add_argument("--plain", action="store_true",
                    help="force the plain list even if fzf + a terminal make interactive mode available")
    p.add_argument("--json", action="store_true", help="machine-readable output (bd's own issue JSON); implies --plain")
    p.add_argument("-a", "--add", nargs="?", const="", default=None, metavar="TITLE",
                    help="create a new TODO with TITLE; with no TITLE, open bd's interactive form")
    p.add_argument("-d", "--description", metavar="TEXT", help="description for -a/--add")
    p.add_argument("-p", "--priority", default="2", metavar="0-4", help="priority for -a/--add (default: 2)")
    p.add_argument("-t", "--type", default="task", metavar="TYPE",
                    help="issue type for -a/--add (bug|feature|task|epic|chore|decision; default: task)")
    p.add_argument("-l", "--labels", metavar="LABELS", help="comma-separated labels for -a/--add")
    p.set_defaults(func=cmd_todo)

    p = sub.add_parser("bd", help="run any bd command against the resolved data repo "
                                   "(e.g. kb bd show kb-nux, kb bd close kb-nux)")
    p.add_argument("bd_args", nargs=argparse.REMAINDER, help="arguments passed straight to bd")
    p.set_defaults(func=cmd_bd)

    p = sub.add_parser("secrets", help="edit encrypted memos/gitlab credentials via sops")
    p.set_defaults(func=cmd_secrets)

    p = sub.add_parser(
        "config", help="view or set kb's own machine-local preferences (currently: editor)",
        description="View or set kb's own machine-local preferences (currently just: editor). "
                     "Separate from a data repo's .pkb/config.yml, which is committed and shared.",
    )
    p.add_argument("key", choices=["editor"], help="which preference")
    p.add_argument("value", nargs="?", default=None, metavar="VALUE",
                    help="new value to save (omit to show the current one and its source)")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("setup", help="onboarding: pre-commit hook, index, bd store, PATH install")
    p.add_argument("--install", nargs="?", const="", default=None, metavar="DIR",
                    help="also symlink kb onto PATH (auto-detects ~/.local/bin, /opt/homebrew/bin, "
                         "/usr/local/bin, or pass a specific DIR)")
    p.add_argument("--install-skill", nargs="?", const="", default=None, metavar="DIR",
                    help="also symlink the bundled Claude Code skill into ~/.claude/skills "
                         "(or a specific DIR)")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser(
        "web", help="run the local web UI (feed + quick capture)",
        description="Run the local web UI: a browser-based feed + quick-capture "
                     "view over the same data repo the CLI operates on. Binds "
                     "127.0.0.1 only. Runs in the foreground until Ctrl-C.",
    )
    p.add_argument("--port", type=int, default=4173, metavar="PORT",
                    help="port to bind (default: 4173)")
    p.set_defaults(func=cmd_web)

    p = sub.add_parser("doctor", help="diagnose issues (read-only, never writes anything)")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("update", help="check for and pull kb tool updates")
    p.add_argument("--check", action="store_true", help="only check, don't pull even if behind")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("help", help="show this help message")
    p.set_defaults(func=lambda args: parser.print_help() or 0)

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
