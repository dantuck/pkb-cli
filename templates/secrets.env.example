# Template for .pkb/secrets.enc.env (sops-encrypted, safe to commit) or
# .pkb/secrets.env (plaintext, gitignored, local-only). See README "Ingestion
# credentials" for how to create either. This example file has no real values
# and is committed as documentation only.

PKB_MEMOS_URL=https://your-memos-host:5230
PKB_MEMOS_TOKEN=your-api-token

PKB_GITLAB_PROJECT=namespace/project

# beads has no secret — it authenticates via the local bd CLI/store, not a token.
# See PKB_BEADS_DIR / PKB_BEADS_GLOBAL in .pkb/config.yml instead.
